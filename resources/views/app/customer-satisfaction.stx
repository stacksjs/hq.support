<script server>
const pageTitle = 'Customer satisfaction'
const pageDescription = 'Configure opt-in Messenger feedback and view project satisfaction totals.'
</script>
<script client>
import { createCustomerSatisfaction } from '../../functions/support/customer-satisfaction'
const satisfaction = createCustomerSatisfaction()
const workspace = satisfaction.workspace
const project = workspace.project
const enabled = satisfaction.enabled
const question = satisfaction.question
const period = satisfaction.period
onMount(() => satisfaction.boot())
onDestroy(() => satisfaction.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><a href="/app/reports" class="text-xs console-link">Reports / Satisfaction</a><h1>Customer satisfaction</h1><p>Offer a five-score question in Messenger after a customer's own conversation resolves.</p></div><div class="project-picker"><label for="csat-project">Project</label><select id="csat-project" x-model="project" @change="satisfaction.load()" :disabled="workspace.pending() || workspace.loading()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }} <a :if="!workspace.ready()" href="/login">Sign in</a></p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading" role="status">Loading satisfaction settings and totals...</p>
<div :if="workspace.ready() && workspace.workspace()">
<section :if="workspace.canManage()" class="editor-panel" aria-labelledby="csat-settings-heading"><header class="editor-panel-heading"><h2 id="csat-settings-heading">Messenger question</h2><span>Saved revision {{ satisfaction.settings()?.revision ?? 'not loaded' }}</span></header><div class="editor-form">
<p :if="satisfaction.settingsError()" class="console-error" role="alert">{{ satisfaction.settingsError() }}</p>
<form :if="satisfaction.base()" @submit.prevent="satisfaction.save()"><label class="csat-toggle"><input id="csat-enabled" type="checkbox" x-model="enabled" :disabled="workspace.pending()"> Offer satisfaction feedback for resolved conversations</label><label for="csat-question">Question</label><input id="csat-question" x-model="question" required maxlength="160" :disabled="workspace.pending()"><p class="field-help">{{ question().length }} / 160 · Draft based on revision {{ satisfaction.base()?.revision }}. Customers answer at most once per conversation.</p><p :if="satisfaction.conflict()" class="capability-note" role="status">The saved settings changed. Your draft is preserved. Current question: “{{ satisfaction.settings()?.question }}” · {{ satisfaction.settings()?.enabled ? 'Enabled' : 'Disabled' }} · Revision {{ satisfaction.settings()?.revision }}.</p><div :if="satisfaction.conflict()" class="editor-actions"><button type="button" class="button button-outline" @click="satisfaction.adoptSettings(false)" :disabled="workspace.pending()">Use current saved settings</button><button type="button" class="text-button" @click="satisfaction.adoptSettings(true)" :disabled="workspace.pending()">Keep draft against current revision</button></div><div class="editor-actions"><button type="submit" class="button button-teal" :disabled="workspace.pending() || !satisfaction.dirty() || satisfaction.conflict()">{{ workspace.pending() ? 'Saving...' : 'Save satisfaction settings' }}</button><button type="button" class="text-button" @click="satisfaction.load()" :disabled="workspace.pending() || workspace.loading()">Refresh saved settings</button></div></form><button :if="!satisfaction.base()" type="button" class="button button-outline" @click="satisfaction.load()" :disabled="workspace.loading()">Retry loading settings</button><p class="field-help">The offered question and revision are saved with each answer. Later configuration changes preserve that history.</p>
</div></section>
<p :if="!workspace.canManage()" class="capability-note">Your account can view project totals. Owners and admins configure the Messenger question.</p>
<section class="mt-6" aria-labelledby="csat-report-heading"><header class="console-heading"><div><h2 id="csat-report-heading">Project feedback totals</h2><p>Responses recorded in the selected UTC month. Scores 4 and 5 count as satisfied.</p></div><form class="project-picker" @submit.prevent="satisfaction.load()"><label for="csat-period">Reporting month (UTC)</label><input id="csat-period" type="month" x-model="period" min="1000-01" max="2999-12" required :disabled="workspace.loading() || workspace.pending()"><button type="submit" class="mt-3 button button-outline" :disabled="workspace.loading() || workspace.pending()">Refresh satisfaction totals</button></form></header><p :if="satisfaction.reportError()" class="console-error" role="alert">{{ satisfaction.reportError() }}</p>
<div :if="satisfaction.report()"><p class="mb-4 field-help">UTC response month: {{ satisfaction.report()?.period }}</p><section class="metric-grid" aria-label="Satisfaction totals"><article class="metric-cell"><h2>Responses</h2><strong>{{ satisfaction.report()?.responses }}</strong><p>One response per conversation</p></article><article class="metric-cell"><h2>Average score</h2><strong>{{ satisfaction.average() }}</strong><p>Scale from 1 through 5</p></article><article class="metric-cell"><h2>Satisfied</h2><strong>{{ satisfaction.percent() }}</strong><p>Scores 4 or 5</p></article></section><div class="table-scroll"><table class="console-table"><caption class="p-4 text-left">Score distribution · {{ satisfaction.report()?.period }} UTC</caption><thead><tr><th scope="col">Score</th><th scope="col">Responses</th></tr></thead><tbody><tr :for="row in satisfaction.report()?.distribution"><th scope="row">{{ row.score }} / 5</th><td>{{ row.count }}</td></tr></tbody></table></div><p :if="satisfaction.report()?.responses === 0" class="capability-note">No satisfaction responses were recorded for this project in this UTC month.</p></div></section>
</div><p :if="workspace.ready() && !workspace.workspace()" class="console-empty">Select or create a workspace project in the <a href="/app">inbox</a> first.</p>
@endsection
<style>
.editor-form label.csat-toggle{display:flex;align-items:center;gap:9px}.editor-form .csat-toggle input{width:auto;margin:0;flex:none}.project-picker input[type="month"]{width:100%;padding:10px;border:1px solid #d1dcd2;border-radius:8px;background:#fff;color:#20332f;font:inherit}
</style>
