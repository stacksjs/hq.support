<script server>
const pageTitle = 'Automations'
const pageDescription = 'Build and publish durable HQ.support workflows.'
</script>
<script client>
import { createAutomations } from '../../functions/support/automations'
const automation = createAutomations()
const workspace = automation.workspace
const project = workspace.project
const name = automation.name
const event = automation.event
const start = automation.start
const nodeType = automation.nodeType
const next = automation.next
const text = automation.text
const seconds = automation.seconds
const assignee = automation.assignee
const tag = automation.tag
const nodeTitle = automation.nodeTitle
const status = automation.status
const conditionField = automation.conditionField
const operator = automation.operator
const comparison = automation.comparison
const yes = automation.yes
const no = automation.no
const tool = automation.tool
const attributeKey = automation.attributeKey
const attributeValue = automation.attributeValue
const json = automation.json
onMount(() => automation.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Automations</h1><p>Build a clear sequence, save a draft, then publish an immutable version for new matching events.</p></div><div class="project-picker"><label for="automation-project">Project</label><select id="automation-project" x-model="project" @change="automation.changeProject()" :disabled="automation.dirty() || automation.nodeDirty() || workspace.loading() || workspace.pending()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading" role="status">Loading workflows and recorded runs...</p><div class="console-toolbar"><button :if="workspace.canManage()" type="button" class="button button-teal" @click="automation.select(null)" :disabled="!project() || automation.dirty() || automation.nodeDirty() || workspace.pending()">New workflow</button><button type="button" class="button button-outline" @click="automation.load()" :disabled="automation.dirty() || automation.nodeDirty() || workspace.loading() || workspace.pending()">Refresh workflows</button><span :if="automation.dirty()" class="field-help unsaved-label">Unsaved workflow changes</span></div><p :if="workspace.ready() && !automation.executionAvailable() && !workspace.loading()" class="capability-note">The server has not enabled workflow execution. Drafts and published execution capabilities follow the API response.</p>
<div class="editor-grid"><section class="resource-list" aria-label="Workflows"><button :for="item in automation.workflows()" type="button" :class="String(automation.selected()?.id) === String(item.id) ? 'chosen' : ''" @click="automation.select(item)" :disabled="automation.dirty() || automation.nodeDirty() || workspace.pending()"><strong>{{ item.name }}</strong><span>{{ item.event }}<br>{{ item.enabled ? 'Published' : 'Paused or draft' }} / version {{ item.published_version }}</span></button><p :if="!workspace.loading() && automation.workflows().length === 0" class="empty-list">No workflows yet. Create a draft to start.</p></section><section class="editor-panel"><header class="editor-panel-heading"><h2>{{ automation.editorOpen() ? automation.selected()?.name || 'New workflow' : 'Design the next step' }}</h2><span :if="automation.selected()">Version {{ automation.selected()?.published_version }}</span></header><div :if="!automation.editorOpen()" class="editor-form"><p class="field-help">Select a workflow to inspect its saved definition. Owners and admins can edit, publish, and pause workflows.</p></div><div :if="automation.editorOpen()"><form class="editor-form" @submit.prevent="automation.save()"><div class="field-grid"><div><label for="workflow-name">Workflow name</label><input id="workflow-name" x-model.trim="name" required maxlength="200" :disabled="!workspace.canManage() || workspace.pending()"></div><div><label for="workflow-event">Trigger event</label><input id="workflow-event" x-model.trim="event" required maxlength="200" placeholder="conversation.created" :disabled="!workspace.canManage() || workspace.pending()"></div></div><p class="field-help">Use conversation.created, ticket.created, or the exact name of a custom event sent by your server.</p><label for="workflow-start">Start step</label><select id="workflow-start" x-model="start" :disabled="!workspace.canManage() || workspace.pending()"><option :for="step in automation.nodes()" :value="step.id">{{ step.id }} / {{ step.type }}</option></select><div class="editor-actions"><button :if="workspace.canManage()" class="button button-teal" type="submit" :disabled="workspace.pending() || !automation.dirty() || automation.nodeDirty()">Save workflow draft</button><button :if="automation.selected() && workspace.canManage()" class="button button-outline" type="button" @click="automation.publish()" :disabled="automation.dirty() || automation.nodeDirty() || workspace.pending() || !automation.executionAvailable()">Publish saved version</button><button :if="automation.selected()?.enabled && workspace.canManage()" class="text-button" type="button" @click="automation.pause()" :disabled="workspace.pending()">Pause workflow</button><button :if="automation.dirty()" class="text-button" type="button" @click="automation.discard()">Discard draft changes</button></div></form><div class="workflow-preview" aria-label="Workflow steps"><button :for="step in automation.nodes()" type="button" class="workflow-step" @click="automation.selectNode(step)" :disabled="automation.nodeDirty()">{{ step.id }}<small>{{ step.type }}{{ step.next ? ' → ' + step.next : step.type === 'condition' ? ' / branches' : '' }}</small></button><button :if="workspace.canManage()" type="button" class="text-button" @click="automation.addNode()" :disabled="workspace.pending()">Add step</button></div>
<p :if="automation.nodeDirty()" class="console-notice">This step has changes. Apply or discard them before saving or switching steps.</p><form :if="automation.nodeId()" class="editor-form" @submit.prevent="automation.applyNode()"><fieldset :disabled="workspace.pending() || !workspace.canManage()"><h3 class="text-lg">Step: {{ automation.nodeId() }}</h3><label for="step-type">Action</label><select id="step-type" x-model="nodeType" :disabled="!workspace.canManage()"><option :for="kind in automation.nodeTypes" :value="kind">{{ kind }}</option></select><div :if="nodeType() === 'wait'"><label for="step-seconds">Wait in seconds</label><input id="step-seconds" x-model="seconds" type="number" min="1" max="2592000" required><p class="field-help">Waits persist on the server, for up to 30 days.</p></div><div :if="nodeType() === 'assign'"><label for="step-assignee">Assign to agent</label><select id="step-assignee" x-model="assignee" required><option value="">Choose a workspace agent</option><option :for="agent in automation.agents()" :value="agent.id">{{ agent.name }} / {{ agent.role }}</option></select><p class="field-help">Only agents in this workspace can be assigned.</p></div><div :if="nodeType() === 'tag'"><label for="step-tag">Contact tag</label><input id="step-tag" x-model.trim="tag" maxlength="60" required></div><div :if="nodeType() === 'ticket' || nodeType() === 'start_conversation'"><label for="step-title">{{ nodeType() === 'ticket' ? 'Ticket title' : 'Conversation subject' }}</label><input id="step-title" x-model="nodeTitle" maxlength="200" required></div><div :if="['reply','note','ticket','start_conversation'].includes(nodeType())"><label for="step-body">{{ nodeType() === 'note' ? 'Internal note' : nodeType() === 'ticket' ? 'Ticket description' : 'Customer message' }}</label><textarea id="step-body" x-model="text" rows="4" maxlength="20000" :required="nodeType() !== 'ticket'"></textarea><p :if="nodeType() === 'reply' || nodeType() === 'start_conversation'" class="field-help">This action writes a public customer message when the native worker reaches this step.</p></div><div :if="nodeType() === 'status'"><label for="step-status">Conversation status</label><select id="step-status" x-model="status"><option value="open">Open</option><option value="closed">Closed</option><option value="snoozed">Snoozed</option></select></div><div :if="nodeType() === 'condition'"><label for="condition-field">Field to inspect</label><input id="condition-field" x-model.trim="conditionField" required placeholder="contact.attributes.plan"><div class="field-grid"><div><label for="condition-operator">Comparison</label><select id="condition-operator" x-model="operator"><option value="eq">Equals</option><option value="neq">Does not equal</option><option value="contains">Contains</option><option value="exists">Exists</option><option value="gt">Greater than</option><option value="lt">Less than</option></select></div><div><label for="condition-value">Comparison value (JSON)</label><input id="condition-value" x-model="comparison" placeholder='"starter"'></div></div><div class="field-grid"><div><label for="condition-yes">If true, go to</label><select id="condition-yes" x-model="yes" required><option value="">Choose a step</option><option :for="step in automation.nodes()" :value="step.id">{{ step.id }}</option></select></div><div><label for="condition-no">If false, go to</label><select id="condition-no" x-model="no" required><option value="">Choose a step</option><option :for="step in automation.nodes()" :value="step.id">{{ step.id }}</option></select></div></div></div><div :if="nodeType() === 'tool'"><label for="step-tool">Contact attribute operation</label><select id="step-tool" x-model="tool"><option value="contact.set_attribute">Set attribute</option><option value="contact.remove_attribute">Remove attribute</option></select><label for="attribute-key">Attribute name</label><input id="attribute-key" x-model.trim="attributeKey" required pattern="[a-zA-Z][a-zA-Z0-9_]{0,63}"><label :if="tool() === 'contact.set_attribute'" for="attribute-value">Attribute value (JSON)</label><input :if="tool() === 'contact.set_attribute'" id="attribute-value" x-model="attributeValue" placeholder='"starter"'></div><div :if="nodeType() !== 'end' && nodeType() !== 'condition'"><label for="step-next">Next step</label><select id="step-next" x-model="next"><option value="">Finish workflow</option><option :for="step in automation.nodes()" :value="step.id">{{ step.id }} / {{ step.type }}</option></select></div><div :if="workspace.canManage()" class="editor-actions"><button type="submit" class="button button-outline">Apply step to draft</button><button :if="automation.nodeDirty()" type="button" class="text-button" @click="automation.discardNode()">Discard step changes</button><button type="button" class="text-button" @click="automation.removeNode()">Remove step</button></div></fieldset></form><details :if="workspace.canManage()" class="workflow-detail"><summary>Advanced definition</summary><label for="workflow-json" class="field-help">Complete native workflow definition</label><textarea id="workflow-json" class="workflow-editor" x-model="json" rows="14" aria-label="Workflow JSON definition"></textarea><button type="button" class="text-button" @click="automation.applyJson()">Apply definition to draft</button></details></div></section></div>
<section :if="workspace.canManage()" class="mt-10"><h2 class="text-xl">Recorded runs</h2><div :if="automation.runs().length" class="table-scroll"><table class="console-table"><thead><tr><th scope="col">Run</th><th scope="col">Workflow</th><th scope="col">Status</th><th scope="col">Steps</th><th scope="col">Recorded</th><th scope="col">Details</th></tr></thead><tbody><tr :for="run in automation.runs()"><td>#{{ run.id }}</td><td>#{{ run.workflow_id }}</td><td>{{ run.status }}</td><td>{{ run.step_count }}</td><td>{{ run.created_at }}</td><td><button type="button" class="text-button" @click="automation.viewRun(run)">Inspect run</button></td></tr></tbody></table></div><p :if="automation.runs().length === 0" class="console-empty">No runs have been recorded for this project.</p><article :if="automation.runDetail()" class="mt-6 editor-panel"><header class="editor-panel-heading"><h3>Run #{{ automation.runDetail()?.run.id }}</h3><span>{{ automation.runDetail()?.run.status }}</span></header><div class="workflow-detail"><p :if="automation.runDetail()?.run.last_error" class="console-error">{{ automation.runDetail()?.run.last_error }}</p><article :for="step in automation.runDetail()?.steps"><strong>{{ step.step_id }} / {{ step.type }}</strong><pre>{{ step.result }}</pre></article><p :if="automation.runDetail()?.steps.length === 0" class="field-help">No completed steps have been recorded.</p></div></article></section><p class="console-help-footer">Execution happens in the native support workflow worker. Publishing does not run a workflow in your browser or configure an external delivery channel.</p>
@endsection
