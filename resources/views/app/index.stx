<script server>
const pageTitle = 'Inbox'
const pageDescription = 'Your HQ.support team inbox.'
</script>
<script client>
import { createInbox } from '../../functions/support/inbox'
const inbox = createInbox()
const project = inbox.project
const search = inbox.search
const inboxFilter = inbox.inboxFilter
const routingInbox = inbox.routingInbox
const routingAssignee = inbox.routingAssignee
const draft = inbox.draft
const visibility = inbox.visibility
const workspaceName = inbox.workspaceName
const projectName = inbox.projectName
onMount(() => inbox.load())
onDestroy(() => inbox.destroy())
async function selectConversation(item: Parameters<typeof inbox.select>[0]) {
  await inbox.select(item)
  await nextTick()
  await inbox.markRead()
}
</script>
<!DOCTYPE html>
<html lang="en"><head>@include('head')<link rel="stylesheet" href="/support.css"><link rel="stylesheet" href="/inbox.css"><link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet"></head>
<body class="min-h-[100dvh] antialiased text-[#20332f] bg-[#fafbf9]"><a class="skip-link" href="#conversation">Skip to conversation</a>
<main id="main" class="grid inbox-shell">
  <aside class="flex flex-col workspace-rail" aria-label="Workspace navigation"><a class="rail-logo" href="/" aria-label="HQ.support home">h</a><a class="active rail-link" href="/app" aria-label="Inbox" title="Inbox"><i class="i-hugeicons-inbox" aria-hidden="true"></i></a><a class="rail-link" href="/app/tickets" aria-label="Tickets" title="Tickets"><i class="i-hugeicons-ticket-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/knowledge" aria-label="Knowledge" title="Knowledge"><i class="i-hugeicons-book-open-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/automations" aria-label="Automations" title="Automations"><i class="i-hugeicons-workflow-circle-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/phone" aria-label="Phone" title="Phone"><i class="i-hugeicons-call" aria-hidden="true"></i></a><a class="rail-link" href="/app/reports" aria-label="Reports" title="Reports"><i class="i-hugeicons-chart-histogram" aria-hidden="true"></i></a><a class="rail-link" href="/app/usage" aria-label="Usage and credit" title="Usage and credit"><i class="i-hugeicons-wallet-01" aria-hidden="true"></i></a><a class="rail-link" href="/help" aria-label="Help center" title="Help center"><i class="i-hugeicons-book-open-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/team-settings" aria-label="Teams and routing" title="Teams and routing"><i class="i-hugeicons-user-group" aria-hidden="true"></i></a><a class="rail-link" href="/app/settings" aria-label="Settings" title="Settings"><i class="i-hugeicons-settings-01" aria-hidden="true"></i></a><div class="rail-bottom"><a class="rail-link" href="/login" aria-label="Account" title="Account"><i class="i-hugeicons-user-circle" aria-hidden="true"></i></a></div></aside>
  <section class="flex flex-col conversation-list" aria-label="Conversation list"><header class="list-heading"><div class="flex items-center justify-between"><h1>Inbox</h1><button class="icon-button" type="button" @click="inbox.refresh()" :disabled="inbox.loading()" aria-label="Refresh inbox" title="Refresh inbox"><i class="i-hugeicons-refresh" aria-hidden="true"></i></button></div><label for="project" class="sr-only">Project</label><select id="project" x-model="project" @change="inbox.changeProject()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><option value="">Select a project</option><option :for="item in inbox.projects()" :value="item.public_id || item.id">{{ item.name }}</option></select><label for="team-inbox" class="sr-only">Team inbox</label><select id="team-inbox" x-model="inboxFilter" @change="inbox.refresh()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy() || inbox.loading()"><option value="">All team inboxes</option><option value="0">Without team inbox</option><option :for="item in inbox.inboxes()" :value="String(item.id)">{{ item.name }}{{ item.active ? '' : ' (inactive)' }}</option></select><div class="search-field"><i class="i-hugeicons-search-01" aria-hidden="true"></i><input type="search" x-model="search" placeholder="Search conversations" aria-label="Search conversations"></div></header><div class="flex gap-1 items-center inbox-filters" role="group" aria-label="Conversation status"><button type="button" :class="inbox.filter() === 'open' ? 'selected' : ''" @click="inbox.changeFilter('open')" :disabled="inbox.loading()">Open</button><button type="button" :class="inbox.filter() === 'snoozed' ? 'selected' : ''" @click="inbox.changeFilter('snoozed')" :disabled="inbox.loading()">Snoozed</button><button type="button" :class="inbox.filter() === 'closed' ? 'selected' : ''" @click="inbox.changeFilter('closed')" :disabled="inbox.loading()">Resolved</button><button type="button" :class="inbox.filter() === 'all' ? 'selected' : ''" @click="inbox.changeFilter('all')" :disabled="inbox.loading()">All</button></div><div class="list-count">{{ inbox.filtered().length }} loaded {{ inbox.filtered().length === 1 ? 'conversation' : 'conversations' }}</div><div class="list-scroll"><p :if="inbox.loading()" class="list-empty" role="status">Loading your inbox...</p><button :for="item in inbox.filtered()" type="button" class="conversation-row" :class="String(inbox.current()?.id) === String(item.id) ? 'is-current' : ''" @click="selectConversation(item)" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><div class="row-avatar">{{ item.subject.charAt(0).toUpperCase() }}</div><div class="row-copy"><div class="row-top"><strong>{{ item.subject }}</strong><time>{{ inbox.formatDate(item.updated_at) }}</time></div><p>{{ item.status === 'closed' ? 'Resolved' : item.status === 'snoozed' ? 'Snoozed' : 'Open' }} · {{ inbox.person(item.assignee_id) }}</p><span :if="item.unread_count > 0" class="unread-count">{{ item.unread_count }} unread</span></div></button><div :if="!inbox.loading() && inbox.filtered().length === 0" class="list-empty"><i class="i-hugeicons-inbox" aria-hidden="true"></i><strong>No conversations here yet</strong><p>Customer messages will appear here when your messenger is connected.</p></div></div><button :if="inbox.nextCursor()" type="button" class="p-4 text-button" @click="inbox.loadMore()" :disabled="inbox.loading()">Load more conversations</button><footer class="list-footer"><span>{{ inbox.user()?.name || 'Your workspace' }}</span><a href="/help/messenger">Setup guide <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a></footer></section>
  <section id="conversation" class="flex flex-col conversation-pane" tabindex="-1"><header class="flex gap-4 items-center justify-between thread-heading"><div class="min-w-0"><span class="thread-breadcrumb">Conversations / {{ inbox.current()?.status || 'Inbox' }}</span><h2>{{ inbox.selectedTitle() }}</h2></div><div class="flex gap-2 items-center"><button :if="inbox.current()" type="button" class="button button-outline resolve-button" @click="inbox.changeStatus()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><i class="i-hugeicons-tick-02" aria-hidden="true"></i>{{ inbox.current()?.status === 'closed' ? 'Reopen' : 'Resolve' }}</button><button type="button" class="icon-button" @click="inbox.detailsOpen.update(value => !value)" aria-label="Toggle customer details"><i class="i-hugeicons-sidebar-right" aria-hidden="true"></i></button></div></header><div :if="inbox.error()" class="inbox-error" role="alert"><p>{{ inbox.error() }}</p><a :if="!inbox.user()" href="/login">Sign in to your account</a></div><p :if="inbox.notice()" class="thread-notice" role="status">{{ inbox.notice() }}</p><section :if="inbox.needsWorkspace()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-building-03" aria-hidden="true"></i></span><h2>A home for your support.</h2><p>Create a workspace to bring your conversations and team together. Your trial lasts 14 days.</p><form @submit.prevent="inbox.createWorkspace()"><label for="workspace-name">Workspace name</label><input id="workspace-name" x-model.trim="workspaceName" required maxlength="120" placeholder="Your team or company"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create workspace' }}</button></form></section><section :if="inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-source-code" aria-hidden="true"></i></span><h2>Meet your first project.</h2><p>A project connects your app to its customer conversations. Give it a name to start.</p><form @submit.prevent="inbox.createProject()"><label for="project-name">Project name</label><input id="project-name" x-model.trim="projectName" required maxlength="120" placeholder="Your app or website"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create project' }}</button></form></section><section :if="!inbox.current() && !inbox.needsWorkspace() && !inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-message-01" aria-hidden="true"></i></span><h2>A good conversation starts here.</h2><p>Select a conversation to see the full story, leave a note, or send a reply.</p><a href="/help/messenger" class="button button-outline">Connect your messenger <i class="i-hugeicons-arrow-right-02" aria-hidden="true"></i></a></section><div :if="inbox.current()" class="thread-scroll" role="log" aria-label="Conversation messages" aria-live="polite"><article :for="message in inbox.messages()" class="thread-message" :class="message.visibility === 'internal' ? 'internal-message' : ''"><header class="message-heading"><span class="message-avatar">{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerInitial() : 'h' }}</span><strong>{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerName() : 'Team' }}</strong><span :if="message.visibility === 'internal'" class="note-label"><i class="i-hugeicons-lock-key" aria-hidden="true"></i> Internal note</span><time>{{ inbox.formatDate(message.created_at) }}</time></header><p>{{ message.body }}</p></article></div><form :if="inbox.current()" class="reply-composer" :class="visibility() === 'internal' ? 'note-composer' : ''" @submit.prevent="inbox.send()"><div class="composer-heading"><label for="reply-mode" class="sr-only">Message visibility</label><select id="reply-mode" x-model="visibility" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><option value="public">Public reply</option><option value="internal">Internal note</option></select><span>{{ visibility() === 'internal' ? 'Only your team can see this' : 'Visible to the customer' }}</span></div><label for="reply" class="sr-only">Write a reply</label><textarea id="reply" x-model="draft" required maxlength="10000" rows="4" :placeholder="visibility() === 'internal' ? 'Leave context for your team...' : 'Write a thoughtful reply...'" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"></textarea><div class="composer-footer"><span>{{ draft().length }} / 10,000</span><button type="submit" class="button button-teal" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending() || !draft().trim()">{{ inbox.sending() ? 'Sending...' : visibility() === 'internal' ? 'Add note' : 'Send reply' }}<i class="i-hugeicons-arrow-up-02" aria-hidden="true"></i></button></div></form></section>
  <aside class="customer-panel" :class="inbox.detailsOpen() ? '' : 'details-hidden'" aria-label="Customer details"><header>Customer details</header><section :if="inbox.contact()"><div class="customer-avatar">{{ inbox.customerInitial() }}</div><h2>{{ inbox.customerName() }}</h2><p class="customer-email">{{ inbox.contact()?.email || 'No email provided' }}</p><dl><div><dt>Customer ID</dt><dd>{{ inbox.contact()?.id || 'Unavailable' }}</dd></div><div><dt>Company</dt><dd>{{ inbox.contact()?.company || 'Not provided' }}</dd></div><div><dt>Conversation</dt><dd>#{{ inbox.current()?.id }}</dd></div><div><dt>Status</dt><dd>{{ inbox.current()?.status }}</dd></div></dl></section><section :if="inbox.current() && inbox.contact()" class="routing-panel" aria-labelledby="assignment-heading"><h3 id="assignment-heading">Assignment</h3><dl><div><dt>Inbox</dt><dd>{{ inbox.inboxName(inbox.current()?.inbox_id) }}</dd></div><div><dt>Assignee</dt><dd>{{ inbox.person(inbox.current()?.assignee_id) }}</dd></div></dl><p class="field-help" role="status">{{ inbox.routingNotice() || inbox.routingReasonLabel(inbox.current()?.routing_reason) }}</p><p :if="inbox.routingError()" class="routing-error" role="alert">{{ inbox.routingError() }}</p>
<form :if="inbox.canManage()" @submit.prevent="inbox.route('manual')"><label for="assignment-inbox">Team inbox</label><select id="assignment-inbox" x-model="routingInbox" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()"><option value="0">Without team inbox</option><option :for="item in inbox.inboxes()" :value="String(item.id)" :disabled="!item.active">{{ item.name }}{{ item.active ? '' : ' (inactive)' }}</option></select><label for="assignment-agent">Assign to</label><select id="assignment-agent" x-model="routingAssignee" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()"><option value="0">Unassigned</option><option :for="item in inbox.candidateAgents()" :value="String(item.id)" :disabled="inbox.candidateDisabled(item.id)">{{ inbox.agentLabel(item.id) }}</option></select><button type="submit" class="button button-outline" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">{{ inbox.routingBusy() ? 'Saving...' : 'Save assignment' }}</button><button type="button" class="text-button" @click="inbox.route('auto')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending() || !inbox.canAutoRoute()">Retry automatic routing</button></form>
<div :if="!inbox.canManage()"><button :if="Number(inbox.current()?.assignee_id) === 0" type="button" class="button button-outline" @click="inbox.route('manual', 'claim')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">Claim for myself</button><button :if="String(inbox.current()?.assignee_id) === String(inbox.user()?.id)" type="button" class="button button-outline" @click="inbox.route('manual', 'release')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">Release my assignment</button><p class="field-help">Owners and admins can move inboxes or assign other members. Claims still require team membership, availability and capacity.</p></div><a href="/app/team-settings" class="text-button">Teams, availability and capacity</a>
<details class="mt-4"><summary class="text-xs cursor-pointer">Assignment history (latest 100)</summary><button type="button" class="text-button" @click="inbox.loadHistory()">Refresh history</button><article :for="item in inbox.assignments()" class="assignment-entry"><strong>{{ inbox.actorLabel(item) }}</strong><p>{{ inbox.person(item.before.assigneeId) }} → {{ inbox.person(item.after.assigneeId) }}</p><p>{{ inbox.inboxName(item.before.inboxId) }} → {{ inbox.inboxName(item.after.inboxId) }}</p><p>{{ inbox.routingReasonLabel(item.reason) }}</p><time>{{ inbox.formatDate(item.created_at) }}</time></article><p :if="!inbox.assignments().length" class="field-help">No assignment decisions recorded yet.</p></details></section><div :if="!inbox.contact()" class="customer-empty"><i class="i-hugeicons-user-circle" aria-hidden="true"></i><p>Customer context appears when you open a conversation.</p></div><div class="privacy-note"><i class="i-hugeicons-lock-key" aria-hidden="true"></i><p>Customer context is scoped to this workspace.</p></div></aside>
</main></body></html>
