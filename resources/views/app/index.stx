<script server>
const pageTitle = 'Inbox'
const pageDescription = 'Your HQ.support team inbox.'
import labels from '../../../locales/en.yml'
import agentInbox from '../../../locales/agent-inbox.yml'
import { createI18n } from '@stacksjs/i18n/client'
const english = createI18n({ locale: 'en', messages: { en: { ...labels.inbox, ...agentInbox.en } } })
const words = () => (key: string, values?: Record<string, string | number>) => english.t(key, values)
</script>
<script client>
import { createInbox } from '../../functions/support/inbox'
import { createInboxLocale } from '../../functions/support/inbox-locale'
import { messengerDirection, messengerLocale } from '../../functions/support/messenger-locale'
const inbox = createInbox()
const translation = createInboxLocale()
const locale = state('en')
const inboxDirection = derived(() => messengerDirection(messengerLocale(locale())))
const words = derived(() => {
  const language = locale()
  return (key: string, values?: Record<string, string | number>) => translation.t(key, values, language)
})
function openDate(value?: string) { return inbox.formatDate(value, locale()) }
function auditDate(value?: string) {
  const date = new Date(value || '')
  return Number.isNaN(date.getTime()) ? '' : new Intl.DateTimeFormat(locale(), { dateStyle: 'short', timeStyle: 'short' }).format(date)
}
const displayNumber = (value: number) => value.toLocaleString(locale())
const project = inbox.project
const search = inbox.search
const inboxFilter = inbox.inboxFilter
const routingInbox = inbox.routingInbox
const routingAssignee = inbox.routingAssignee
const draft = inbox.draft
const visibility = inbox.visibility
const workspaceName = inbox.workspaceName
const projectName = inbox.projectName
onMount(() => { inbox.setupDetails(); inbox.setupPresence(); return inbox.load() })
onDestroy(() => inbox.destroy())
async function selectConversation(item: Parameters<typeof inbox.select>[0]) {
  await inbox.select(item)
  await nextTick()
  await inbox.markRead()
}
</script>
<!DOCTYPE html>
<html lang="en"><head>@include('head')<link rel="stylesheet" href="/support.css"><link rel="stylesheet" href="/inbox.css"><link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet"></head>
<body class="min-h-[100dvh] antialiased text-[#20332f] bg-[#fafbf9]"><a class="skip-link" href="#conversation" :lang="locale()" :dir="inboxDirection()">{{ words()('skip') }}</a>
<main id="main" class="grid inbox-shell" :lang="locale()" :dir="inboxDirection()">
  <aside class="flex flex-col workspace-rail" :inert="inbox.narrowDetails() && inbox.detailsOpen()" :aria-label="words()('workspaceNavigation')"><a class="rail-logo" href="/" :aria-label="words()('home')">h</a><a class="active rail-link" href="/app" :aria-label="words()('inbox')" :title="words()('inbox')"><i class="i-hugeicons-inbox" aria-hidden="true"></i></a><a class="rail-link" href="/app/tickets" :aria-label="words()('tickets')" :title="words()('tickets')"><i class="i-hugeicons-ticket-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/knowledge" :aria-label="words()('knowledge')" :title="words()('knowledge')"><i class="i-hugeicons-book-open-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/automations" :aria-label="words()('automations')" :title="words()('automations')"><i class="i-hugeicons-workflow-circle-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/phone" :aria-label="words()('phone')" :title="words()('phone')"><i class="i-hugeicons-call" aria-hidden="true"></i></a><a class="rail-link" href="/app/reports" :aria-label="words()('reports')" :title="words()('reports')"><i class="i-hugeicons-chart-histogram" aria-hidden="true"></i></a><a class="rail-link" href="/app/usage" :aria-label="words()('usage')" :title="words()('usage')"><i class="i-hugeicons-wallet-01" aria-hidden="true"></i></a><a class="rail-link" href="/help" :aria-label="words()('help')" :title="words()('help')"><i class="i-hugeicons-book-open-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/team-settings" :aria-label="words()('teams')" :title="words()('teams')"><i class="i-hugeicons-user-group" aria-hidden="true"></i></a><a class="rail-link" href="/app/settings" :aria-label="words()('settings')" :title="words()('settings')"><i class="i-hugeicons-settings-01" aria-hidden="true"></i></a><div class="rail-bottom"><a class="rail-link" href="/login" :aria-label="words()('account')" :title="words()('account')"><i class="i-hugeicons-user-circle" aria-hidden="true"></i></a></div></aside>
  <section class="flex flex-col conversation-list" :inert="inbox.narrowDetails() && inbox.detailsOpen()" :aria-label="words()('conversationList')"><header class="list-heading"><div class="flex items-center justify-between"><h1>{{ words()('inbox') }}</h1><button class="icon-button" type="button" @click="inbox.refresh()" :disabled="inbox.loading()" :aria-label="words()('refreshInbox')" :title="words()('refreshInbox')"><i class="i-hugeicons-refresh" aria-hidden="true"></i></button></div><label for="project" class="sr-only">{{ words()('project') }}</label><select id="project" x-model="project" @change="inbox.changeProject()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><option value="">{{ words()('selectProject') }}</option><option :for="item in inbox.projects()" :value="item.public_id || item.id">{{ item.name }}</option></select><label for="team-inbox" class="sr-only">{{ words()('teamInbox') }}</label><select id="team-inbox" x-model="inboxFilter" @change="inbox.refresh()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy() || inbox.loading()"><option value="">{{ words()('allTeamInboxes') }}</option><option value="0">{{ words()('withoutInbox') }}</option><option :for="item in inbox.inboxes()" :value="String(item.id)">{{ item.name }}{{ item.active ? '' : ' (inactive)' }}</option></select><div class="search-field"><i class="i-hugeicons-search-01" aria-hidden="true"></i><input type="search" x-model="search" @input="inbox.searchChanged()" maxlength="200" :placeholder="words()('search')" :aria-label="words()('search')" aria-describedby="inbox-search-help" :aria-invalid="!!inbox.searchError()"></div><p id="inbox-search-help" class="search-help" :role="inbox.searchError() ? 'status' : undefined">{{ inbox.searchError() || (inbox.searchMode() === 'fulltext' ? words()('searchFulltext') : inbox.searchMode() === 'lexical' ? words()('searchLexical') : words()('searchHelp')) }}</p><label for="inbox-language" class="sr-only">{{ words()('language') }}</label><select id="inbox-language" x-model="locale"><option value="en" lang="en">English</option><option value="de" lang="de">Deutsch</option><option value="ar" lang="ar">العربية</option></select></header><div class="flex gap-1 items-center inbox-filters" role="group" :aria-label="words()('status')"><button type="button" :class="inbox.filter() === 'open' ? 'selected' : ''" @click="inbox.changeFilter('open')" :disabled="inbox.loading()">{{ words()('open') }}</button><button type="button" :class="inbox.filter() === 'snoozed' ? 'selected' : ''" @click="inbox.changeFilter('snoozed')" :disabled="inbox.loading()">{{ words()('snoozed') }}</button><button type="button" :class="inbox.filter() === 'closed' ? 'selected' : ''" @click="inbox.changeFilter('closed')" :disabled="inbox.loading()">{{ words()('resolved') }}</button><button type="button" :class="inbox.filter() === 'all' ? 'selected' : ''" @click="inbox.changeFilter('all')" :disabled="inbox.loading()">{{ words()('all') }}</button></div><div class="list-count">{{ words()(inbox.filtered().length === 1 ? 'loadedOne' : 'loadedOther', { count: displayNumber(inbox.filtered().length) }) }}</div><div class="list-scroll"><p :if="inbox.loading()" class="list-empty" role="status">{{ search().trim() ? words()('searching') : words()('loading') }}</p><button :for="item in inbox.filtered()" type="button" class="conversation-row" :class="String(inbox.current()?.id) === String(item.id) ? 'is-current' : ''" @click="selectConversation(item)" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><div class="row-avatar">{{ item.subject.charAt(0).toUpperCase() }}</div><div class="row-copy"><div class="row-top"><strong>{{ item.subject }}</strong><time>{{ openDate(item.updated_at) }}</time></div><p>{{ item.status === 'closed' ? words()('resolved') : item.status === 'snoozed' ? words()('snoozed') : words()('open') }} · {{ inbox.person(item.assignee_id) }}</p><span :if="item.unread_count > 0" class="unread-count">{{ words()('unreadCount', { count: displayNumber(item.unread_count) }) }}</span></div></button><div :if="!inbox.loading() && inbox.filtered().length === 0" class="list-empty"><i class="i-hugeicons-inbox" aria-hidden="true"></i><strong>{{ inbox.searchError() ? words()('checkSearch') : search().trim() ? words()('noMatches') : words()('noConversations') }}</strong><p>{{ inbox.searchError() || (search().trim() ? words()('tryOther') : words()('connectToReceive')) }}</p></div></div><button :if="inbox.nextCursor()" type="button" class="p-4 text-button" @click="inbox.loadMore()" :disabled="inbox.loading()">{{ words()('loadMore') }}</button><footer class="list-footer"><span>{{ inbox.user()?.name || words()('workspace') }}</span><a href="/help/messenger">Setup guide <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a></footer></section>
  <section id="conversation" class="flex flex-col conversation-pane" :inert="inbox.narrowDetails() && inbox.detailsOpen()" tabindex="-1"><header class="flex gap-4 items-center justify-between thread-heading"><div class="min-w-0"><span class="thread-breadcrumb">{{ words()('conversations') }} / {{ words()(inbox.current()?.status === 'closed' ? 'resolved' : inbox.current()?.status || 'inbox') }}</span><h2>{{ inbox.current()?.subject || words()('sharedInbox') }}</h2><p class="mt-1 text-xs" role="status">{{ inbox.viewerNames() ? words()('alsoViewing', { names: inbox.viewerNames() }) : '' }}</p></div><div class="flex gap-2 items-center"><button :if="inbox.current()" type="button" class="button button-outline resolve-button" @click="inbox.changeStatus()" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><i class="i-hugeicons-tick-02" aria-hidden="true"></i>{{ inbox.current()?.status === 'closed' ? words()('reopen') : words()('resolve') }}</button><button type="button" class="icon-button" @click="inbox.toggleDetails()" id="customer-details-toggle" :aria-label="words()('toggleDetails')" aria-controls="customer-details" :aria-expanded="inbox.detailsOpen()"><i class="i-hugeicons-sidebar-right" aria-hidden="true"></i></button></div></header><div :if="inbox.error()" class="inbox-error" role="alert"><p>{{ inbox.error() }}</p><a :if="!inbox.user()" href="/login">{{ words()('signIn') }}</a></div><p :if="inbox.notice()" class="thread-notice" role="status">{{ inbox.notice() }}</p><section :if="inbox.current()?.continued_from_id || inbox.current()?.continuation_id" class="flex flex-wrap gap-3 items-center thread-notice" :aria-label="words()('linkedRequests')"><span>{{ words()('requestHistory') }}</span><button :if="inbox.current()?.continued_from_id" type="button" class="text-button" @click="inbox.openLinked('previous')" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()">{{ words()('previousRequest') }}</button><button :if="inbox.current()?.continuation_id" type="button" class="text-button" @click="inbox.openLinked('next')" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()">{{ words()('nextRequest') }}</button><span class="text-xs">{{ words()('requestHistoryHelp') }}</span></section><section :if="inbox.needsWorkspace()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-building-03" aria-hidden="true"></i></span><h2>A home for your support.</h2><p>Create a workspace to bring your conversations and team together. Your trial lasts 14 days.</p><form @submit.prevent="inbox.createWorkspace()"><label for="workspace-name">Workspace name</label><input id="workspace-name" x-model.trim="workspaceName" required maxlength="120" placeholder="Your team or company"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create workspace' }}</button></form></section><section :if="inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-source-code" aria-hidden="true"></i></span><h2>Meet your first project.</h2><p>A project connects your app to its customer conversations. Give it a name to start.</p><form @submit.prevent="inbox.createProject()"><label for="project-name">Project name</label><input id="project-name" x-model.trim="projectName" required maxlength="120" placeholder="Your app or website"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create project' }}</button></form></section><section :if="!inbox.current() && !inbox.needsWorkspace() && !inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-message-01" aria-hidden="true"></i></span><h2>{{ words()('conversationWelcome') }}</h2><p>{{ words()('selectConversation') }}</p><a href="/help/messenger" class="button button-outline">Connect your messenger <i class="i-hugeicons-arrow-right-02" aria-hidden="true"></i></a></section><div :if="inbox.newerMessagesAvailable()" class="flex justify-end px-4">
    <button id="load-latest-messages" class="min-h-11 text-button" type="button" aria-controls="agent-message-history" @click="inbox.reviewReply()" :disabled="inbox.sending()">{{ words()('showLatestMessages') }}</button>
  </div><div id="agent-message-history" :if="inbox.current()" class="thread-scroll" role="log" :aria-label="words()('conversationMessages')" aria-live="polite" :aria-busy="inbox.messagesLoading()">
    <p id="agent-reply-outside-page" :if="inbox.pendingAgentReply() && !inbox.newerMessagesAvailable()" class="mb-3 text-sm" role="status">{{ words()('reviewReplyInEarlierMessages') }}</p>
    <div :if="inbox.messagesNext()" class="mb-5">
      <button id="load-older-messages" type="button" class="min-h-11 text-button" @click="inbox.loadOlderMessages()" :aria-disabled="inbox.messagesLoading()">{{ words()(inbox.messagesLoading() ? 'olderMessagesLoading' : 'loadOlderMessages') }}</button>
      <p id="older-messages-error" :if="inbox.messagesError()" class="my-2 text-sm" role="alert">{{ words()('olderMessagesFailed') }}</p>
    </div>
    <article :for="message in inbox.messages()" :id="`thread-message-${message.id}`" tabindex="-1" class="thread-message" :class="message.visibility === 'internal' ? 'internal-message' : ''"><header class="message-heading"><span class="message-avatar">{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerInitial() : 'h' }}</span><strong>{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerName() : words()('team') }}</strong><span :if="message.visibility === 'internal'" class="note-label"><i class="i-hugeicons-lock-key" aria-hidden="true"></i> {{ words()('note') }}</span><time :datetime="message.created_at">{{ openDate(message.created_at) }}</time></header><p><span dir="auto">{{ message.body || words()('attachmentMessage') }}</span></p></article></div><form :if="inbox.current()" class="reply-composer" :class="visibility() === 'internal' ? 'note-composer' : ''" @submit.prevent="inbox.send()"><div class="composer-heading"><label for="reply-mode" class="sr-only">{{ words()('messageVisibility') }}</label><select id="reply-mode" x-model="visibility" @change="inbox.visibilityActivity($event)" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"><option value="public">{{ words()('publicReply') }}</option><option value="internal">{{ words()('note') }}</option></select><span>{{ visibility() === 'internal' ? words()('teamOnly') : words()('visibleToCustomer') }}</span></div>
  <p id="customer-typing" role="status" aria-atomic="true"><span :if="inbox.customerTyping()" class="block px-4 pb-2 text-sm">{{ words()('customerTyping') }}</span></p>
  <label for="reply" class="sr-only">{{ words()('writeReply') }}</label><textarea id="reply" dir="auto" x-model="draft" @input="inbox.draftActivity($event)" :aria-describedby="inbox.collision() ? 'reply-collision' : undefined" :required="!inbox.hasReply()" maxlength="10000" rows="4" :placeholder="visibility() === 'internal' ? words()('notePlaceholder') : words()('replyPlaceholder')" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()"></textarea>
  <div :if="inbox.canAttachReplyImage()" class="flex flex-wrap gap-2 items-center pb-3 px-4 text-xs">
    <span class="rounded focus-within:outline focus-within:outline-2 focus-within:outline-offset-2">
      <input id="reply-image" type="file" class="sr-only" accept="image/jpeg,image/png" @change="inbox.selectReplyImage($event)" :disabled="inbox.threadLoading() || inbox.sending() || inbox.routingBusy()">
      <label for="reply-image" class="cursor-pointer button button-outline"><i class="i-hugeicons-attachment-01" aria-hidden="true"></i>{{ words()('attachReplyImage') }}</label>
    </span>
    <span :if="inbox.replyImage()" class="break-all" dir="auto">{{ inbox.replyImage()?.file.name }}</span>
    <button :if="inbox.replyImage()" type="button" class="text-button" @click="inbox.removeReplyImage()" :disabled="inbox.sending()">{{ words()('removeReplyImage') }}</button>
    <p :if="inbox.replyImageError()" role="alert" class="basis-full">{{ words()(inbox.replyImageError()) }}</p>
  </div><div :if="inbox.collision()" class="mt-2 p-3 text-sm border border-amber-500/50 rounded"><p id="reply-collision" role="status">{{ inbox.replyChanged() ? words()('replyChanged') : words()('composing', { names: inbox.composingNames() }) }}</p><div class="flex flex-wrap gap-2 mt-2"><button type="button" class="text-button" @click="inbox.reviewReply()" :disabled="inbox.sending()">{{ words()('review') }}</button><button type="button" class="button button-outline" @click="inbox.send(true)" :disabled="inbox.sending() || inbox.threadLoading() || inbox.routingBusy() || inbox.replyTimelineBlocked()">{{ words()('sendAnyway') }}</button></div></div><div class="composer-footer"><span>{{ displayNumber(draft().length) }} / {{ displayNumber(10000) }}</span><button type="submit" class="button button-teal" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending() || !inbox.hasReply() || inbox.collision() || (visibility() === 'public' && inbox.replyTimelineBlocked())">{{ inbox.sending() ? words()('sending') : visibility() === 'internal' ? words()('addNote') : words()('sendReply') }}<i class="i-hugeicons-arrow-up-02" aria-hidden="true"></i></button></div></form></section>
  <button :if="inbox.narrowDetails() && inbox.detailsOpen()" type="button" class="customer-backdrop" tabindex="-1" aria-label="Close customer and assignment panel" @click="inbox.closeDetails()"></button><aside id="customer-details" class="customer-panel" tabindex="-1" :role="inbox.narrowDetails() ? 'dialog' : 'complementary'" :aria-modal="inbox.narrowDetails() && inbox.detailsOpen()" aria-labelledby="customer-details-title" :class="inbox.detailsOpen() ? '' : 'details-hidden'" aria-label="Customer details"><header><span id="customer-details-title">Customer and assignment details</span><button id="customer-details-close" type="button" class="icon-button" aria-label="Close customer details" @click="inbox.closeDetails()"><i class="i-hugeicons-cancel-01" aria-hidden="true"></i></button></header><section :if="inbox.contact()"><div class="customer-avatar">{{ inbox.customerInitial() }}</div><h2>{{ inbox.customerName() }}</h2><p class="customer-email">{{ inbox.contact()?.email || 'No email provided' }}</p><dl><div><dt>Customer ID</dt><dd>{{ inbox.contact()?.id || 'Unavailable' }}</dd></div><div><dt>Company</dt><dd>{{ inbox.contact()?.company || 'Not provided' }}</dd></div><div><dt>Conversation</dt><dd>#{{ inbox.current()?.id }}</dd></div><div><dt>Status</dt><dd>{{ inbox.current()?.status }}</dd></div></dl></section><section id="conversation-attachments" :if="inbox.attachments().length" class="border-t" aria-labelledby="conversation-attachments-title">
  <h3 id="conversation-attachments-title" class="mb-3 text-xs font-semibold">{{ words()('conversationAttachments') }}</h3>
  <ul class="space-y-2">
    <li :for="file in inbox.attachments()"><a :id="`conversation-attachment-${file.id}`" class="text-button flex items-start gap-2 text-xs" :href="inbox.attachmentDownloadPath(file.id)" :download="file.fileName"><i class="i-hugeicons-download-02" aria-hidden="true"></i><span class="break-all" dir="auto">{{ file.fileName }}</span></a></li>
  </ul>
  <button id="load-older-attachments" :if="inbox.attachmentsNext()" type="button" class="text-button mt-3" @click="inbox.loadOlderAttachments()" :disabled="inbox.attachmentsLoading()">{{ words()(inbox.attachmentsLoading() ? 'attachmentsLoading' : 'loadOlderAttachments') }}</button>
  <p :if="inbox.attachmentsError()" class="mt-3 text-xs" role="alert">{{ words()('attachmentsFailed') }}</p>
</section>
<section :if="inbox.current() && inbox.canManage()" class="case-retention routing-panel" aria-labelledby="retention-evidence-title">
  <h3 id="retention-evidence-title">{{ words()('retentionEvidence') }}</h3>
  <p class="field-help">{{ words()('retentionScope') }}</p>
  <button id="read-retention-evidence" type="button" class="mt-3 button button-outline" @click="inbox.loadRetentionEvidence()" :aria-disabled="inbox.retentionLoading() || inbox.threadLoading()" aria-controls="retention-evidence-result">{{ words()(inbox.retentionEvidence() ? 'retentionRefresh' : 'retentionRead') }}</button>
  <p role="status" class="field-help">{{ inbox.retentionLoading() ? words()('retentionLoading') : inbox.retentionEvidence() ? words()('retentionLoaded') : '' }}</p>
  <p :if="inbox.retentionError()" role="alert" class="routing-error">{{ words()('retentionFailed') }}</p>
  <div id="retention-evidence-result">
    <dl :if="inbox.retentionEvidence()">
      <div><dt>{{ words()('retentionCaseId') }}</dt><dd><code dir="ltr">{{ inbox.retentionEvidence()?.conversationId }}</code></dd></div>
      <div><dt>{{ words()('retentionPolicy') }}</dt><dd>{{ inbox.retentionEvidence()?.policy ? words()(inbox.retentionEvidence()?.policy?.enabled ? 'retentionWindow' : 'retentionWindowOff', { days: displayNumber(inbox.retentionEvidence()?.policy?.days ?? 0) }) : words()('retentionNone') }}</dd></div>
      <div><dt>{{ words()('retentionHold') }}</dt><dd>{{ words()(inbox.retentionEvidence()?.held ? 'retentionHoldActive' : 'retentionNone') }}</dd></div>
      <div><dt>{{ words()('retentionSubject') }}</dt><dd>{{ words()(inbox.retentionEvidence()?.content.subjectPresent ? 'retentionPresent' : 'retentionNone') }}</dd></div>
      <div><dt>{{ words()('retentionMessageBodies') }}</dt><dd>{{ displayNumber(inbox.retentionEvidence()?.content.messageBodies ?? 0) }}</dd></div>
      <div><dt>{{ words()('retentionAttachmentRecords') }}</dt><dd>{{ displayNumber(inbox.retentionEvidence()?.content.attachmentRecords ?? 0) }}</dd></div>
      <div><dt>{{ words()('retentionActiveAttachments') }}</dt><dd>{{ displayNumber(inbox.retentionEvidence()?.content.attachmentsNotDeleted ?? 0) }}</dd></div>
      <div><dt>{{ words()('retentionLastRedaction') }}</dt><dd>
        <span :if="inbox.retentionEvidence()?.lastRedaction"><code dir="ltr">{{ inbox.retentionEvidence()?.lastRedaction?.auditEventId }}</code><time :datetime="inbox.retentionEvidence()?.lastRedaction?.occurredAt">{{ auditDate(inbox.retentionEvidence()?.lastRedaction?.occurredAt) }}</time></span>
        <span :if="!inbox.retentionEvidence()?.lastRedaction">{{ words()('retentionNone') }}</span>
      </dd></div>
    </dl>
  </div>
</section>
<section :if="inbox.current() && inbox.contact()" class="routing-panel" aria-labelledby="assignment-heading"><h3 id="assignment-heading">Assignment</h3><dl><div><dt>{{ words()('inbox') }}</dt><dd>{{ inbox.inboxName(inbox.current()?.inbox_id) }}</dd></div><div><dt>Assignee</dt><dd>{{ inbox.person(inbox.current()?.assignee_id) }}</dd></div></dl><p class="field-help" role="status">{{ inbox.routingNotice() || inbox.routingReasonLabel(inbox.current()?.routing_reason) }}</p><p :if="inbox.routingError()" class="routing-error" role="alert">{{ inbox.routingError() }}</p>
<form :if="inbox.canManage()" @submit.prevent="inbox.route('manual')"><label for="assignment-inbox">{{ words()('teamInbox') }}</label><select id="assignment-inbox" x-model="routingInbox" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()"><option value="0">{{ words()('withoutInbox') }}</option><option :for="item in inbox.inboxes()" :value="String(item.id)" :disabled="!item.active">{{ item.name }}{{ item.active ? '' : ' (inactive)' }}</option></select><label for="assignment-agent">Assign to</label><select id="assignment-agent" x-model="routingAssignee" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()"><option value="0">Unassigned</option><option :for="item in inbox.candidateAgents()" :value="String(item.id)" :disabled="inbox.candidateDisabled(item.id)">{{ inbox.agentLabel(item.id) }}</option></select><button type="submit" class="button button-outline" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">{{ inbox.routingBusy() ? 'Saving...' : 'Save assignment' }}</button><button type="button" class="text-button" @click="inbox.route('auto')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending() || !inbox.canAutoRoute()">Retry automatic routing</button></form>
<div :if="!inbox.canManage()"><button :if="Number(inbox.current()?.assignee_id) === 0" type="button" class="button button-outline" @click="inbox.route('manual', 'claim')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">Claim for myself</button><button :if="String(inbox.current()?.assignee_id) === String(inbox.user()?.id)" type="button" class="button button-outline" @click="inbox.route('manual', 'release')" :disabled="inbox.threadLoading() || inbox.routingBusy() || inbox.sending()">Release my assignment</button><p class="field-help">Owners and admins can move inboxes or assign other members. Claims still require team membership, availability and capacity.</p></div><a href="/app/team-settings" class="text-button">Teams, availability and capacity</a>
<details class="mt-4"><summary class="text-xs cursor-pointer">Assignment history (latest 100)</summary><button type="button" class="text-button" @click="inbox.loadHistory()">Refresh history</button><article :for="item in inbox.assignments()" class="assignment-entry"><strong>{{ inbox.actorLabel(item) }}</strong><p>{{ inbox.person(item.before.assigneeId) }} → {{ inbox.person(item.after.assigneeId) }}</p><p>{{ inbox.inboxName(item.before.inboxId) }} → {{ inbox.inboxName(item.after.inboxId) }}</p><p>{{ inbox.routingReasonLabel(item.reason) }}</p><time>{{ inbox.formatDate(item.created_at) }}</time></article><p :if="!inbox.assignments().length" class="field-help">No assignment decisions recorded yet.</p></details></section><div :if="!inbox.contact()" class="customer-empty"><i class="i-hugeicons-user-circle" aria-hidden="true"></i><p>Customer context appears when you open a conversation.</p></div><div class="privacy-note"><i class="i-hugeicons-lock-key" aria-hidden="true"></i><p>Customer context is scoped to this workspace.</p></div></aside>
</main></body></html>
