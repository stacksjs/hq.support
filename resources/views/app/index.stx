<script server>
const pageTitle = 'Inbox'
const pageDescription = 'Your HQ.support team inbox.'
</script>
<script client>
import { createInbox } from '../../functions/support/inbox'
const inbox = createInbox()
const project = inbox.project
const search = inbox.search
const draft = inbox.draft
const visibility = inbox.visibility
const workspaceName = inbox.workspaceName
const projectName = inbox.projectName
onMount(() => inbox.load())
onDestroy(() => inbox.destroy())
</script>
<!DOCTYPE html>
<html lang="en"><head>@include('head')<link rel="stylesheet" href="/support.css"><link rel="stylesheet" href="/inbox.css"><link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet"></head>
<body class="min-h-[100dvh] antialiased text-[#20332f] bg-[#fafbf9]"><a class="skip-link" href="#conversation">Skip to conversation</a>
<main id="main" class="grid inbox-shell">
  <aside class="flex flex-col workspace-rail" aria-label="Workspace navigation"><a class="rail-logo" href="/" aria-label="HQ.support home">h</a><a class="active rail-link" href="/app" aria-label="Inbox" title="Inbox"><i class="i-hugeicons-inbox" aria-hidden="true"></i></a><a class="rail-link" href="/help" aria-label="Help center" title="Help center"><i class="i-hugeicons-book-open-01" aria-hidden="true"></i></a><a class="rail-link" href="/app/settings" aria-label="Settings" title="Settings"><i class="i-hugeicons-settings-01" aria-hidden="true"></i></a><div class="rail-bottom"><a class="rail-link" href="/login" aria-label="Account" title="Account"><i class="i-hugeicons-user-circle" aria-hidden="true"></i></a></div></aside>
  <section class="flex flex-col conversation-list" aria-label="Conversation list"><header class="list-heading"><div class="flex items-center justify-between"><h1>Inbox</h1><button class="icon-button" type="button" @click="inbox.refresh()" :disabled="inbox.loading()" aria-label="Refresh inbox" title="Refresh inbox"><i class="i-hugeicons-refresh" aria-hidden="true"></i></button></div><label for="project" class="sr-only">Project</label><select id="project" x-model="project" @change="inbox.changeProject()" :disabled="inbox.sending()"><option value="">Select a project</option><option :for="item in inbox.projects()" :value="item.public_id || item.id">{{ item.name }}</option></select><div class="search-field"><i class="i-hugeicons-search-01" aria-hidden="true"></i><input type="search" x-model="search" placeholder="Search conversations" aria-label="Search conversations"></div></header><div class="flex gap-1 items-center inbox-filters" role="group" aria-label="Conversation status"><button type="button" :class="inbox.filter() === 'open' ? 'selected' : ''" @click="inbox.filter.set('open')">Open</button><button type="button" :class="inbox.filter() === 'snoozed' ? 'selected' : ''" @click="inbox.filter.set('snoozed')">Snoozed</button><button type="button" :class="inbox.filter() === 'closed' ? 'selected' : ''" @click="inbox.filter.set('closed')">Resolved</button><button type="button" :class="inbox.filter() === 'all' ? 'selected' : ''" @click="inbox.filter.set('all')">All</button></div><div class="list-count">{{ inbox.filtered().length }} {{ inbox.filtered().length === 1 ? 'conversation' : 'conversations' }}</div><div class="list-scroll"><p :if="inbox.loading()" class="list-empty" role="status">Loading your inbox...</p><button :for="item in inbox.filtered()" type="button" class="conversation-row" :class="String(inbox.current()?.id) === String(item.id) ? 'is-current' : ''" @click="inbox.select(item)" :disabled="inbox.sending()"><div class="row-avatar">{{ item.subject.charAt(0).toUpperCase() }}</div><div class="row-copy"><div class="row-top"><strong>{{ item.subject }}</strong><time>{{ inbox.formatDate(item.updated_at) }}</time></div><p>{{ item.status === 'closed' ? 'Resolved conversation' : 'Open conversation' }}</p><span :if="item.unread_count > 0" class="unread-count">{{ item.unread_count }} unread</span></div></button><div :if="!inbox.loading() && inbox.filtered().length === 0" class="list-empty"><i class="i-hugeicons-inbox" aria-hidden="true"></i><strong>No conversations here yet</strong><p>Customer messages will appear here when your messenger is connected.</p></div></div><footer class="list-footer"><span>{{ inbox.user()?.name || 'Your workspace' }}</span><a href="/help/messenger">Setup guide <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a></footer></section>
  <section id="conversation" class="flex flex-col conversation-pane" tabindex="-1"><header class="flex gap-4 items-center justify-between thread-heading"><div class="min-w-0"><span class="thread-breadcrumb">Conversations / {{ inbox.current()?.status || 'Inbox' }}</span><h2>{{ inbox.selectedTitle() }}</h2></div><div class="flex gap-2 items-center"><button :if="inbox.current()" type="button" class="button button-outline resolve-button" @click="inbox.changeStatus()" :disabled="inbox.sending()"><i class="i-hugeicons-tick-02" aria-hidden="true"></i>{{ inbox.current()?.status === 'closed' ? 'Reopen' : 'Resolve' }}</button><button type="button" class="icon-button" @click="inbox.detailsOpen.update(value => !value)" aria-label="Toggle customer details"><i class="i-hugeicons-sidebar-right" aria-hidden="true"></i></button></div></header><div :if="inbox.error()" class="inbox-error" role="alert"><p>{{ inbox.error() }}</p><a :if="!inbox.user()" href="/login">Sign in to your account</a></div><p :if="inbox.notice()" class="thread-notice" role="status">{{ inbox.notice() }}</p><section :if="inbox.needsWorkspace()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-building-03" aria-hidden="true"></i></span><h2>A home for your support.</h2><p>Create a workspace to bring your conversations and team together. Your trial lasts 14 days.</p><form @submit.prevent="inbox.createWorkspace()"><label for="workspace-name">Workspace name</label><input id="workspace-name" x-model.trim="workspaceName" required maxlength="120" placeholder="Your team or company"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create workspace' }}</button></form></section><section :if="inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-source-code" aria-hidden="true"></i></span><h2>Meet your first project.</h2><p>A project connects your app to its customer conversations. Give it a name to start.</p><form @submit.prevent="inbox.createProject()"><label for="project-name">Project name</label><input id="project-name" x-model.trim="projectName" required maxlength="120" placeholder="Your app or website"><button type="submit" class="button button-teal" :disabled="inbox.creating()">{{ inbox.creating() ? 'Creating...' : 'Create project' }}</button></form></section><section :if="!inbox.current() && !inbox.needsWorkspace() && !inbox.needsProject()" class="welcome-pane"><span class="welcome-symbol"><i class="i-hugeicons-message-01" aria-hidden="true"></i></span><h2>A good conversation starts here.</h2><p>Select a conversation to see the full story, leave a note, or send a reply.</p><a href="/help/messenger" class="button button-outline">Connect your messenger <i class="i-hugeicons-arrow-right-02" aria-hidden="true"></i></a></section><div :if="inbox.current()" class="thread-scroll" role="log" aria-label="Conversation messages" aria-live="polite"><article :for="message in inbox.messages()" class="thread-message" :class="message.visibility === 'internal' ? 'internal-message' : ''"><header class="message-heading"><span class="message-avatar">{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerInitial() : 'h' }}</span><strong>{{ ['contact', 'customer'].includes(message.author_type) ? inbox.customerName() : 'Team' }}</strong><span :if="message.visibility === 'internal'" class="note-label"><i class="i-hugeicons-lock-key" aria-hidden="true"></i> Internal note</span><time>{{ inbox.formatDate(message.created_at) }}</time></header><p>{{ message.body }}</p></article></div><form :if="inbox.current()" class="reply-composer" :class="visibility() === 'internal' ? 'note-composer' : ''" @submit.prevent="inbox.send()"><div class="composer-heading"><label for="reply-mode" class="sr-only">Message visibility</label><select id="reply-mode" x-model="visibility" :disabled="inbox.sending()"><option value="public">Public reply</option><option value="internal">Internal note</option></select><span>{{ visibility() === 'internal' ? 'Only your team can see this' : 'Visible to the customer' }}</span></div><label for="reply" class="sr-only">Write a reply</label><textarea id="reply" x-model="draft" required maxlength="10000" rows="4" :placeholder="visibility() === 'internal' ? 'Leave context for your team...' : 'Write a thoughtful reply...'" :disabled="inbox.sending()"></textarea><div class="composer-footer"><span>{{ draft().length }} / 10,000</span><button type="submit" class="button button-teal" :disabled="inbox.sending() || !draft().trim()">{{ inbox.sending() ? 'Sending...' : visibility() === 'internal' ? 'Add note' : 'Send reply' }}<i class="i-hugeicons-arrow-up-02" aria-hidden="true"></i></button></div></form></section>
  <aside class="customer-panel" :class="inbox.detailsOpen() ? '' : 'details-hidden'" aria-label="Customer details"><header>Customer details</header><section :if="inbox.contact()"><div class="customer-avatar">{{ inbox.customerInitial() }}</div><h2>{{ inbox.customerName() }}</h2><p class="customer-email">{{ inbox.contact()?.email || 'No email provided' }}</p><dl><div><dt>Customer ID</dt><dd>{{ inbox.contact()?.id || 'Unavailable' }}</dd></div><div><dt>Company</dt><dd>{{ inbox.contact()?.company || 'Not provided' }}</dd></div><div><dt>Conversation</dt><dd>#{{ inbox.current()?.id }}</dd></div><div><dt>Status</dt><dd>{{ inbox.current()?.status }}</dd></div></dl></section><div :if="!inbox.contact()" class="customer-empty"><i class="i-hugeicons-user-circle" aria-hidden="true"></i><p>Customer context appears when you open a conversation.</p></div><div class="privacy-note"><i class="i-hugeicons-lock-key" aria-hidden="true"></i><p>Customer context is scoped to this workspace.</p></div></aside>
</main></body></html>
