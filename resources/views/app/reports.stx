<script server>
const pageTitle = 'Reports'
const pageDescription = 'Conversation, message, and ticket totals and response times for your HQ.support project.'
</script>
<script client>
import { createReports } from '../../functions/support/reports'
const reports = createReports()
const workspace = reports.workspace
const project = workspace.project
onMount(() => reports.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Reports</h1></div><div class="project-picker"><label for="report-project">Project</label><select id="report-project" x-model="project" @change="reports.load()" :disabled="workspace.loading()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p>
<div class="console-toolbar"><a href="/app/customer-satisfaction" class="console-link">Customer satisfaction totals</a><button type="button" class="button button-outline" @click="reports.load()" :disabled="workspace.loading()">Refresh reports</button></div>
<p :if="workspace.loading()" class="console-loading" role="status">Loading reports…</p>
<div :if="reports.report()">
  <section :if="reports.report()?.consolidations" class="mt-6" aria-labelledby="report-consolidations-heading">
    <h2 id="report-consolidations-heading">Duplicate conversations</h2>
    <p>{{ reports.report()?.consolidations?.active ?? 0 }} active consolidations out of {{ reports.report()?.consolidations?.total ?? 0 }} recorded.</p>
  </section>
  <section aria-labelledby="report-messenger-heading" class="mt-6">
    <h2 id="report-messenger-heading">Messenger response and resolution</h2>
    <p class="field-help">Averages for conversations created in the past 30 days. Times include nights and weekends.</p>
    <div class="metric-grid">
      <article :for="metric in reports.timings()" class="metric-cell">
        <h3>{{ metric.label }}</h3>
        <strong>{{ reports.duration(metric.averageMs) }}</strong>
        <p>{{ metric.samples.toLocaleString() }} {{ metric.samples === 1 ? 'sample' : 'samples' }}</p>
        <p>{{ metric.detail }}</p>
      </article>
    </div>
  </section>
  <section :if="reports.channels().length > 0" class="mt-6" aria-labelledby="report-channels-heading">
    <h2 id="report-channels-heading">Channel response and resolution</h2>
    <p class="field-help">For conversations opened in the past 30 days. Reply timings use provider acceptance.</p>
    <div class="overflow-x-auto">
      <table class="w-full text-start">
        <thead><tr><th scope="col">Channel</th><th scope="col">First human reply</th><th scope="col">Follow-up reply</th><th scope="col">Time to resolution</th></tr></thead>
        <tbody>
          <tr :for="item in reports.channels()">
            <th scope="row">{{ item.label }}</th>
            <td :for="metric in [item.firstReply, item.followUpReply, item.resolution]">
              {{ reports.duration(metric.averageMs) }}
              <span :if="metric.samples > 0" class="field-help block">{{ metric.samples.toLocaleString() }} {{ metric.samples === 1 ? 'sample' : 'samples' }}</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <section :if="reports.slaTimings().length > 0" class="mt-6" aria-labelledby="report-sla-heading">
    <h2 id="report-sla-heading">Ticket SLA time</h2>
    <p class="field-help">Working time for SLA responses and resolutions in the past 30 days. The ticket policy sets working hours and pauses.</p>
    <div class="metric-grid">
      <article :for="metric in reports.slaTimings()" class="metric-cell">
        <h3>{{ metric.label }}</h3>
        <strong>{{ reports.duration(metric.averageMs) }}</strong>
        <p>{{ metric.samples.toLocaleString() }} {{ metric.samples === 1 ? 'sample' : 'samples' }}</p>
      </article>
    </div>
  </section>
  <section class="mt-6" aria-labelledby="report-totals-heading">
    <h2 id="report-totals-heading">All-time project totals</h2>
    <div class="metric-grid">
      <article class="metric-cell"><h3>Conversations</h3><strong>{{ reports.total(reports.report()?.conversations) }}</strong><p>All conversation statuses</p></article>
      <article class="metric-cell"><h3>Messages</h3><strong>{{ reports.total(reports.report()?.messages) }}</strong><p>Customer, team, and recorded automated messages</p></article>
      <article class="metric-cell"><h3>Tickets</h3><strong>{{ reports.total(reports.report()?.tickets) }}</strong><p>All ticket statuses</p></article>
    </div>
    <div class="report-columns">
      <article class="report-group"><h3>Conversation status</h3><dl><div :for="row in reports.report()?.conversations"><dt>{{ row.status }}</dt><dd>{{ row.total }}</dd></div></dl><p :if="reports.report()?.conversations.length === 0" class="field-help">No conversations recorded yet.</p></article>
      <article class="report-group"><h3>Message authors</h3><dl><div :for="row in reports.report()?.messages"><dt>{{ row.author_type }}</dt><dd>{{ row.total }}</dd></div></dl><p :if="reports.report()?.messages.length === 0" class="field-help">No messages recorded yet.</p></article>
      <article class="report-group"><h3>Ticket status</h3><dl><div :for="row in reports.report()?.tickets"><dt>{{ row.status }}</dt><dd>{{ row.total }}</dd></div></dl><p :if="reports.report()?.tickets.length === 0" class="field-help">No tickets recorded yet.</p></article>
    </div>
  </section>
</div>
@endsection
