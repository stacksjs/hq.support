<script server>
const pageTitle = 'Usage and credit'
const pageDescription = 'View HQ.support usage allowances and prepaid communications credit.'
</script>
<script client>
import { createUsage } from '../../functions/support/usage'
const usage = createUsage()
const workspace = usage.workspace
const project = workspace.project
const amount = usage.amount
onMount(() => usage.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Usage and credit</h1><p>See your workspace allowances and prepaid balance. Usage is measured across the workspace, even when you select one project.</p></div><div class="project-picker"><label for="usage-project">Project</label><select id="usage-project" x-model="project" @change="usage.load()" :disabled="workspace.loading() || workspace.pending()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading" role="status">Loading workspace usage...</p>
<section :if="usage.billing()"><div class="resource-overview"><span class="status-label">{{ usage.billing()?.workspace.plan }}</span><span>Monthly usage resets on the UTC calendar month.</span><button class="text-button" type="button" @click="usage.load()" :disabled="workspace.pending() || workspace.loading()">Refresh usage</button></div><div class="metric-grid"><article class="metric-cell"><h2>New conversations</h2><strong>{{ usage.count(usage.billing()?.usage.conversations) }}</strong><p>{{ usage.count(usage.billing()?.limits.conversations) }} included / {{ usage.count(usage.billing()?.limits.conversationCeiling) }} admission ceiling</p></article><article class="metric-cell"><h2>AI handled conversations</h2><strong>{{ usage.count(usage.billing()?.usage.ai) }}</strong><p>{{ usage.count(usage.billing()?.limits.ai) }} included this month</p></article><article class="metric-cell"><h2>Stored attachments</h2><strong>{{ usage.bytes(usage.billing()?.usage.storageBytes) }}</strong><p>{{ usage.bytes(usage.billing()?.limits.storageBytes) }} storage allowance</p></article></div><div class="wallet-grid"><section class="wallet-panel"><h2>Prepaid communications credit</h2><p :if="usage.walletError()" class="console-error" role="alert">{{ usage.walletError() }}</p><p :if="!workspace.canManage()" class="field-help">Only workspace owners and admins can view or fund the prepaid wallet.</p><div :if="usage.wallet()"><p class="wallet-amount">{{ usage.money(usage.wallet()?.balanceCents) }}</p><p class="field-help">USD balance. Automatic top up is {{ usage.wallet()?.autoTopupEnabled ? 'enabled' : 'off' }}.</p><form :if="usage.wallet()?.checkoutAvailable" @submit.prevent="usage.checkout()"><div><label for="wallet-amount">Top up amount (USD)</label><input id="wallet-amount" x-model="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div><button type="submit" class="button button-teal" :disabled="workspace.pending()">{{ workspace.pending() ? 'Preparing...' : 'Prepare secure checkout' }}</button></form><a :if="usage.checkoutCurrent()" class="button button-teal checkout-link" :href="usage.checkoutUrl()" rel="noopener">Continue to Stripe <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a><p :if="!usage.wallet()?.checkoutAvailable" class="capability-note">Wallet funding is unavailable because the payment provider is not configured. No checkout or payment will be created.</p><p class="mt-4 field-help">Minimum top up: {{ usage.money(usage.wallet()?.minimumTopupCents) }}. Maximum per checkout: $1,000. Credit appears only after a verified provider payment.</p></div></section><section class="wallet-panel"><h2>Spending controls</h2><dl class="spending-controls"><div><dt>Usage overages</dt><dd>{{ usage.billing()?.workspace.overagesEnabled ? 'Enabled' : 'Off' }}</dd></div><div><dt>Spending cap</dt><dd>{{ usage.money(usage.billing()?.workspace.spendingCapCents) }}</dd></div><div><dt>Included seats</dt><dd>{{ usage.count(usage.billing()?.limits.seats) }}</dd></div><div><dt>Projects</dt><dd>{{ usage.count(usage.billing()?.limits.projects) }}</dd></div></dl><p class="capability-note">Managed messaging and voice use prepaid credit at actual provider cost plus 15%. Funding credit does not enable an unconfigured channel.</p><p :if="!usage.billing()?.checkoutAvailable" class="mt-4 field-help">Hosted subscription checkout is not available yet. Current plan and limits come from the workspace record.</p><a href="/pricing" class="text-xs console-link">View launch pricing</a></section></div><section :if="usage.wallet()" class="mt-8"><h2 class="text-xl">Wallet activity</h2><div :if="usage.wallet()?.entries.length" class="table-scroll"><table class="console-table"><thead><tr><th scope="col">Recorded</th><th scope="col">Activity</th><th scope="col">Amount</th><th scope="col">Balance after</th></tr></thead><tbody><tr :for="entry in usage.wallet()?.entries"><td>{{ entry.created_at }}</td><td>{{ entry.kind }}</td><td>{{ usage.money(Number(entry.amount_cents)) }}</td><td>{{ usage.money(Number(entry.balance_cents)) }}</td></tr></tbody></table></div><p :if="usage.wallet()?.entries.length === 0" class="console-empty">No wallet transactions have been recorded.</p></section></section>
@endsection
