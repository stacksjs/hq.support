<script server>
const pageTitle = 'Usage and credit'
const pageDescription = 'View HQ.support usage allowances and prepaid communications credit.'
</script>
<script client>
import { createUsage } from '../../functions/support/usage'
const usage = createUsage()
const workspace = usage.workspace
const project = workspace.project
const amount = usage.amount
const plan = usage.plan
const interval = usage.interval
const dailyLimit = usage.dailyLimit
const monthlyLimit = usage.monthlyLimit
const projectDailyLimit = usage.projectDailyLimit
const projectMonthlyLimit = usage.projectMonthlyLimit
onMount(() => usage.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Usage and credit</h1><p>See your workspace allowances and prepaid balance. Usage is measured across the workspace, even when you select one project.</p></div><div class="project-picker"><label for="usage-project">Project</label><select id="usage-project" x-model="project" @change="usage.load()" :disabled="workspace.loading() || workspace.pending()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading" role="status">Loading workspace usage...</p>
<section :if="usage.billing()"><div class="resource-overview"><span class="status-label">{{ usage.billing()?.workspace.plan }}</span><span>Monthly usage resets on the UTC calendar month.</span><button class="text-button" type="button" @click="usage.load()" :disabled="workspace.pending() || workspace.loading()">Refresh usage</button></div><div class="metric-grid"><article class="metric-cell"><h2>New conversations</h2><strong>{{ usage.count(usage.billing()?.usage.conversations) }}</strong><p>{{ usage.count(usage.billing()?.limits.conversations) }} included / {{ usage.count(usage.billing()?.limits.conversationCeiling) }} admission ceiling</p></article><article class="metric-cell"><h2>AI handled conversations</h2><strong>{{ usage.count(usage.billing()?.usage.ai) }}</strong><p>{{ usage.count(usage.billing()?.limits.ai) }} included this month</p></article><article class="metric-cell"><h2>Stored attachments</h2><strong>{{ usage.bytes(usage.billing()?.usage.storageBytes) }}</strong><p>{{ usage.bytes(usage.billing()?.limits.storageBytes) }} storage allowance</p></article></div><div class="wallet-grid"><section class="wallet-panel"><h2>Prepaid communications credit</h2><p :if="usage.walletError()" class="console-error" role="alert">{{ usage.walletError() }}</p><p :if="!workspace.canManage()" class="field-help">Only workspace owners and admins can view or fund the prepaid wallet.</p><div :if="usage.wallet()"><p class="wallet-amount">{{ usage.money(usage.wallet()?.balanceCents) }}</p><p class="field-help">USD balance. Automatic top up is {{ usage.wallet()?.autoTopupEnabled ? 'enabled' : 'off' }}.</p><form :if="usage.wallet()?.checkoutAvailable" @submit.prevent="usage.checkout()"><div><label for="wallet-amount">Top up amount (USD)</label><input id="wallet-amount" x-model="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div><button type="submit" class="button button-teal" :disabled="workspace.pending()">{{ workspace.pending() ? 'Preparing...' : 'Prepare secure checkout' }}</button></form><a :if="usage.checkoutCurrent()" class="button button-teal checkout-link" :href="usage.checkoutUrl()" rel="noopener">Continue to Stripe <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a><p :if="!usage.wallet()?.checkoutAvailable" class="capability-note">Wallet funding is unavailable because the payment provider is not configured. No checkout or payment will be created.</p><p class="mt-4 field-help">Minimum top up: {{ usage.money(usage.wallet()?.minimumTopupCents) }}. Maximum per checkout: $1,000. Credit appears only after a verified provider payment.</p></div></section><section class="wallet-panel"><h2>Spending controls</h2><dl class="spending-controls"><div><dt>Usage overages</dt><dd>{{ usage.billing()?.workspace.overagesEnabled ? 'Enabled' : 'Off' }}</dd></div><div><dt>Usage overage cap</dt><dd>{{ usage.money(usage.billing()?.workspace.spendingCapCents) }}</dd></div><div><dt>Included seats</dt><dd>{{ usage.count(usage.billing()?.limits.seats) }}</dd></div><div><dt>Projects</dt><dd>{{ usage.count(usage.billing()?.limits.projects) }}</dd></div></dl><p class="capability-note">Managed messaging and voice use prepaid credit at actual provider cost plus 15%. Funding credit does not enable an unconfigured channel.</p><a href="/pricing" class="text-xs console-link">View launch pricing</a></section></div><section :if="usage.wallet()" class="mt-8 wallet-panel"><h2>Managed spending ceilings</h2><p class="field-help">Ceilings limit paid messaging and voice across this workspace. A zero daily or monthly ceiling pauses new managed paid operations.</p><dl class="spending-controls"><div><dt>UTC day, including reserved costs</dt><dd>{{ usage.money(usage.wallet()?.spending.dailyCents) }} / {{ usage.money(usage.wallet()?.dailyLimitCents) }}</dd></div><div><dt>UTC month, including reserved costs</dt><dd>{{ usage.money(usage.wallet()?.spending.monthlyCents) }} / {{ usage.money(usage.wallet()?.monthlyLimitCents) }}</dd></div><div><dt>Managed paid operations</dt><dd>{{ usage.wallet()?.dailyLimitCents === 0 || usage.wallet()?.monthlyLimitCents === 0 ? 'Paused by spending ceiling' : 'Subject to credit and provider availability' }}</dd></div></dl><form class="mt-5" @submit.prevent="usage.saveLimits()"><div class="grid gap-4 sm:grid-cols-2"><div><label for="daily-spending-limit">Daily ceiling (USD)</label><input id="daily-spending-limit" x-model="dailyLimit" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div><div><label for="monthly-spending-limit">Monthly ceiling (USD)</label><input id="monthly-spending-limit" x-model="monthlyLimit" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div></div><p class="mt-4 field-help">The monthly ceiling must cover the daily ceiling. Funding your wallet does not change these limits.</p><button type="submit" class="mt-4 button button-teal" :disabled="workspace.pending()">{{ workspace.pending() ? 'Saving...' : 'Save spending ceilings' }}</button></form></section><section :if="usage.projectWallet() || usage.projectWalletError()" class="mt-8 wallet-panel" aria-labelledby="project-spending-heading">
<h2 id="project-spending-heading">Project spending ceilings</h2>
<p :if="usage.projectWalletError()" class="console-error" role="alert">{{ usage.projectWalletError() }}</p>
<div :if="usage.projectWallet()">
<p class="field-help">Set an additional limit for this project's paid messaging and voice. Leave a field blank to use the workspace ceiling. Set it to $0 to pause new paid operations for this project.</p>
<dl class="spending-controls"><div><dt>UTC day, including reserved costs</dt><dd>{{ usage.money(usage.projectWallet()?.spending.dailyCents) }}</dd></div><div><dt>UTC month, including reserved costs</dt><dd>{{ usage.money(usage.projectWallet()?.spending.monthlyCents) }}</dd></div></dl>
<form class="mt-5" @submit.prevent="usage.saveProjectLimits()">
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label for="project-daily-limit">Project daily ceiling (USD)</label><input id="project-daily-limit" x-model="projectDailyLimit" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div>
    <div><label for="project-monthly-limit">Project monthly ceiling (USD)</label><input id="project-monthly-limit" x-model="projectMonthlyLimit" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" :disabled="workspace.pending()"></div>
  </div>
  <button type="submit" class="mt-4 button button-teal" :disabled="workspace.pending()">{{ workspace.pending() ? 'Saving...' : 'Save project ceilings' }}</button>
</form>
</div>
</section>
<section class="mt-8 wallet-panel"><h2>{{ usage.subscription()?.deploymentMode === 'selfhost' ? 'Self-hosted installation' : 'Hosted subscription' }}</h2>
<p :if="usage.subscription()?.deploymentMode === 'selfhost'" class="field-help">This installation does not sell hosted subscriptions. New self-hosted workspaces use uncapped MIT core; provider usage and infrastructure remain the operator’s responsibility. Commercial Enterprise features require their separate installation license.</p>
<p :if="!workspace.canManage()" class="field-help">Only workspace owners and admins can manage subscription billing.</p>
<p :if="usage.subscriptionError()" class="console-error" role="alert">{{ usage.subscriptionError() }}</p>
<div :if="usage.subscription()">
<dl :if="usage.subscription()?.subscription" class="spending-controls"><div><dt>Subscription</dt><dd>{{ usage.subscription()?.subscription?.plan }} / {{ usage.subscription()?.subscription?.interval }}</dd></div><div><dt>Payment status</dt><dd>{{ usage.subscription()?.subscription?.status }}</dd></div><div><dt>Paid period ends (UTC)</dt><dd>{{ usage.date(usage.subscription()?.subscription?.current_period_end) }}</dd></div><div><dt>Cancellation</dt><dd>{{ usage.subscription()?.subscription?.cancel_at_period_end ? 'At the end of the paid period' : 'No scheduled cancellation' }}</dd></div></dl>
<p :if="!usage.subscription()?.subscription && usage.subscription()?.deploymentMode !== 'selfhost'" class="field-help">No paid subscription has been recorded for this workspace.</p>
<form :if="usage.subscription()?.checkoutAvailable && usage.canSubscribe()" class="mt-5" @submit.prevent="usage.subscribe()"><div class="grid gap-4 sm:grid-cols-3"><div><label for="subscription-plan">Hosted plan</label><select id="subscription-plan" x-model="plan" :disabled="workspace.pending() || !!usage.subscription()?.pendingCheckout"><option value="starter">Starter</option><option value="growth">Growth</option><option value="enterprise">Enterprise</option></select></div><div><label for="subscription-interval">Billing frequency</label><select id="subscription-interval" x-model="interval" :disabled="workspace.pending() || !!usage.subscription()?.pendingCheckout"><option value="month">Monthly</option><option value="year">Annual</option></select></div><div><label>Subscription price (USD)</label><p class="font-semibold text-2xl">{{ usage.money(usage.selectedPrice()) }} <span class="font-normal text-sm">/ {{ interval() === 'year' ? 'year' : 'month' }}</span></p></div></div><p class="mt-4 field-help">{{ usage.count(usage.subscription()?.plans[plan()]?.seats) }} included seats, {{ usage.count(usage.subscription()?.plans[plan()]?.conversations) }} new conversations and {{ usage.count(usage.subscription()?.plans[plan()]?.ai) }} AI handled conversations per month. Annual billing charges ten monthly payments.</p><button type="submit" class="mt-4 button button-teal" :disabled="workspace.pending()">{{ workspace.pending() ? 'Preparing...' : 'Prepare subscription checkout' }}</button></form>
<a :if="usage.subscriptionCurrent()" class="button button-teal checkout-link" :href="usage.subscriptionUrl()" rel="noopener">Continue subscription checkout <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a>
<p :if="!usage.subscription()?.checkoutAvailable && usage.subscription()?.deploymentMode !== 'selfhost'" class="mt-4 capability-note">Hosted checkout is unavailable because the payment provider is not configured.</p>
<button :if="usage.subscription()?.portalAvailable" type="button" class="mt-4 button button-secondary" @click="usage.portal()" :disabled="workspace.pending()">Prepare billing portal</button><a :if="usage.portalUrl()" class="ml-4 console-link" :href="usage.portalUrl()" rel="noopener">Open secure billing portal <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a>
<p :if="usage.subscription()?.subscription?.status === 'pending' && !usage.subscription()?.pendingCheckout" class="mt-4 capability-note">A subscription checkout is awaiting reconciliation. Contact your workspace owner before opening another checkout.</p>
<p :if="usage.subscription()?.deploymentMode !== 'selfhost'" class="mt-4 field-help">Payment methods and cancellation are managed in Stripe. Plan changes, extra paid seats and automatic top up are not available here yet. Preparing checkout does not activate a plan.</p>
</div></section><section :if="usage.wallet()" class="mt-8"><h2 class="text-xl">Wallet activity</h2><div :if="usage.wallet()?.entries.length" class="table-scroll"><table class="console-table"><thead><tr><th scope="col">Recorded</th><th scope="col">Activity</th><th scope="col">Amount</th><th scope="col">Balance after</th></tr></thead><tbody><tr :for="entry in usage.wallet()?.entries"><td>{{ entry.created_at }}</td><td>{{ entry.kind }}</td><td>{{ usage.money(Number(entry.amount_cents)) }}</td><td>{{ usage.money(Number(entry.balance_cents)) }}</td></tr></tbody></table></div><p :if="usage.wallet()?.entries.length === 0" class="console-empty">No wallet transactions have been recorded.</p></section></section>
@endsection
