<script server>
const pageTitle = 'Ticket configuration'
const pageDescription = 'Define ticket forms, business calendars and SLA policies.'
</script>
<script client>
import { createTicketConfiguration } from '../../functions/support/ticket-configuration'
const config = createTicketConfiguration()
const workspace = config.workspace
const project = workspace.project
const name = config.name
const kind = config.kind
const policyId = config.policyId
const opensConversation = config.opensConversation
const fieldKey = config.fieldKey
const fieldLabel = config.fieldLabel
const fieldType = config.fieldType
const fieldVisibility = config.fieldVisibility
const fieldRequired = config.fieldRequired
const fieldOptions = config.fieldOptions
const defaultEnabled = config.defaultEnabled
const defaultValue = config.defaultValue
const stateKey = config.stateKey
const stateLabel = config.stateLabel
const stateCategory = config.stateCategory
const calendarName = config.calendarName
const timeZone = config.timeZone
const holidays = config.holidays
const start = config.start
const end = config.end
const policyName = config.policyName
const calendarId = config.calendarId
const firstMinutes = config.firstMinutes
const resolutionMinutes = config.resolutionMinutes
const pauseStates = config.pauseStates
const escalationAssignee = config.escalationAssignee
onMount(() => config.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><a href="/app/tickets" class="text-xs console-link">Tickets / Configuration</a><h1>Forms and response targets</h1><p>Give each request the right context and working hours. New definitions apply to future tickets; existing snapshots are preserved.</p></div><div class="project-picker"><label for="configuration-project">Project</label><select id="configuration-project" x-model="project" @change="config.load()" :disabled="workspace.pending() || workspace.loading()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading">Loading ticket configuration...</p>
<div class="console-toolbar" aria-label="Ticket configuration sections"><button type="button" class="button button-outline" :aria-pressed="config.tab() === 'types'" @click="config.tab.set('types')">Ticket types</button><button type="button" class="button button-outline" :aria-pressed="config.tab() === 'calendars'" @click="config.tab.set('calendars')">Business calendars</button><button type="button" class="button button-outline" :aria-pressed="config.tab() === 'policies'" @click="config.tab.set('policies')">SLA policies</button><button type="button" class="text-button" @click="config.load()" :disabled="workspace.pending() || workspace.loading()">Refresh definitions</button></div>
<p :if="!workspace.canManage() && workspace.ready()" class="capability-note">Owners and admins can create definitions. Your agent account can view the configuration.</p>
<section :if="config.tab() === 'types'" class="editor-grid"><aside class="resource-list" aria-label="Configured ticket types"><details :for="type in config.types()" class="p-4 border-[#e1e8e2] border-b"><summary class="cursor-pointer"><strong>{{ type.name }}</strong><span>{{ type.kind }} / {{ config.policyLabel(type.sla_policy_id) }}</span></summary><dl class="mt-4 field-help"><div :for="field in type.fields"><dt>{{ field.label }} / {{ field.key }}</dt><dd>{{ field.type }} / {{ field.visibility }} / {{ field.required ? 'Required' : 'Optional' }}{{ field.default !== undefined ? ' / Has default' : '' }}</dd></div></dl><p class="mt-4 field-help">States: {{ config.stateLabels(type) }}</p><button :if="workspace.canManage()" type="button" class="mt-4 text-button" @click="config.copyType(type)" :disabled="workspace.pending()">Use as template</button></details><p :if="config.types().length === 0" class="empty-list">No typed forms yet. Standard customer tickets remain available without an SLA.</p></aside>
<form :if="workspace.canManage()" class="editor-panel" @submit.prevent="config.createType()"><header class="editor-panel-heading"><h2>Create a ticket type</h2></header><fieldset class="border-0 editor-form" :disabled="workspace.pending()"><div class="field-grid"><div><label for="type-name">Type name</label><input id="type-name" x-model="name" required maxlength="100" placeholder="Product question"></div><div><label for="type-kind">Audience</label><select id="type-kind" x-model="kind"><option value="customer">Customer</option><option value="internal">Internal</option><option value="incident">Incident</option></select></div></div><label for="type-policy">SLA policy</label><select id="type-policy" x-model="policyId"><option value="">No SLA policy</option><option :for="policy in config.policies()" :value="String(policy.id)">{{ policy.name }}</option></select><p class="field-help">Only customer types and customer-visible fields are available to the embedded customer form.</p>
<div :if="kind() === 'customer'">
  <label class="flex gap-3 items-center"><input id="type-opens-conversation" x-model="opensConversation" type="checkbox" class="w-auto" aria-describedby="type-conversation-help">Open a conversation in the default inbox</label>
  <p id="type-conversation-help" class="field-help">Each standalone submission uses one conversation from your plan. Agents can reply to the customer from the inbox.</p>
</div>
<div class="flex gap-4 items-center justify-between mt-6"><h3 class="font-semibold text-sm">Custom fields</h3><button type="button" class="text-button" @click="config.editField()">Add field</button></div><div :for="(field,index) in config.fields()" class="flex gap-3 items-center justify-between py-3 border-[#e1e8e2] border-b"><div><strong class="text-sm">{{ field.label }}</strong><p class="field-help">{{ field.key }} / {{ field.type }} / {{ field.visibility }} / {{ field.required ? 'Required' : 'Optional' }}</p></div><div class="flex gap-3"><button type="button" class="text-button" @click="config.editField(index)">Edit draft field</button><button type="button" class="text-button" @click="config.removeField(index)">Remove draft field</button></div></div>
<section :if="config.editingField()" class="mt-4 p-4 border border-[#d5e3d9] rounded-xl"><h3 class="font-semibold text-sm">Field definition</h3><div class="field-grid"><div><label for="field-key">Field key</label><input id="field-key" x-model="fieldKey" maxlength="50" placeholder="order_number"></div><div><label for="field-label">Field label</label><input id="field-label" x-model="fieldLabel" maxlength="100" placeholder="Order number"></div><div><label for="field-type">Value type</label><select id="field-type" x-model="fieldType"><option value="string">Text</option><option value="email">Email</option><option value="number">Number</option><option value="integer">Whole number</option><option value="boolean">Yes or no</option><option value="date">Date</option><option value="enum">Choice</option></select></div><div><label for="field-visibility">Field visibility</label><select id="field-visibility" x-model="fieldVisibility"><option value="customer">Customer</option><option value="internal">Internal</option></select></div></div><label class="flex gap-3 items-center"><input x-model="fieldRequired" type="checkbox" class="w-auto">Required answer</label><div :if="fieldType() === 'enum'"><label for="field-options">Choice options, one per line</label><textarea id="field-options" x-model="fieldOptions" rows="4"></textarea></div><label class="flex gap-3 items-center"><input x-model="defaultEnabled" type="checkbox" class="w-auto">Supply a typed default</label><div :if="defaultEnabled()"><label for="field-default">Default value</label><select :if="fieldType() === 'boolean'" id="field-default" x-model="defaultValue"><option value="">Select a default</option><option value="true">Yes</option><option value="false">No</option></select><input :if="fieldType() !== 'boolean'" id="field-default" x-model="defaultValue" :type="['integer','number'].includes(fieldType()) ? 'number' : ['date','email'].includes(fieldType()) ? fieldType() : 'text'" :step="fieldType() === 'integer' ? '1' : 'any'"></div><p class="mt-4 field-help">A required internal field on a customer type needs a default. Up to 40 fields; text values support 4,000 characters.</p><div class="flex gap-3 mt-4"><button type="button" class="button button-outline" @click="config.applyField()">Apply field</button><button type="button" class="text-button" @click="config.editingField.set(false)">Cancel field changes</button></div></section>
<div class="flex gap-4 items-center justify-between mt-6"><h3 class="font-semibold text-sm">Additional states</h3><button type="button" class="text-button" @click="config.editState()">Add state</button></div><p class="field-help">Open, Pending and Resolved are built in. Additional states map to one of those categories.</p><div :for="(item,index) in config.states()" class="flex gap-3 items-center justify-between py-3 border-[#e1e8e2] border-b"><span class="text-sm">{{ item.label }} / {{ item.key }} / {{ item.category }}</span><div class="flex gap-3"><button type="button" class="text-button" @click="config.editState(index)">Edit draft state</button><button type="button" class="text-button" @click="config.removeState(index)">Remove draft state</button></div></div><section :if="config.editingState()" class="mt-4 p-4 border border-[#d5e3d9] rounded-xl"><div class="field-grid"><div><label for="state-key">State key</label><input id="state-key" x-model="stateKey" maxlength="50" placeholder="waiting_customer"></div><div><label for="state-label">State label</label><input id="state-label" x-model="stateLabel" maxlength="100" placeholder="Waiting on customer"></div></div><label for="state-category">Status category</label><select id="state-category" x-model="stateCategory"><option value="open">Open</option><option value="pending">Pending</option><option value="resolved">Resolved</option></select><div class="flex gap-3 mt-4"><button type="button" class="button button-outline" @click="config.applyState()">Apply state</button><button type="button" class="text-button" @click="config.editingState.set(false)">Cancel state changes</button></div></section><p :if="config.editingField() || config.editingState()" class="mt-4 field-help">Apply or cancel the current field and state drafts before creating the type.</p><button type="submit" class="mt-6 button button-teal" :disabled="config.editingField() || config.editingState()">{{ workspace.pending() ? 'Creating...' : 'Create ticket type' }}</button></fieldset></form></section>
<section :if="config.tab() === 'calendars'" class="editor-grid"><aside class="resource-list" aria-label="Configured business calendars"><details :for="calendar in config.calendars()" class="p-4 border-[#e1e8e2] border-b"><summary class="cursor-pointer"><strong>{{ calendar.name }}</strong><span>{{ calendar.time_zone }}</span></summary><p :for="window in calendar.definition.windows" class="mt-3 field-help">{{ config.windowLabel(window) }}</p><p class="mt-3 field-help">{{ calendar.definition.holidays.length }} local holiday dates</p><button :if="workspace.canManage()" type="button" class="mt-4 text-button" @click="config.copyCalendar(calendar)" :disabled="workspace.pending()">Use as template</button></details><p :if="config.calendars().length === 0" class="empty-list">No business calendars configured. A policy without a calendar is always open.</p></aside><form :if="workspace.canManage()" class="editor-panel" @submit.prevent="config.createCalendar()"><header class="editor-panel-heading"><h2>Create a business calendar</h2></header><fieldset class="border-0 editor-form" :disabled="workspace.pending()"><label for="calendar-name">Calendar name</label><input id="calendar-name" x-model="calendarName" required maxlength="100" placeholder="US support hours"><label for="calendar-zone">IANA time zone</label><input id="calendar-zone" x-model="timeZone" required placeholder="America/New_York"><p class="field-help">Working windows and holidays use this local time zone, including daylight saving transitions.</p><h3 class="mt-6 font-semibold text-sm">Weekly hours</h3><div :for="(window,index) in config.windows()" class="flex gap-3 items-center justify-between py-3 border-[#e1e8e2] border-b"><span class="text-sm">{{ config.windowLabel(window) }}</span><button type="button" class="text-button" @click="config.removeWindow(index)">Remove draft window</button></div><button type="button" class="mt-4 text-button" @click="config.editingWindow.set(true)">Add working window</button><section :if="config.editingWindow()" class="mt-4 p-4 border border-[#d5e3d9] rounded-xl"><div class="flex flex-wrap gap-2" aria-label="Working weekdays"><button :for="day in config.days" type="button" class="button button-outline" :aria-pressed="config.weekdays().includes(day.key)" @click="config.toggleDay(day.key)">{{ day.name }}</button></div><div class="field-grid"><div><label for="window-start">Starts (HH:mm)</label><input id="window-start" x-model="start" type="time"></div><div><label for="window-end">Ends (HH:mm)</label><input id="window-end" x-model="end" placeholder="17:00" maxlength="5"></div></div><p class="mt-3 field-help">24:00 is allowed only as an end. Split overnight windows at midnight.</p><div class="flex gap-3 mt-4"><button type="button" class="button button-outline" @click="config.applyWindow()">Apply working window</button><button type="button" class="text-button" @click="config.editingWindow.set(false)">Cancel window</button></div></section><label for="calendar-holidays">Local holiday dates, one YYYY-MM-DD per line</label><textarea id="calendar-holidays" x-model="holidays" rows="5" placeholder="2026-12-25"></textarea><button type="submit" class="mt-6 button button-teal" :disabled="config.editingWindow()">{{ workspace.pending() ? 'Creating...' : 'Create business calendar' }}</button></fieldset></form></section>
<section :if="config.tab() === 'policies'" class="editor-grid"><aside class="resource-list" aria-label="Configured SLA policies"><details :for="policy in config.policies()" class="p-4 border-[#e1e8e2] border-b"><summary class="cursor-pointer"><strong>{{ policy.name }}</strong><span>{{ config.calendarLabel(policy.calendar_id) }}</span></summary><p class="mt-3 field-help">First response: {{ policy.first_response_minutes || 'Disabled' }} minutes / Resolution: {{ policy.resolution_minutes || 'Disabled' }} minutes</p><p class="mt-3 field-help">Pause states: {{ policy.pause_states.join(', ') || 'None' }}</p><button :if="workspace.canManage()" type="button" class="mt-4 text-button" @click="config.copyPolicy(policy)" :disabled="workspace.pending()">Use as template</button></details><p :if="config.policies().length === 0" class="empty-list">No SLA policies yet. Create one, then attach it to a new ticket type.</p></aside><form :if="workspace.canManage()" class="editor-panel" @submit.prevent="config.createPolicy()"><header class="editor-panel-heading"><h2>Create an SLA policy</h2></header><fieldset class="border-0 editor-form" :disabled="workspace.pending()"><label for="policy-name">Policy name</label><input id="policy-name" x-model="policyName" required maxlength="100" placeholder="Standard support"><label for="policy-calendar">Working calendar</label><select id="policy-calendar" x-model="calendarId"><option value="">Always open</option><option :for="calendar in config.calendars()" :value="String(calendar.id)">{{ calendar.name }} / {{ calendar.time_zone }}</option></select><div class="field-grid"><div><label for="first-response-minutes">First response target (working minutes)</label><input id="first-response-minutes" x-model="firstMinutes" type="number" min="0" max="525600" step="1" required></div><div><label for="resolution-minutes">Resolution target (working minutes)</label><input id="resolution-minutes" x-model="resolutionMinutes" type="number" min="0" max="525600" step="1" required></div></div><p class="field-help">Zero disables a metric. At least one target must be positive.</p><label for="policy-pauses">Pause state keys, comma separated</label><input id="policy-pauses" x-model="pauseStates" placeholder="pending, waiting_customer"><p class="field-help">Every pause key must exist on a type using this policy. Open and resolved cannot pause a clock.</p><label for="policy-escalation">Internal escalation assignee</label><select id="policy-escalation" x-model="escalationAssignee"><option value="">Keep current assignee</option><option :for="agent in config.agents()" :value="agent.id">{{ agent.name }} / {{ agent.role }}</option></select><p class="mt-4 field-help">A breach creates a durable internal event and may assign this active agent. It does not confirm delivery of an email, SMS or other external notification.</p><button type="submit" class="mt-6 button button-teal">{{ workspace.pending() ? 'Creating...' : 'Create SLA policy' }}</button></fieldset></form></section>
<p class="console-help-footer">Definitions are append-only. Use an existing item as a template to create a new definition. Editing or deleting saved definitions, migrating existing tickets and priority-based policy selection are not available.</p>
@endsection
