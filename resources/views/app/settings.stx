<script server>
const pageTitle = 'Workspace settings'
const pageDescription = 'Configure your HQ.support messenger and server integration.'
</script>
<script client>
import { createSupportSettings } from '../../functions/support/settings'
const settings = createSupportSettings()
const project = settings.project
const origins = settings.origins
const anonymous = settings.anonymous
const savedReplyEditor = settings.savedReplyEditor
const savedReplyName = savedReplyEditor.name
const savedReplyBody = savedReplyEditor.body
const savedReplySearch = savedReplyEditor.list.search
onMount(() => settings.load())
onDestroy(() => settings.destroy())
async function signOut() {
  try { await settings.signOut(); navigate('/login') }
  catch (error) { settings.error.set(error instanceof Error ? error.message : 'Sign out could not be completed.') }
}
</script>
@extends('default')
@section('content')
<div class="mx-auto px-6 max-w-7xl settings-layout"><header class="page-heading"><a class="text-xs muted" href="/app">Inbox / Settings</a><h1 class="mt-6">Make it your own.</h1><p>Connect your app, choose which origins can load the messenger, and keep your server credentials private.</p></header><div class="grid gap-12 grid-cols-1 lg:grid-cols-2 settings-grid"><section><h2 class="text-2xl">Customer messenger</h2><p class="settings-help">Workspace owners and admins can change project settings. Use one exact HTTPS origin per line. Localhost is allowed for development.</p><p :if="settings.error()" role="alert" class="auth-error">{{ settings.error() }}</p><p :if="settings.signingOut()" role="status" class="availability">Credentials are cleared from this page. If sign out fails, try Sign out again or reload before managing keys.</p><p :if="settings.notice()" role="status" class="availability">{{ settings.notice() }}</p><form class="settings-form" @submit.prevent="settings.save()"><label for="settings-project">Project</label><select id="settings-project" x-model="project" @change="settings.select()" :disabled="settings.pending()"><option value="">Select a project</option><option :for="item in settings.projects()" :value="item.public_id">{{ item.name }}</option></select><label for="public-id">Public project ID</label><input id="public-id" :value="project()" readonly aria-describedby="public-id-help"><p id="public-id-help" class="settings-help">This ID is safe to include in your browser bundle.</p><label for="origins">Allowed origins</label><textarea id="origins" x-model="origins" rows="4" placeholder="https://your-app.com" :disabled="settings.pending()"></textarea><label class="settings-checkbox"><input type="checkbox" x-model="anonymous" :disabled="settings.pending()">Allow anonymous customer sessions</label><p class="settings-help">When disabled, your server must issue a trusted customer session before the messenger can connect.</p><button class="button button-teal" type="submit" :disabled="settings.pending() || !project()">Save messenger settings</button></form>
<section id="saved-replies-settings" :if="settings.canAdmin()" class="mt-10 pt-7 border-[#dce5dd] border-t" aria-labelledby="saved-replies-heading">
  <h2 id="saved-replies-heading" class="text-2xl">Saved replies</h2>
  <p class="settings-help">Share reusable reply text with agents on this project.</p>
  <form class="settings-form" @submit.prevent="savedReplyEditor.list.load()">
    <label for="settings-saved-reply-search">Find a saved reply</label>
    <input id="settings-saved-reply-search" type="search" dir="auto" maxlength="120" x-model="savedReplySearch">
    <button type="submit" class="button button-outline">Search</button>
  </form>
  <p :if="savedReplyEditor.list.error()" class="auth-error" role="alert">{{ savedReplyEditor.list.error() }}</p>
  <p class="settings-help" role="status">{{ savedReplyEditor.list.loading() ? 'Loading saved replies…' : savedReplyEditor.list.items().length || savedReplyEditor.list.error() ? '' : 'No saved replies found.' }}</p>
  <ul class="overflow-y-auto max-h-72">
    <li :for="reply in savedReplyEditor.list.items()" :key="reply.id" class="py-3 border-[#dce5dd] border-b">
      <p class="font-medium" dir="auto">{{ reply.name }}</p>
      <p class="line-clamp-2 settings-help" dir="auto">{{ reply.body }}</p>
      <div class="flex flex-wrap gap-3">
        <button type="button" class="text-button" :aria-label="'Edit ' + reply.name" :disabled="savedReplyEditor.busy()" @click="savedReplyEditor.edit(reply.id)">Edit</button>
        <button type="button" class="text-button" :aria-label="'Archive ' + reply.name" :disabled="savedReplyEditor.busy()" @click="savedReplyEditor.submit(reply.id)">Archive</button>
      </div>
    </li>
  </ul>
  <button :if="savedReplyEditor.list.cursor()" type="button" class="mt-3 text-button" :disabled="savedReplyEditor.list.loading()" @click="savedReplyEditor.list.load(true)">Load more saved replies</button>
  <form class="settings-form" @submit.prevent="savedReplyEditor.submit()">
    <h3 class="font-medium text-lg">{{ savedReplyEditor.editing() ? 'Edit saved reply' : 'Create saved reply' }}</h3>
    <label for="settings-saved-reply-name">Name</label>
    <input id="settings-saved-reply-name" type="text" dir="auto" maxlength="120" required x-model="savedReplyName" :disabled="savedReplyEditor.busy()">
    <label for="settings-saved-reply-body">Reply text</label>
    <textarea id="settings-saved-reply-body" dir="auto" rows="4" maxlength="10000" required x-model="savedReplyBody" :disabled="savedReplyEditor.busy()"></textarea>
    <div class="flex flex-wrap gap-3">
      <button type="submit" class="button button-teal" :disabled="savedReplyEditor.busy()">Save reply</button>
      <button :if="savedReplyEditor.editing()" type="button" class="button button-outline" :disabled="savedReplyEditor.busy()" @click="savedReplyEditor.clearDraft()">Cancel edit</button>
    </div>
    <p :if="savedReplyEditor.error()" class="auth-error" role="alert">{{ savedReplyEditor.error() }}</p>
    <p class="settings-help" role="status">{{ savedReplyEditor.notice() }}</p>
  </form>
</section>
<section :if="settings.canAdmin()" class="mt-10 pt-7 border-[#dce5dd] border-t" aria-labelledby="migration-heading">
  <h2 id="migration-heading" class="text-2xl">Preview an Intercom migration</h2>
  <p id="migration-help" class="settings-help">Choose a JSON bundle up to 10 MB for the selected project. A preview checks the source records without importing them.</p>
  <form class="settings-form" @submit.prevent="settings.previewMigration()">
    <label for="migration-file">Intercom bundle</label>
    <input id="migration-file" type="file" accept=".json,application/json" aria-describedby="migration-help" @change="settings.chooseMigrationFile($event)">
    <button class="button button-outline" type="submit" :disabled="!settings.migrationFile() || settings.migrationBusy()">Preview bundle</button>
  </form>
  <p :if="settings.migrationError()" class="auth-error" role="alert">{{ settings.migrationError() }}</p>
  <p class="settings-help" role="status">{{ settings.migrationBusy() ? 'Checking bundle…' : settings.migrationPreview() ? 'Preview complete.' : '' }}</p>
  <div :if="settings.migrationPreview()" id="migration-result" class="mt-5">
    <p class="mb-3 text-sm">{{ settings.migrationPreview()?.totalRecords }} supplied records</p>
    <dl class="grid gap-3 grid-cols-3 text-sm">
      <div><dt>Compatible</dt><dd>{{ settings.migrationPreview()?.compatibleRecords }}</dd></div>
      <div><dt>Skipped</dt><dd>{{ settings.migrationPreview()?.skippedRecords }}</dd></div>
      <div><dt>Needs review</dt><dd>{{ settings.migrationPreview()?.reviewRecords }}</dd></div>
    </dl>
    <label :if="settings.migrationPreview()?.reviewRecords" class="mt-4 settings-checkbox">
      <input id="migration-review-only" type="checkbox" :checked="settings.migrationReviewOnly()" @change="settings.filterMigrationRecords($event.target.checked)"> Show only records that need review
    </label>
    <nav :if="settings.migrationPageCount() > 1" class="flex flex-wrap gap-3 items-center mt-4" aria-label="Source record pages">
      <button type="button" class="button button-outline" :disabled="settings.migrationPage() === 0" @click="settings.moveMigrationPage(-1)">Previous</button>
      <label for="migration-page-number" class="text-sm">Page</label>
      <input id="migration-page-number" class="px-2 py-1 w-16 text-sm border rounded" type="number" min="1" step="1" :max="settings.migrationPageCount()" :value="settings.migrationPage() + 1" aria-describedby="migration-page-total" @change="settings.jumpToMigrationPage($event)">
      <span id="migration-page-total" class="text-sm">of {{ settings.migrationPageCount() }}</span>
      <button type="button" class="button button-outline" :disabled="settings.migrationPage() + 1 >= settings.migrationPageCount()" @click="settings.moveMigrationPage(1)">Next</button>
    </nav>
    <ol class="mt-3" aria-label="Source records">
      <li :for="record in settings.migrationRecords()" :key="record.position" class="grid gap-1 py-3 text-sm border-[#dce5dd] border-b">
        <span class="font-medium">Position {{ record.position }} · {{ record.entityType }} · {{ settings.migrationStatusLabel(record.status) }}</span>
        <code class="break-all" dir="auto">{{ record.sourceId ?? 'ID unavailable' }}</code>
        <code :if="record.errorCode" class="break-all text-xs" dir="ltr">{{ record.errorCode }}</code>
      </li>
    </ol>
  </div>
</section>
</section><section class="settings-integration"><h2 class="text-2xl">Your server connection</h2><p class="settings-help">Generate a write key for your server and a read key for summaries. Existing keys remain active until explicitly revoked or rotated. Store both in your deployment's secret manager.</p><button type="button" class="button button-outline" @click="settings.issueKeys()" :disabled="settings.pending() || !project() || !settings.canAdmin() || settings.keyRetry()">Generate a new key pair</button><p :if="project() && !settings.canAdmin()" class="settings-help">Only workspace owners and admins can manage project keys.</p><div :if="settings.keyRetry()" class="secret-result"><p>The last key operation may have committed. Retry uses the same operation ID and never replays a secret.</p><button type="button" class="button button-outline" @click="settings.retryKeys()" :disabled="settings.pending()">Retry key operation</button><button type="button" class="auth-back" @click="settings.discardRetry()" :disabled="settings.pending()">Discard retry context</button></div><div :if="settings.keys().secret" class="secret-result"><label for="rotated-key">Replacement {{ settings.keys().scope }} key</label><textarea id="rotated-key" readonly rows="3" :value="settings.keys().secret"></textarea><p>Shown once. Save this replacement in your server secret manager before leaving.</p><button type="button" class="auth-back" @click="settings.keys.set({})">Hide key</button></div><div :if="settings.keys().ingestKey" class="secret-result"><label for="write-key">SUPPORTHQ_KEY</label><textarea id="write-key" readonly rows="3" :value="settings.keys().ingestKey"></textarea><label for="read-key">SUPPORTHQ_READ_KEY</label><textarea id="read-key" readonly rows="3" :value="settings.keys().readKey"></textarea><p>These keys grant server access. Keep them out of your public HTML, source control, and client code.</p><button type="button" class="auth-back" @click="settings.keys.set({})">Hide keys</button></div><section :if="settings.canAdmin()" class="settings-workspaces" aria-label="Project API keys"><h3>Project API keys</h3><p class="settings-help">Rotation immediately revokes the selected key and shows one replacement of the same scope. If that response is lost, retry to find its replacement ID, then explicitly rotate that replacement for a fresh secret. Customer sessions already issued require separate revocation.</p><button type="button" class="auth-back" @click="settings.loadKeys()" :disabled="settings.pending()">Refresh key list</button><p :if="!settings.keyList().length" class="settings-help">No keys to display.</p><article :for="key in settings.keyList()"><div><strong>Key #{{ key.id }} · {{ key.scope }} · {{ key.status }}</strong><p class="settings-help">Created {{ key.createdAt }}</p></div><div :if="key.status === 'active'"><button type="button" class="auth-back" @click="settings.rotateKey(key.id)" :disabled="settings.pending() || settings.keyRetry()" :aria-label="'Rotate key ' + key.id">Rotate</button><button type="button" class="auth-back" @click="settings.revokeKey(key.id)" :disabled="settings.pending() || settings.keyRetry()" :aria-label="'Revoke key ' + key.id">Revoke now</button></div></article><button :if="settings.keyCursor()" type="button" class="auth-back" @click="settings.loadKeys(true)" :disabled="settings.pending()">Load older keys</button></section><div class="settings-workspaces"><h3>Your workspaces</h3><article :for="workspace in settings.workspaces()"><strong>{{ workspace.name }}</strong><span>{{ workspace.role }} / {{ workspace.plan }}</span></article></div><a class="button button-outline" href="/help/messenger">Read the integration guide</a><button class="auth-back" type="button" @click="signOut()">Sign out of your account</button></section></div></div>
@endsection
