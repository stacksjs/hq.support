<script server>
const pageTitle = 'Knowledge'
const pageDescription = 'Manage your HQ.support help articles and revision history.'
</script>
<script client>
import { createKnowledge } from '../../functions/support/knowledge'
const params = useSearchParams()
const knowledge = createKnowledge()
const workspace = knowledge.workspace
const project = workspace.project
const query = knowledge.query
const title = knowledge.title
const slug = knowledge.slug
const body = knowledge.body
const status = knowledge.status
const visibility = knowledge.visibility
const locale = knowledge.locale
const collection = knowledge.collection
const importMode = knowledge.importMode
onMount(() => knowledge.boot({ project: params.get('project') || undefined, article: params.get('article') || undefined }))
onDestroy(() => knowledge.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Knowledge</h1><p>Write a useful answer once. Keep public help and internal context separate, with a revision for every save.</p></div><div class="project-picker"><label for="knowledge-project">Project</label><select id="knowledge-project" x-model="project" @change="knowledge.changeProject()" :disabled="workspace.loading() || workspace.pending() || knowledge.dirty()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p>
<section class="mb-8 wallet-panel" aria-label="Live AI capabilities"><div class="flex flex-wrap gap-4 items-start justify-between"><div><h2>AI and retrieval</h2><p class="field-help">Workspace budgets are separate. Usage includes pending reservations and resets monthly in UTC.</p></div><button type="button" class="text-button" @click="knowledge.refreshCapabilities()" :disabled="!project() || knowledge.capabilityLoading()">{{ knowledge.capabilityLoading() ? 'Refreshing...' : 'Refresh AI capabilities' }}</button></div><p :if="knowledge.capabilityError()" class="console-error" role="alert">{{ knowledge.capabilityError() }}</p><div :if="knowledge.capabilities()"><div class="mt-5 resource-overview"><span class="status-label">{{ knowledge.retrievalLabel() }}</span><span>{{ knowledge.capabilities()?.provider.configured ? 'AI provider configured' : 'AI provider unavailable' }}{{ knowledge.capabilities()?.provider.provider ? ' / ' + knowledge.capabilities()?.provider.provider : '' }}</span><span>{{ knowledge.capabilities()?.retrieval.persistent ? 'Persisted source index' : 'Index persistence unavailable' }}</span></div><div class="metric-grid"><article class="metric-cell"><h3 class="font-semibold text-sm">Customer AI conversations</h3><strong>{{ knowledge.count(knowledge.capabilities()?.customerAi.remaining) }}</strong><p>remaining / {{ knowledge.count(knowledge.capabilities()?.customerAi.limit) }} included</p><p>{{ knowledge.count(knowledge.capabilities()?.customerAi.used) }} used in {{ knowledge.capabilities()?.customerAi.period }}</p></article><article class="metric-cell"><h3 class="font-semibold text-sm">Agent copilot</h3><strong>{{ knowledge.count(knowledge.capabilities()?.copilot.remaining.requests) }}</strong><p>requests remaining / {{ knowledge.count(knowledge.capabilities()?.copilot.limits.requests) }}</p><p>{{ knowledge.count(knowledge.capabilities()?.copilot.remaining.tokens) }} tokens remaining / {{ knowledge.count(knowledge.capabilities()?.copilot.limits.tokens) }}</p></article><article class="metric-cell"><h3 class="font-semibold text-sm">Embedding tokens</h3><strong>{{ knowledge.count(knowledge.capabilities()?.indexing.remaining) }}</strong><p>remaining / {{ knowledge.count(knowledge.capabilities()?.indexing.limit) }}</p><p>{{ knowledge.count(knowledge.capabilities()?.indexing.used) }} used or reserved</p></article></div><p class="mt-4 field-help">{{ knowledge.count(knowledge.capabilities()?.retrieval.totalSources) }} authorized published sources / {{ knowledge.count(knowledge.capabilities()?.retrieval.vectorSources) }} with vectors / {{ knowledge.count(knowledge.capabilities()?.retrieval.pendingVectorSources) }} awaiting vectors. Vector readiness: {{ knowledge.capabilities()?.retrieval.vectorReady ? 'Available' : 'Unavailable' }}. Mode is reported by the server; provider configuration and budget still govern each AI request.</p><p class="mt-3 field-help">Copilot is independent of the customer AI allowance. Each copilot request allows up to {{ knowledge.count(knowledge.capabilities()?.copilot.maxRequestTokens) }} tokens; each customer AI conversation allows up to {{ knowledge.count(knowledge.capabilities()?.customerAi.maxTurns) }} turns and {{ knowledge.count(knowledge.capabilities()?.customerAi.maxTokens) }} tokens.</p></div></section>
<form class="console-toolbar" @submit.prevent="knowledge.load()"><input type="search" x-model="query" placeholder="Search article titles and content" aria-label="Search knowledge"><button type="submit" class="button button-outline" :disabled="workspace.loading() || knowledge.dirty()">Search articles</button><button :if="workspace.canManage()" type="button" class="button button-teal" @click="knowledge.select(null)" :disabled="!project() || knowledge.dirty() || workspace.pending()">New article</button></form>
<p :if="workspace.loading()" class="console-loading" role="status">Loading knowledge...</p><p :if="knowledge.dirty()" class="console-notice">You have unsaved changes. Save or discard them before switching articles or projects.</p>
<div class="editor-grid"><section class="resource-list" aria-label="Knowledge articles"><button :for="item in knowledge.articles()" type="button" :class="knowledge.selected()?.id === item.id ? 'chosen' : ''" @click="knowledge.select(item)" :disabled="knowledge.dirty() || workspace.pending()"><strong>{{ item.title }}</strong><span>{{ item.collection }} / {{ item.locale }}<br>{{ item.status }} / {{ item.visibility }}</span></button><p :if="!workspace.loading() && knowledge.articles().length === 0" class="empty-list">No matching articles. Create an article or try another search.</p></section>
<section class="editor-panel"><header class="editor-panel-heading"><h2>{{ knowledge.editorOpen() ? knowledge.selected() ? 'Edit article' : 'New article' : 'Your team knowledge' }}</h2><span :if="knowledge.selected()">Revision {{ knowledge.selected()?.revision }}</span></header><div :if="!knowledge.editorOpen()" class="editor-form"><p class="field-help">Select an article to read or edit its content. Owners and admins can save and publish changes.</p></div><form :if="knowledge.editorOpen()" class="editor-form" @submit.prevent="knowledge.save()"><label for="article-title">Title</label><input id="article-title" x-model.trim="title" required maxlength="200" :disabled="workspace.pending() || !workspace.canManage()"><div class="field-grid"><div><label for="article-slug">URL slug</label><input id="article-slug" x-model.trim="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="connect-your-app" :disabled="workspace.pending() || !workspace.canManage()"></div><div><label for="article-locale">Locale</label><input id="article-locale" x-model.trim="locale" required placeholder="en" maxlength="35" :disabled="workspace.pending() || !workspace.canManage()"></div></div><label for="article-collection">Collection</label><input id="article-collection" x-model.trim="collection" required maxlength="120" :disabled="workspace.pending() || !workspace.canManage()"><div class="field-grid"><div><label for="article-status">Status</label><select id="article-status" x-model="status" :disabled="workspace.pending() || !workspace.canManage()"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select></div><div><label for="article-visibility">Audience</label><select id="article-visibility" x-model="visibility" :disabled="workspace.pending() || !workspace.canManage()"><option value="public">Public help</option><option value="internal">Internal team only</option></select></div></div><label for="article-format">Source format</label><select id="article-format" x-model="importMode" :disabled="workspace.pending() || !workspace.canManage()"><option value="text">Plain text</option><option value="markdown">Import Markdown</option><option value="html">Import HTML</option></select><p class="field-help">Imported markup becomes safe plain text. Public help only shows articles that are both published and public.</p><label for="article-body">Article content</label><textarea id="article-body" x-model="body" rows="14" required maxlength="100000" :disabled="workspace.pending() || !workspace.canManage()"></textarea><div class="editor-actions"><button :if="workspace.canManage()" type="submit" class="button button-teal" :disabled="workspace.pending() || !knowledge.dirty()">{{ workspace.pending() ? 'Saving...' : 'Save article' }}</button><button :if="knowledge.dirty()" type="button" class="text-button" @click="knowledge.discard()">Discard changes</button><a :if="knowledge.publicLink()" class="button button-outline" :href="knowledge.publicLink()">View public article</a></div></form><section :if="knowledge.selected()" class="revision-list"><h3>Source index</h3><p :if="knowledge.indexError()" class="console-error" role="alert">{{ knowledge.indexError() }}</p><div :if="knowledge.indexStatus()"><p :if="!knowledge.indexStatus()?.source" class="field-help">No persisted source index is recorded for this article.</p><div :if="knowledge.indexStatus()?.source" class="space-y-2 text-xs muted"><p>Revision {{ knowledge.indexStatus()?.source?.revision }} / {{ knowledge.indexStatus()?.source?.permissionGranted ? 'Permission granted' : 'Permission withheld' }}{{ knowledge.indexStatus()?.source?.deleted ? ' / Source removed' : '' }}</p><p>{{ knowledge.indexStatus()?.source?.indexing ? 'Indexing in progress' : knowledge.indexStatus()?.index ? 'Index: ' + knowledge.indexStatus()?.index?.status : 'No active index' }} / {{ knowledge.count(knowledge.indexStatus()?.index?.chunk_count) }} chunks / {{ knowledge.count(knowledge.indexStatus()?.index?.dimensions) }} vector dimensions</p><p :if="knowledge.indexStatus()?.source?.lastError" role="status">{{ knowledge.indexStatus()?.source?.lastError }}</p></div></div><p class="mt-3 field-help">Read-only index status. Article search below uses lexical matching; AI retrieval mode is reported separately above.</p></section><section :if="knowledge.revisions().length > 0" class="revision-list"><h3>Revision history</h3><article :for="revision in knowledge.revisions()"><span>Revision {{ revision.revision }} / {{ revision.snapshot.status }}</span><time>{{ revision.created_at }}</time></article></section></section>
</div><p class="console-help-footer">Article search uses persisted text with lexical matching. Drafts and internal articles are never included in the public help API.</p>
@endsection
