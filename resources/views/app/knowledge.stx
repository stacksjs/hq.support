<script server>
const pageTitle = 'Knowledge'
const pageDescription = 'Manage your HQ.support help articles and revision history.'
</script>
<script client>
import { createKnowledge } from '../../functions/support/knowledge'
const knowledge = createKnowledge()
const workspace = knowledge.workspace
const project = workspace.project
const query = knowledge.query
const title = knowledge.title
const slug = knowledge.slug
const body = knowledge.body
const status = knowledge.status
const visibility = knowledge.visibility
const locale = knowledge.locale
const collection = knowledge.collection
const importMode = knowledge.importMode
onMount(() => knowledge.boot())
onDestroy(() => workspace.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Knowledge</h1><p>Write a useful answer once. Keep public help and internal context separate, with a revision for every save.</p></div><div class="project-picker"><label for="knowledge-project">Project</label><select id="knowledge-project" x-model="project" @change="knowledge.changeProject()" :disabled="workspace.loading() || workspace.pending() || knowledge.dirty()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p>
<form class="console-toolbar" @submit.prevent="knowledge.load()"><input type="search" x-model="query" placeholder="Search article titles and content" aria-label="Search knowledge"><button type="submit" class="button button-outline" :disabled="workspace.loading() || knowledge.dirty()">Search articles</button><button :if="workspace.canManage()" type="button" class="button button-teal" @click="knowledge.select(null)" :disabled="!project() || knowledge.dirty() || workspace.pending()">New article</button></form>
<p :if="workspace.loading()" class="console-loading" role="status">Loading knowledge...</p><p :if="knowledge.dirty()" class="console-notice">You have unsaved changes. Save or discard them before switching articles or projects.</p>
<div class="editor-grid"><section class="resource-list" aria-label="Knowledge articles"><button :for="item in knowledge.articles()" type="button" :class="knowledge.selected()?.id === item.id ? 'chosen' : ''" @click="knowledge.select(item)" :disabled="knowledge.dirty() || workspace.pending()"><strong>{{ item.title }}</strong><span>{{ item.collection }} / {{ item.locale }}<br>{{ item.status }} / {{ item.visibility }}</span></button><p :if="!workspace.loading() && knowledge.articles().length === 0" class="empty-list">No matching articles. Create an article or try another search.</p></section>
<section class="editor-panel"><header class="editor-panel-heading"><h2>{{ knowledge.editorOpen() ? knowledge.selected() ? 'Edit article' : 'New article' : 'Your team knowledge' }}</h2><span :if="knowledge.selected()">Revision {{ knowledge.selected()?.revision }}</span></header><div :if="!knowledge.editorOpen()" class="editor-form"><p class="field-help">Select an article to read or edit its content. Owners and admins can save and publish changes.</p></div><form :if="knowledge.editorOpen()" class="editor-form" @submit.prevent="knowledge.save()"><label for="article-title">Title</label><input id="article-title" x-model.trim="title" required maxlength="200" :disabled="workspace.pending() || !workspace.canManage()"><div class="field-grid"><div><label for="article-slug">URL slug</label><input id="article-slug" x-model.trim="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="connect-your-app" :disabled="workspace.pending() || !workspace.canManage()"></div><div><label for="article-locale">Locale</label><input id="article-locale" x-model.trim="locale" required placeholder="en" maxlength="35" :disabled="workspace.pending() || !workspace.canManage()"></div></div><label for="article-collection">Collection</label><input id="article-collection" x-model.trim="collection" required maxlength="120" :disabled="workspace.pending() || !workspace.canManage()"><div class="field-grid"><div><label for="article-status">Status</label><select id="article-status" x-model="status" :disabled="workspace.pending() || !workspace.canManage()"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select></div><div><label for="article-visibility">Audience</label><select id="article-visibility" x-model="visibility" :disabled="workspace.pending() || !workspace.canManage()"><option value="public">Public help</option><option value="internal">Internal team only</option></select></div></div><label for="article-format">Source format</label><select id="article-format" x-model="importMode" :disabled="workspace.pending() || !workspace.canManage()"><option value="text">Plain text</option><option value="markdown">Import Markdown</option><option value="html">Import HTML</option></select><p class="field-help">Imported markup becomes safe plain text. Public help only shows articles that are both published and public.</p><label for="article-body">Article content</label><textarea id="article-body" x-model="body" rows="14" required maxlength="100000" :disabled="workspace.pending() || !workspace.canManage()"></textarea><div class="editor-actions"><button :if="workspace.canManage()" type="submit" class="button button-teal" :disabled="workspace.pending() || !knowledge.dirty()">{{ workspace.pending() ? 'Saving...' : 'Save article' }}</button><button :if="knowledge.dirty()" type="button" class="text-button" @click="knowledge.discard()">Discard changes</button><a :if="knowledge.publicLink()" class="button button-outline" :href="knowledge.publicLink()">View public article</a></div></form><section :if="knowledge.revisions().length > 0" class="revision-list"><h3>Revision history</h3><article :for="revision in knowledge.revisions()"><span>Revision {{ revision.revision }} / {{ revision.snapshot.status }}</span><time>{{ revision.created_at }}</time></article></section></section>
</div><p class="console-help-footer">Search uses persisted article text with lexical matching. Drafts and internal articles are never included in the public help API.</p>
@endsection
