<script server>
const pageTitle = 'Phone'
const pageDescription = 'Manage budgeted support calls and your browser phone.'
</script>
<script client>
import { createPhone } from '../../functions/support/phone'
const phone = createPhone()
const workspace = phone.workspace
const project = workspace.project
const channelId = phone.channelId
const destination = phone.destination
const duration = phone.duration
const filter = phone.filter
onMount(() => phone.boot())
onDestroy(() => phone.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Phone</h1><p>Keep the conversation together. Review calls, connect your browser phone, and manage bounded AI calls.</p></div><div class="project-picker"><label for="phone-project">Project</label><select id="phone-project" x-model="project" @change="phone.changeProject()" :disabled="workspace.pending() || workspace.loading() || phone.deviceActive()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="workspace.loading()" class="console-loading" role="status">Loading phone availability...</p>
<div class="console-toolbar"><label for="phone-channel">Voice channel</label><select id="phone-channel" x-model="channelId" @change="phone.changeChannel()" :disabled="workspace.pending() || workspace.loading() || phone.deviceActive()"><option value="">Select a channel</option><option :for="item in phone.capabilities()?.channels" :value="item.id">{{ item.label }} / {{ item.number || item.status }}</option></select><button type="button" class="button button-outline" @click="phone.refresh()" :disabled="workspace.pending() || workspace.loading()">Refresh calls</button></div>
<p :if="phone.capabilities()?.channels.length === 0" class="console-empty">No Twilio voice channel is connected to this project. A workspace owner must connect and verify an owned US or Canadian number before calling.</p>
<div class="wallet-grid"><section class="wallet-panel"><div class="flex gap-4 items-center justify-between"><h2>Browser phone</h2><span class="status-label">{{ phone.browser().status }}</span></div><p class="field-help">Receive calls assigned to you through the official Twilio browser client. Your microphone is used when you accept a call.</p><p :if="phone.browser().message" class="mt-4 console-error" role="alert">{{ phone.browser().message }}</p><p :if="phone.browser().status === 'error'" class="mt-4 field-help">{{ phone.deviceActive() ? 'Review your microphone permission and connection, then disable and enable this browser phone.' : 'Review your microphone permission and connection, then enable this browser phone again.' }} The provider call status is shown below.</p><div class="flex flex-wrap gap-3 mt-5"><button :if="!phone.deviceActive()" type="button" class="button button-teal" @click="phone.enable()" :disabled="!phone.canEnable()">Enable browser phone</button><button :if="phone.deviceActive()" type="button" class="button button-outline" @click="phone.disable()">Disable browser phone</button><button :if="phone.browser().status === 'incoming'" type="button" class="button button-teal" @click="phone.accept()">Accept incoming call</button><button :if="phone.browser().status === 'incoming'" type="button" class="button button-outline" @click="phone.reject()">Decline call</button><button :if="phone.browser().status === 'connected'" type="button" class="button button-outline" @click="phone.mute()">{{ phone.browser().muted ? 'Unmute microphone' : 'Mute microphone' }}</button><button :if="phone.browser().status === 'connected'" type="button" class="button button-outline" @click="phone.hangUp()">Hang up browser call</button></div><p :if="!phone.channel()?.browserAvailable && phone.channel()" class="mt-4 field-help">The selected channel is not ready for browser calls. Its provider identity and browser key must be configured and verified.</p></section>
<section class="wallet-panel"><h2>Place an AI call</h2><p class="field-help">US and Canada only. The assistant announces AI use and asks for consent before starting. Prepaid credit is reserved before dialing.</p><form class="mt-5" @submit.prevent="phone.dial()"><label for="phone-destination">Destination (E.164)</label><input id="phone-destination" x-model="destination" type="tel" autocomplete="off" placeholder="+12025550123" required pattern="[+]1[0-9]{10}" :disabled="!phone.canDial() || workspace.loading()"><label for="phone-duration">Maximum conversation length (seconds)</label><input id="phone-duration" x-model="duration" type="number" min="30" :max="phone.channel()?.maxDurationSeconds || 30" step="1" required :disabled="!phone.canDial() || workspace.loading()"><p class="mt-4 field-help">Channel limit: {{ phone.channel()?.maxDurationSeconds || 0 }} seconds. The provider may use a short connection allowance in addition to this bound.</p><button type="submit" class="mt-4 button button-teal" :disabled="!phone.canDial() || workspace.loading()">{{ workspace.pending() ? 'Submitting...' : phone.dialAcknowledged() ? 'Call request recorded' : 'Place AI call' }}</button></form><button :if="phone.dialAcknowledged()" type="button" class="mt-4 button button-outline" @click="phone.newCall()" :disabled="workspace.pending()">Start another call</button><p :if="!phone.channel()?.aiAvailable || !phone.capabilities()?.features.outboundAi" class="mt-4 capability-note">{{ phone.reasonText(phone.channel()?.reason) }}</p></section></div>
<div class="mt-8 console-toolbar"><h2 class="text-xl">Recent calls</h2><select x-model="filter" aria-label="Filter calls"><option value="all">All calls</option><option value="active">Active calls</option><option value="ended">Ended calls</option></select><span class="field-help">Refreshes every five seconds while this page is open.</span></div>
<div class="editor-grid"><section class="resource-list" aria-label="Call history"><button :for="call in phone.filtered()" type="button" :class="phone.selectedId() === call.id ? 'chosen' : ''" @click="phone.selectedId.set(call.id)" :disabled="workspace.pending()"><strong>{{ call.direction === 'inbound' ? call.from : call.to }}</strong><span>{{ call.direction }} / {{ call.mode }} / {{ call.status }}</span></button><p :if="phone.filtered().length === 0" class="empty-list">No calls match this view. Actual call records appear here after a request is recorded.</p></section><section class="editor-panel"><header class="editor-panel-heading"><h2>Call details</h2><span :if="phone.selected()" class="status-label">{{ phone.selected()?.status }}</span></header><div class="editor-form"><p :if="!phone.selected()" class="field-help">Select a recorded call to see its status, transcript and settlement.</p><div :if="phone.selected()"><dl class="spending-controls"><div><dt>From</dt><dd>{{ phone.selected()?.from }}</dd></div><div><dt>To</dt><dd>{{ phone.selected()?.to }}</dd></div><div><dt>Provider state</dt><dd>{{ phone.selected()?.providerState }}</dd></div><div><dt>Recorded duration</dt><dd>{{ phone.selected()?.durationSeconds || 0 }} seconds</dd></div><div><dt>Credit reserved</dt><dd>{{ phone.money(phone.selected()?.reservedCents) }}</dd></div><div><dt>Cost settlement</dt><dd>{{ phone.selected()?.settlement }}</dd></div></dl><p :if="phone.selected()?.lastError" class="console-error" role="alert">{{ phone.selected()?.lastError }}</p><div class="flex flex-wrap gap-3 mt-5"><button :if="!phone.isTerminal(phone.selected()?.status)" type="button" class="button button-outline" @click="phone.operate('end')" :disabled="workspace.pending()">End provider call</button><button type="button" class="button button-outline" @click="phone.operate('reconcile')" :disabled="workspace.pending()">Reconcile provider costs</button><button :if="phone.canTakeOver()" type="button" class="button button-teal" @click="phone.operate('takeover')" :disabled="workspace.pending()">Take over in browser</button></div><p :if="phone.selected()?.settlement === 'pending'" class="mt-4 field-help">Pending charges remain reserved until every provider cost is confirmed.</p><h3 class="mt-8 font-semibold text-sm">Transcript</h3><p class="mt-3 break-words text-sm whitespace-pre-wrap">{{ phone.selected()?.transcript || 'No transcript has been recorded.' }}</p></div></div></section></div>
<p class="mt-8 capability-note">Outbound agent dialing, hold, voicemail, number purchases and audio recordings are not available. Managed calls also require your wallet and spending controls.</p><a href="/app/usage" class="inline-flex mt-4 text-xs console-link">Manage credit and spending ceilings <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a>
@endsection
