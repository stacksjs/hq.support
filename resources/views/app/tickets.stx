<script server>
const pageTitle = 'Tickets'
const pageDescription = 'Manage typed customer requests, relations and response targets.'
</script>
<script client>
import { createTickets } from '../../functions/support/tickets'
const tickets = createTickets()
const workspace = tickets.workspace
const project = workspace.project
const query = tickets.query
const filter = tickets.filter
const status = tickets.status
const priority = tickets.priority
const assignee = tickets.assignee
const relationKind = tickets.relationKind
const relatedId = tickets.relatedId
const sourceId = tickets.sourceId
const createTypeId = tickets.createTypeId
const title = tickets.title
const description = tickets.description
onMount(() => tickets.boot())
onDestroy(() => tickets.destroy())
</script>
@extends('console')
@section('content')
<header class="console-heading"><div><h1>Tickets</h1><p>Keep a clear owner of the next step. Capture the right context and follow each request against its response targets.</p><a href="/app/ticket-settings" class="inline-flex mt-3 text-xs console-link">Configure ticket forms, calendars and SLAs <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i></a></div><div class="project-picker"><label for="ticket-project">Project</label><select id="ticket-project" x-model="project" @change="tickets.load()" :disabled="workspace.pending() || workspace.loading() || tickets.dirty() || tickets.creating()"><option value="">Select a project</option><option :for="item in workspace.projects()" :value="item.public_id">{{ item.name }}</option></select></div></header>
<p :if="workspace.error()" class="console-error" role="alert">{{ workspace.error() }}</p><p :if="workspace.notice()" class="console-notice" role="status">{{ workspace.notice() }}</p><p :if="tickets.configurationError()" class="capability-note">{{ tickets.configurationError() }}</p>
<div class="console-toolbar"><input x-model="query" type="search" placeholder="Search ticket titles" aria-label="Search tickets"><select x-model="filter" aria-label="Filter ticket status"><option value="all">All categories</option><option value="open">Open</option><option value="pending">Pending</option><option value="resolved">Resolved</option></select><button class="button button-outline" type="button" @click="tickets.load()" :disabled="workspace.loading() || workspace.pending()">Refresh tickets</button><button type="button" class="button button-teal" @click="tickets.startCreate()" :disabled="workspace.loading() || workspace.pending() || tickets.creating()">New ticket</button></div>
<p :if="workspace.loading()" class="console-loading" role="status">Loading tickets...</p>
<form :if="tickets.creating()" class="mb-8 editor-panel" @submit.prevent="tickets.createTicket()"><header class="editor-panel-heading"><div><h2>Create a ticket</h2><p class="field-help">Start from an existing customer conversation. Internal and incident tickets stay private to agents.</p></div></header><fieldset class="border-0 editor-form" :disabled="workspace.pending() || workspace.loading()"><label for="ticket-source">Recent customer conversation</label><select id="ticket-source" x-model="sourceId" required><option value="">Choose a conversation</option><option :for="source in tickets.sources()" :value="String(source.id)">#{{ source.id }} / {{ source.subject }}</option></select><p :if="tickets.sources().length === 0" class="field-help">No conversation is available in this project. Start a customer conversation through your connected messenger first.</p><label for="new-ticket-type">Ticket type</label><select id="new-ticket-type" x-model="createTypeId" @change="tickets.changeCreateType()"><option value="">Standard customer ticket (no SLA)</option><option :for="type in tickets.types()" :value="String(type.id)">{{ type.name }} / {{ type.kind }}</option></select><label for="new-ticket-title">Title</label><input id="new-ticket-title" x-model="title" required maxlength="200"><label for="new-ticket-description">Description</label><textarea id="new-ticket-description" x-model="description" rows="4" maxlength="20000"></textarea>
<div :for="field in tickets.createFields()"><label :for="'create-' + field.key">{{ field.label }}{{ field.required ? ' *' : '' }} <span class="field-help">({{ field.visibility }})</span></label><select :if="field.type === 'enum'" :id="'create-' + field.key" :value="tickets.createFieldValue(field.key)" @change="tickets.editField(field.key,$event,true)" :required="field.required"><option value="">Choose an answer</option><option :for="option in field.options || []" :value="option">{{ option }}</option></select><select :if="field.type === 'boolean'" :id="'create-' + field.key" :value="tickets.createFieldValue(field.key)" @change="tickets.editField(field.key,$event,true)" :required="field.required"><option value="">Choose an answer</option><option value="true">Yes</option><option value="false">No</option></select><input :if="field.type !== 'enum' && field.type !== 'boolean'" :id="'create-' + field.key" :value="tickets.createFieldValue(field.key)" @input="tickets.editField(field.key,$event,true)" :type="tickets.inputType(field)" :step="field.type === 'integer' ? '1' : 'any'" maxlength="4000" :required="field.required"></div><div class="flex gap-3 mt-5"><button type="submit" class="button button-teal">{{ workspace.pending() ? 'Creating...' : 'Create ticket' }}</button><button type="button" class="button button-outline" @click="tickets.creating.set(false)">Cancel new ticket</button></div></fieldset></form>
<div :if="!workspace.loading() && tickets.tickets().length === 0 && !tickets.creating()" class="console-empty"><h2>No tickets yet.</h2><p>Create a ticket from a conversation, or connect the embedded customer ticket form.</p><a href="/help/messenger" class="button button-outline">Read the integration guide</a></div>
<div :if="tickets.tickets().length > 0" class="editor-grid"><section class="resource-list" aria-label="Tickets"><button :for="item in tickets.filtered()" type="button" :class="String(tickets.selected()?.id) === String(item.id) ? 'chosen' : ''" @click="tickets.select(item)" :disabled="workspace.pending()"><strong>{{ item.title }}</strong><span>#{{ item.id }} / {{ item.kind || 'customer' }} / {{ tickets.stateLabel(item) }} / {{ item.priority }}</span><span :if="item.sla?.firstBreachedAt || item.sla?.resolutionBreachedAt">SLA breach recorded</span></button><p :if="tickets.filtered().length === 0" class="empty-list">No tickets match this search.</p></section>
<section class="editor-panel"><header class="editor-panel-heading"><h2>{{ tickets.selected()?.title || 'Select a ticket' }}</h2><span :if="tickets.selected()" class="status-label">{{ tickets.selected()?.status }}</span></header><div :if="!tickets.selected()" class="editor-form"><p class="field-help">Open a ticket to read its snapshot, update its state and see recorded SLA targets.</p></div><div :if="tickets.selected()">
<section class="px-6 py-5 border-[#e1e8e2] border-b"><div class="flex gap-3 items-center justify-between"><h3 class="font-semibold text-sm">Response targets</h3><span :if="tickets.selected()?.sla" class="status-label">Cycle {{ tickets.selected()?.sla?.cycle }} / {{ tickets.selected()?.sla?.phase }}</span></div><p :if="!tickets.selected()?.sla" class="mt-3 field-help">No SLA clock is attached to this ticket. Standard and legacy tickets keep their existing behavior.</p><article :for="clock in tickets.slaRows()" class="py-4 border-[#e1e8e2] border-b"><div class="flex flex-wrap gap-3 items-center justify-between"><strong class="text-sm">{{ clock.label }}</strong><span class="status-label">{{ clock.outcome }}</span></div><p :if="clock.due" class="mt-2 field-help">Deadline: {{ tickets.date(clock.due) }}</p><p :if="clock.countdown" class="mt-2 text-sm">{{ clock.countdown }}</p><p :if="clock.done" class="mt-2 field-help">Completed: {{ tickets.date(clock.done) }}</p><p :if="clock.breach" class="mt-2 field-help">Recorded breach deadline: {{ tickets.date(clock.breach) }}</p></article><p :if="tickets.selected()?.sla" class="mt-4 field-help">Deadlines use server-calculated working hours. The countdown uses your current clock; refresh to see persisted response and breach updates. Pausing clears active deadlines without inventing a remaining-time estimate.</p></section>
<form class="editor-form" @submit.prevent="tickets.save()" @input="tickets.markDirty()" @change="tickets.markDirty()"><p class="ticket-description">{{ tickets.selected()?.description || 'No additional details provided.' }}</p><div class="field-grid"><div><label for="ticket-state">Ticket state</label><select id="ticket-state" x-model="status" :disabled="workspace.pending()"><option :for="item in tickets.selectedStates()" :value="item.key">{{ item.label }} / {{ item.category }}</option></select></div><div><label for="ticket-priority">Priority</label><select id="ticket-priority" x-model="priority" :disabled="workspace.pending()"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option></select></div></div><label for="ticket-assignee">Assigned agent</label><select id="ticket-assignee" x-model="assignee" :disabled="workspace.pending()"><option value="">Unassigned</option><option :for="agent in tickets.agents()" :value="agent.id">{{ agent.name }} / {{ agent.role }}</option></select>
<div :for="field in tickets.selectedFields()"><label :for="'edit-' + field.key">{{ field.label }}{{ field.required ? ' *' : '' }} <span class="field-help">({{ field.visibility }})</span></label><select :if="field.type === 'enum'" :id="'edit-' + field.key" :value="tickets.fieldValue(field.key)" @change="tickets.editField(field.key,$event)" :required="field.required" :disabled="workspace.pending()"><option value="">Choose an answer</option><option :for="option in field.options || []" :value="option">{{ option }}</option></select><select :if="field.type === 'boolean'" :id="'edit-' + field.key" :value="tickets.fieldValue(field.key)" @change="tickets.editField(field.key,$event)" :required="field.required" :disabled="workspace.pending()"><option value="">Choose an answer</option><option value="true">Yes</option><option value="false">No</option></select><input :if="field.type !== 'enum' && field.type !== 'boolean'" :id="'edit-' + field.key" :value="tickets.fieldValue(field.key)" @input="tickets.editField(field.key,$event)" :type="tickets.inputType(field)" :step="field.type === 'integer' ? '1' : 'any'" maxlength="4000" :required="field.required" :disabled="workspace.pending()"></div><p :if="tickets.dirty()" class="mt-4 field-help">You have unsaved changes. Refreshing keeps your field drafts; save or discard before switching tickets or projects.</p><div class="flex flex-wrap gap-3 mt-5"><button class="button button-teal" type="submit" :disabled="workspace.pending()">{{ workspace.pending() ? 'Saving...' : 'Save ticket changes' }}</button><button :if="tickets.dirty()" type="button" class="button button-outline" @click="tickets.discard()" :disabled="workspace.pending()">Discard ticket changes</button></div><p class="mt-5 field-help">Created {{ tickets.date(tickets.selected()?.created_at) }}</p><p class="field-help">Last updated {{ tickets.date(tickets.selected()?.updated_at) }}</p></form>
<section class="px-6 py-5 border-[#e1e8e2] border-t"><h3 class="font-semibold text-sm">Related tickets</h3><p :if="tickets.relationError()" class="console-error" role="alert">{{ tickets.relationError() }}</p><ul :if="tickets.relations().length" class="mt-4 space-y-3"><li :for="relation in tickets.relations()" class="text-sm">{{ relation.kind }} / #{{ relation.related_ticket_id }} / {{ tickets.relatedTitle(relation.related_ticket_id) }}</li></ul><p :if="tickets.relations().length === 0 && !tickets.relationError()" class="mt-3 field-help">No agent-only relations recorded.</p><form class="mt-5" @submit.prevent="tickets.addRelation()"><div class="field-grid"><div><label for="relation-kind">Relation kind</label><select id="relation-kind" x-model="relationKind" @change="tickets.relatedId.set('')" :disabled="workspace.pending()"><option value="parent">Parent</option><option value="incident">Incident</option><option value="internal">Internal</option><option value="customer">Customer</option></select></div><div><label for="related-ticket">Target ticket</label><select id="related-ticket" x-model="relatedId" required :disabled="workspace.pending()"><option value="">Choose a project ticket</option><option :for="item in tickets.targets()" :value="String(item.id)">#{{ item.id }} / {{ item.title }}</option></select></div></div><button type="submit" class="mt-4 button button-outline" :disabled="workspace.pending() || !relatedId()">Add ticket relation</button></form><p class="mt-4 field-help">Relations stay private to agents. Each ticket has at most one parent, and cycles are refused. Removing saved relations is not available.</p></section></div></section></div>
<p class="console-help-footer">SLA breach processing creates durable internal escalation work. This view does not claim external notifications were delivered. Reopening a typed ticket starts a new SLA cycle; existing form snapshots stay unchanged.</p>
@endsection
