<script server>
const pageTitle = 'Customer support, close to home'
const pageDescription = 'An open source customer support workspace built on Stacks. Conversations, a customer messenger, and room to grow.'
const snippet = `import { createSupportClient } from '@stacksjs/support/server'

const support = createSupportClient({
  url: 'https://hq.support',
  key: process.env.SUPPORTHQ_KEY,
  project: process.env.SUPPORTHQ_PROJECT_ID,
})

// Keep identity on your server.
const session = await support.createSession({
  externalId: String(user.id),
  email: user.email,
  name: user.name,
})`
const snippetLines = snippet.split('\n').map(line => ({ text: line.trimStart(), indented: line.startsWith(' ') }))
</script>
