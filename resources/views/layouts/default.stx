  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700;750&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/support.css">
</head>
<body class="min-h-[100dvh] antialiased text-[#20332f] bg-[#fafbf9]">
