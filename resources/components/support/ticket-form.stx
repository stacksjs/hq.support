<script component type="application/json">
{"tag":"hq-support-ticket-form","shadowDOM":"open","properties":{"apiUrl":{"type":"string","default":""},"projectId":{"type":"string","default":""},"sessionToken":{"type":"string","attribute":false,"reflect":false},"typeId":{"type":"string","default":""},"types":{"type":"array","attribute":false,"reflect":false},"fields":{"type":"array","attribute":false,"reflect":false},"pending":{"type":"boolean","attribute":false,"reflect":false},"loading":{"type":"boolean","attribute":false,"reflect":false},"blocked":{"type":"boolean","default":true,"attribute":false,"reflect":false},"ready":{"type":"boolean","attribute":false,"reflect":false},"loadError":{"type":"boolean","attribute":false,"reflect":false},"notice":{"type":"string","attribute":false,"reflect":false}},"events":{"delivery":{},"error":{},"ready":{}}}
</script>
<script client>
interface PublicField { key: string, label: string, type: string, visibility?: string, required?: boolean, default?: unknown, options?: string[] }
interface PublicType { id: string, name: string, fields: PublicField[] }
interface InputField { key: string, label: string, type: string, required: boolean, value: string, options: { value: string, selected: boolean }[] }
interface ComponentState {
  types: PublicType[]
  fields: InputField[]
  _observe?: () => void
  _identity?: string
  _currentType?: string
  _generation?: number
  _typesAbort?: AbortController
  _submitAbort?: AbortController
  _drafts?: Record<string, Record<string, string>>
  _subject?: string
  _body?: string
  _key?: string | null
  _fingerprint?: string
}
interface FormsResponse { types?: PublicType[], error?: { message?: string }, message?: string }

function onConnect() {
  this._observe = () => { this.configure().catch(() => {}) }
  this.addEventListener('stx:updated', this._observe)
  this.configure().catch(() => {})
}
async function configure(force = false) {
  const identity = String(this.apiUrl) + '|' + String(this.projectId) + '|' + String(this.sessionToken)
  if (identity === this._identity && !force) {
    if (this.ready && this.typeId !== this._currentType) this.updateFields()
    return
  }
  const changed = identity !== this._identity
  this._identity = identity
  this._generation = (this._generation || 0) + 1
  const generation = this._generation
  this._typesAbort?.abort()
  if (changed) {
    this._submitAbort?.abort()
    this._drafts = {}
    this._subject = ''
    this._body = ''
    this._key = null
    this._fingerprint = ''
    this.pending = false
  }
  this.ready = false
  this.blocked = true
  this.loadError = false
  this.notice = ''
  if (!this.sessionToken || !this.projectId) { this.types = []; this.fields = []; this.loading = false; return }
  this.loading = true
  this._typesAbort = new AbortController()
  try {
    const response = await fetch(this.apiUrl.replace(/\/$/, '') + '/api/widget/projects/' + encodeURIComponent(this.projectId) + '/ticket-types', { credentials: 'omit', referrerPolicy: 'origin', signal: this._typesAbort.signal, headers: { Authorization: 'Bearer ' + this.sessionToken } })
    const data: FormsResponse = await response.json()
    if (!response.ok) throw new Error(data.error?.message || data.message || 'Ticket forms could not be loaded.')
    if (generation !== this._generation) return
    this.types = (data.types || []).map(type => ({ id: String(type.id), name: String(type.name), fields: (type.fields || []).filter(field => field.visibility === 'customer') }))
    if (!this.types.some(type => type.id === this.typeId)) this.typeId = this.types[0]?.id || ''
    this.ready = true
    this.updateFields()
    this.emit('ready', { types: this.types.length })
  }
  catch (error) {
    if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return
    this.types = []
    this.fields = []
    this.loadError = true
    this.notice = error instanceof Error ? error.message : 'Ticket forms could not be loaded.'
    this.emit('error', { message: this.notice })
  }
  finally { if (generation === this._generation) { this.loading = false; this.blocked = !this.ready } }
}
async function refresh(): Promise<void> { if (!this.pending) await this.configure(true) }
function updateFields() {
  this._drafts = this._drafts || {}
  const draft = this._drafts[this.typeId] || {}
  this._drafts[this.typeId] = draft
  const type = this.types.find(type => type.id === this.typeId)
  this.fields = (type?.fields || []).map(field => {
    if (draft[field.key] === undefined) draft[field.key] = field.default === undefined || field.default === null ? '' : String(field.default)
    return { key: field.key, label: field.label, type: field.type, required: field.required === true, value: draft[field.key], options: (field.options || []).map(value => ({ value, selected: value === draft[field.key] })) }
  })
  this._currentType = this.typeId
}
function capture(form: HTMLFormElement | null | undefined) {
  if (!form) return
  const values = new FormData(form)
  this._subject = String(values.get('subject') || '')
  this._body = String(values.get('body') || '')
  this._drafts = this._drafts || {}
  this._drafts[this.typeId] = Object.fromEntries(this.fields.map(field => [field.key, String(values.get('custom__' + field.key) || '')]))
}
function edit(event: Event) { if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLSelectElement) this.capture(event.target.form) }
function chooseType(event: Event) { if (!(event.target instanceof HTMLSelectElement)) return; this.capture(event.target.form); this.typeId = event.target.value; this.updateFields() }
async function submit(event: Event) {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement)) return
  if (this.pending || !this.ready) return
  if (!this.sessionToken || !this.projectId) { this.notice = 'Connect a customer session before submitting a ticket.'; return }
  this.capture(event.target)
  this.updateFields()
  const customFields: Record<string, string | number | boolean> = {}
  try {
    for (const field of this.fields) {
      const value = field.value
      if (value === '') { if (field.required) throw new Error(field.label + ' is required.'); continue }
      if (field.type === 'number' || field.type === 'integer') {
        const number = Number(value)
        if (!Number.isFinite(number) || (field.type === 'integer' && !Number.isInteger(number))) throw new Error(field.label + ' needs a valid ' + field.type + '.')
        customFields[field.key] = number
      }
      else if (field.type === 'boolean') { if (!['true', 'false'].includes(value)) throw new Error(field.label + ' needs a yes or no answer.'); customFields[field.key] = value === 'true' }
      else customFields[field.key] = value
    }
  }
  catch (error) { this.notice = error instanceof Error ? error.message : 'Your ticket could not be submitted.'; this.emit('error', { message: this.notice }); return }
  const payload = { title: this._subject, description: this._body, typeId: this.typeId || undefined, customFields }
  const fingerprint = JSON.stringify(payload)
  if (fingerprint !== this._fingerprint) { this._fingerprint = fingerprint; this._key = crypto.randomUUID() }
  const generation = this._generation
  this.pending = true
  this.blocked = true
  this.notice = ''
  this._submitAbort = new AbortController()
  try {
    const response = await fetch(this.apiUrl.replace(/\/$/, '') + '/api/widget/projects/' + encodeURIComponent(this.projectId) + '/tickets', { method: 'POST', credentials: 'omit', signal: this._submitAbort.signal, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + this.sessionToken }, body: JSON.stringify({ ...payload, idempotencyKey: this._key }) })
    const data = await response.json()
    if (!response.ok) throw new Error(data.error?.message || data.message || 'Your ticket could not be submitted. Please retry.')
    if (generation !== this._generation) return
    this._key = null
    this._fingerprint = ''
    this._subject = ''
    this._body = ''
    this._drafts = {}
    this.updateFields()
    this.notice = 'Your ticket has been submitted.'
    this.emit('delivery', { ticket: data.ticket || data })
  }
  catch (error) { if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return; this.notice = error instanceof Error ? error.message : 'Your ticket could not be submitted.'; this.emit('error', { message: this.notice }) }
  finally { if (generation === this._generation) { this.pending = false; this.blocked = !this.ready } }
}
function shutdown(): void {
  this._generation = (this._generation || 0) + 1
  this._typesAbort?.abort()
  this._submitAbort?.abort()
  this._identity = ''
  this._drafts = {}
  this._subject = ''
  this._body = ''
  this._key = null
  this._fingerprint = ''
  this.sessionToken = ''
  this.types = []
  this.fields = []
  this.ready = false
  this.loading = false
  this.pending = false
  this.blocked = true
  this.notice = ''
}
function onDisconnect() { if (this._observe) this.removeEventListener('stx:updated', this._observe); this.shutdown() }
</script>
<template>
<form @submit.prevent="submit" @input="edit"><h2>Get help from the team</h2><fieldset :disabled="this.blocked">@if(this.types.length > 0)<label for="ticket-type">Request type</label><select id="ticket-type" name="type" @change="chooseType">@foreach(this.types as type)@if(type.id === this.typeId)<option value="{{ type.id }}" selected>{{ type.name }}</option>@else<option value="{{ type.id }}">{{ type.name }}</option>@endif@endforeach</select>@endif<label for="ticket-subject">Subject</label><input id="ticket-subject" name="subject" required maxlength="200" placeholder="What do you need help with?" value="{{ this._subject || '' }}"><label for="ticket-body">Details</label><textarea id="ticket-body" name="body" required maxlength="10000" rows="5" placeholder="Include the steps you took and what you expected.">{{ this._body || '' }}</textarea>
@foreach(this.fields as field)<label for="custom__{{ field.key }}">{{ field.label }}{{ field.required ? ' *' : '' }}</label>
@if(field.type === 'enum')<select id="custom__{{ field.key }}" name="custom__{{ field.key }}" aria-required="{{ field.required }}"><option value="">Choose an answer</option>@foreach(field.options as option)@if(option.selected)<option value="{{ option.value }}" selected>{{ option.value }}</option>@else<option value="{{ option.value }}">{{ option.value }}</option>@endif@endforeach</select>
@elseif(field.type === 'boolean')<select id="custom__{{ field.key }}" name="custom__{{ field.key }}" aria-required="{{ field.required }}"><option value="">Choose an answer</option>@if(field.value === 'true')<option value="true" selected>Yes</option>@else<option value="true">Yes</option>@endif@if(field.value === 'false')<option value="false" selected>No</option>@else<option value="false">No</option>@endif</select>
@elseif(field.type === 'number')<input id="custom__{{ field.key }}" name="custom__{{ field.key }}" type="number" step="any" value="{{ field.value }}" aria-required="{{ field.required }}">
@elseif(field.type === 'integer')<input id="custom__{{ field.key }}" name="custom__{{ field.key }}" type="number" step="1" value="{{ field.value }}" aria-required="{{ field.required }}">
@elseif(field.type === 'email')<input id="custom__{{ field.key }}" name="custom__{{ field.key }}" type="email" value="{{ field.value }}" aria-required="{{ field.required }}">
@elseif(field.type === 'date')<input id="custom__{{ field.key }}" name="custom__{{ field.key }}" type="date" value="{{ field.value }}" aria-required="{{ field.required }}">
@else<input id="custom__{{ field.key }}" name="custom__{{ field.key }}" maxlength="4000" value="{{ field.value }}" aria-required="{{ field.required }}">@endif@endforeach
<p role="status" aria-live="polite">{{ this.notice }}</p><button type="submit">{{ this.pending ? 'Submitting...' : this.loading ? 'Loading forms...' : 'Submit ticket' }}</button></fieldset><button type="button" class="refresh" @click="refresh" :disabled="this.pending">{{ this.loadError ? 'Retry loading ticket forms' : 'Refresh ticket forms' }}</button></form>
</template>
<style>
:host{display:block;font:14px Geist,system-ui,sans-serif;color:#20332f}*{box-sizing:border-box}fieldset{border:0;padding:0;margin:0;min-width:0}h2{font-size:20px;letter-spacing:-.5px;margin:0 0 24px}label{display:block;font-size:12px;font-weight:600;margin:16px 0 8px}input,textarea,select{width:100%;font:inherit;color:inherit;background:#fff;border:1px solid #cddbd3;border-radius:9px;padding:12px}textarea{resize:vertical}p{color:#53665d;line-height:1.5}button{font:inherit;border:0;border-radius:9px;background:#126d60;color:#fff;padding:12px 18px;cursor:pointer}fieldset:disabled,button:disabled{opacity:.55}button:disabled{cursor:wait}.refresh{background:transparent;color:#126d60;padding:12px 0;font-size:12px}input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #68bcab;outline-offset:3px}
</style>
