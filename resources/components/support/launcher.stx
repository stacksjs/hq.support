<script component type="application/json">
{"tag":"hq-support-launcher","shadowDOM":"open","properties":{"label":{"type":"string","default":"Contact support"},"unread":{"type":"number","default":0},"locale":{"type":"string","attribute":false,"reflect":false,"default":"en"},"textDirection":{"type":"string","attribute":false,"reflect":false,"default":"ltr"},"unreadLabel":{"type":"string","attribute":false,"reflect":false,"default":"Unread messages"}},"events":{"opened":{"description":"Customer requests the messenger"}}}
</script>
<script client>
import { messengerDirection, messengerLocale, messengerText } from '../../functions/support/messenger-locale'

function setLocale(language: string, label?: string): void {
  const locale = messengerLocale(language)
  this.locale = locale
  this.textDirection = messengerDirection(locale)
  this.label = label || messengerText(locale, 'launcher')
  this.unreadLabel = messengerText(locale, 'unread')
}
function open() {
  this.emit('opened', { source: 'launcher' })
}
</script>
<template>
  <button id="support-launcher" type="button" @click="open" lang="{{ this.locale }}" dir="{{ this.textDirection }}" aria-label="{{ this.label }}">
    <span class="mark" aria-hidden="true">h</span>
    <span>{{ this.label }}</span>
    @if(this.unread > 0)
      <strong aria-label="{{ this.unreadLabel }}">{{ this.unread }}</strong>
    @endif
  </button>
</template>
<style>
:host{display:inline-block;font-family:Geist,ui-sans-serif,system-ui,sans-serif;color:#fff}button{font:inherit;border:0;border-radius:14px;background:#126d60;color:inherit;min-height:52px;display:flex;align-items:center;gap:10px;padding:10px 18px;cursor:pointer;box-shadow:0 6px 24px #123d2920}button:hover{background:#0b584d}button:focus-visible{outline:3px solid #68bcab;outline-offset:4px}.mark{font-size:28px;font-weight:750;line-height:1}strong{display:grid;place-items:center;background:#fff;color:#126d60;min-width:22px;height:22px;border-radius:50%;font-size:12px}
</style>
