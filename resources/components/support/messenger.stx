<script component type="application/json">
{"tag":"hq-support-messenger","shadowDOM":"open","properties":{"apiUrl":{"type":"string","default":""},"projectId":{"type":"string","default":""},"sessionToken":{"type":"string","attribute":false,"reflect":false},"opened":{"type":"boolean","default":false},"pending":{"type":"boolean","attribute":false,"reflect":false},"notice":{"type":"string","attribute":false,"reflect":false},"thread":{"type":"array","attribute":false,"reflect":false},"conversationId":{"type":"string","attribute":false,"reflect":false},"heading":{"type":"string","default":"How can we help?"}},"events":{"ready":{},"opened":{},"closed":{},"unread":{},"delivery":{},"error":{}}}
</script>
<script client>
interface Message { id: string, body: string, author_type: string }
interface ComponentState {
  thread: Message[]
  _generation?: number
  _abort?: AbortController
  _poll?: ReturnType<typeof setInterval>
  _refreshing?: boolean
  _unread?: number
  _sendKey?: string | null
  _draft?: string
}
interface ResponseError { message?: string, error?: { message?: string } | string }
interface SessionResponse { token: string }
interface ConversationsResponse { conversations?: { id: string }[] }
interface ConversationResponse { messages?: Message[] }
interface CreatedConversation { conversation?: { id: string }, id?: string }

function onConnect() {
  this._generation = this._generation || 0
}
function onDisconnect() {
  this.shutdown()
}
async function boot(options: { url?: string, project?: string, token?: string } = {}): Promise<void> {
  const wasOpened = this.opened
  const suppliedToken = options.token || this.sessionToken
  this.shutdown()
  this.opened = wasOpened
  this._generation = (this._generation || 0) + 1
  const generation = this._generation
  this.apiUrl = String(options.url ?? this.apiUrl).replace(/\/$/, '')
  this.projectId = String(options.project ?? this.projectId)
  if (!this.projectId) throw new Error('A public project ID is required.')
  if (this.apiUrl && !/^https?:\/\//.test(this.apiUrl)) throw new Error('Support URL must use HTTP or HTTPS.')
  this._abort = new AbortController()
  this.pending = true
  this.notice = ''
  try {
    const session = await this.request<SessionResponse>('/session', { method: 'POST', body: JSON.stringify({ token: suppliedToken || undefined }) }, false)
    if (generation !== this._generation) return
    this.sessionToken = session.token
    const result = await this.request<ConversationsResponse>('/conversations')
    if (generation !== this._generation) return
    const conversation = result.conversations?.[0]
    if (conversation) {
      this.conversationId = String(conversation.id)
      const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(this.conversationId))
      if (generation !== this._generation) return
      this.thread = detail.messages || []
    }
    this._poll = setInterval(() => this.refresh().catch(() => {}), 5000)
    this.emit('ready', { project: this.projectId })
    this.emit('unread', { count: 0 })
  }
  catch (error) {
    if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return
    this.notice = error instanceof Error ? error.message : 'Support is unavailable. Please try again.'
    this.emit('error', { message: this.notice })
    throw error
  }
  finally {
    if (generation === this._generation) this.pending = false
  }
}
function open(): void {
  this.opened = true
  this._unread = 0
  this.emit('unread', { count: 0 })
  this.emit('opened', {})
  if (!this.sessionToken && !this.pending) this.boot().catch(() => {})
}
function close(): void {
  this.opened = false
  this.emit('closed', {})
}
async function update(options: { url?: string, project?: string, token?: string } = {}): Promise<void> {
  return this.boot({ url: this.apiUrl, project: this.projectId, ...options })
}
async function track(event: { event: string, attributes?: Record<string, unknown>, idempotencyKey?: string }): Promise<{ id: string, accepted: boolean }> {
  if (!this.sessionToken) throw new Error('Boot the messenger before tracking events.')
  return this.request<{ id: string, accepted: boolean }>('/events', { method: 'POST', body: JSON.stringify({ ...event, idempotencyKey: event.idempotencyKey || crypto.randomUUID() }) })
}
function shutdown(): void {
  this._generation = (this._generation || 0) + 1
  this._abort?.abort()
  clearInterval(this._poll)
  this._refreshing = false
  this._unread = 0
  this.sessionToken = ''
  this.conversationId = ''
  this.thread = []
  this.pending = false
  this.opened = false
  this.notice = ''
  this._sendKey = null
  this._draft = ''
}
async function request<T = unknown>(path: string, options: RequestInit = {}, authenticated = true): Promise<T> {
  const response = await fetch(this.apiUrl + '/api/widget/projects/' + encodeURIComponent(this.projectId) + path, {
    ...options,
    credentials: 'omit',
    cache: 'no-store',
    signal: this._abort?.signal,
    headers: { 'Content-Type': 'application/json', ...(authenticated ? { Authorization: 'Bearer ' + this.sessionToken } : {}) },
  })
  const result: T & ResponseError = await response.json().catch(() => ({}))
  if (!response.ok) throw new Error(result.message || (typeof result.error === 'object' ? result.error?.message : '') || (typeof result.error === 'string' ? result.error : '') || 'Support request failed (' + response.status + ').')
  return result
}
function editDraft(event: Event) {
  if (event.target instanceof HTMLTextAreaElement) this._draft = event.target.value
}
async function refresh(): Promise<void> {
  if (!this.sessionToken || this.pending || this._refreshing) return
  const generation = this._generation
  this._refreshing = true
  try {
    if (!this.conversationId) return
    const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(this.conversationId))
    if (generation !== this._generation) return
    const next = detail.messages || []
    if (JSON.stringify(next) !== JSON.stringify(this.thread)) {
      const oldIds = new Set(this.thread.map(message => String(message.id)))
      const received = next.filter(message => !oldIds.has(String(message.id)) && message.author_type === 'agent').length
      this.thread = next
      this._unread = this.opened ? 0 : (this._unread || 0) + received
      this.emit('unread', { count: this._unread })
    }
  }
  catch (error) {
    if (generation === this._generation && !(error instanceof Error && error.name === 'AbortError')) this.emit('error', { message: error instanceof Error ? error.message : 'Messages could not be refreshed.' })
  }
  finally { if (generation === this._generation) this._refreshing = false }
}
async function send(event: Event) {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement)) return
  if (this.pending || !this.sessionToken) return
  const form = event.target
  const body = String(new FormData(form).get('body') || '').trim()
  if (!body) return
  this._draft = body
  this.pending = true
  this.notice = ''
  const generation = this._generation
  try {
    const idempotencyKey = this._sendKey || crypto.randomUUID()
    this._sendKey = idempotencyKey
    if (!this.conversationId) {
      const result = await this.request<CreatedConversation>('/conversations', { method: 'POST', body: JSON.stringify({ subject: body.slice(0, 120), body, idempotencyKey }) })
      if (generation !== this._generation) return
      this.conversationId = String(result.conversation?.id || result.id)
    }
    else {
      await this.request('/conversations/' + encodeURIComponent(this.conversationId) + '/messages', { method: 'POST', body: JSON.stringify({ body, idempotencyKey }) })
    }
    if (generation !== this._generation) return
    this._sendKey = null
    this._draft = ''
    form.reset()
    const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(this.conversationId))
    if (generation !== this._generation) return
    this.thread = detail.messages || []
    this.emit('delivery', { conversationId: this.conversationId, status: 'sent' })
  }
  catch (error) {
    if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return
    this.notice = error instanceof Error ? error.message : 'Your message could not be sent. Please retry.'
    this.emit('error', { message: this.notice })
  }
  finally {
    if (generation === this._generation) this.pending = false
  }
}
</script>
<template>
  @if(this.opened)
    <section class="messenger" role="region" aria-label="Customer support">
      <header><div><span class="brand">hq.support</span><h2>{{ this.heading }}</h2><p>Send a message to the team.</p></div><button class="close" type="button" @click="close" aria-label="Close support">×</button></header>
      <div class="messages" role="log" aria-live="polite" aria-relevant="additions text">
        @if(this.thread.length === 0)
          <div class="welcome"><strong>A little context goes a long way.</strong><p>Tell us what you are working on and where you got stuck.</p></div>
        @endif
        @foreach(this.thread as message)
          <article class="message"><small>{{ ['contact', 'customer'].includes(message.author_type) ? 'You' : 'Support' }}</small><p>{{ message.body }}</p></article>
        @endforeach
      </div>
      @if(this.notice)
        <p class="notice" role="alert">{{ this.notice }}</p>
      @endif
      <form @submit.prevent="send"><label for="support-body">Your message</label><textarea id="support-body" name="body" @input="editDraft" required maxlength="10000" placeholder="Write your message..." rows="3" :disabled="this.pending">{{ this._draft || '' }}</textarea><div class="send-row"><span>{{ this.pending ? 'Connecting...' : 'Powered by HQ.support' }}</span><button type="submit" :disabled="this.pending">Send message</button></div></form>
    </section>
  @endif
</template>
<style>
:host{display:block;font-family:Geist,ui-sans-serif,system-ui,sans-serif;color:#20332f;--support-accent:#126d60}.messenger{width:min(380px,calc(100vw - 32px));background:#fff;border:1px solid #dce5e1;border-radius:20px;box-shadow:0 18px 70px #122e2929;overflow:hidden}*{box-sizing:border-box}header{background:#f0f7f4;padding:24px;display:flex;gap:12px;justify-content:space-between}.brand{font-size:12px;font-weight:700;color:#126d60}h2{margin:18px 0 8px;font-size:25px;letter-spacing:-.8px;line-height:1.2}p{line-height:1.5;font-size:14px;margin:0}header p{color:#526760}.close{align-self:flex-start;width:32px;height:32px;background:transparent;color:#526760;border:0;font-size:25px;border-radius:8px;cursor:pointer}.messages{min-height:220px;max-height:340px;overflow:auto;padding:20px}.welcome{padding:30px 6px;color:#526760}.welcome strong{color:#263c34;font-size:14px}.welcome p{margin-top:9px}.message{background:#f3f6f4;padding:12px 14px;border-radius:12px;margin:0 0 12px}.message small{font-size:11px;color:#536d62;font-weight:650}.message p{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:5px}form{padding:16px 20px;border-top:1px solid #e5ebe7}label{display:block;font-size:12px;font-weight:600;margin-bottom:8px}textarea{width:100%;font:inherit;font-size:14px;border:1px solid #cddbd3;border-radius:10px;padding:12px;resize:vertical;min-height:80px;color:#20332f;background:#fff}.send-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}.send-row span{font-size:10px;color:#62736c}button[type=submit]{font:inherit;background:var(--support-accent);color:#fff;border:0;border-radius:8px;padding:10px 13px;font-size:12px;font-weight:650;cursor:pointer}button:disabled{opacity:.55;cursor:wait}button:focus-visible,textarea:focus-visible{outline:3px solid #68bcab;outline-offset:3px}.notice{padding:12px 20px;color:#923a25;background:#fff4ee;font-size:12px}@media(prefers-reduced-motion:no-preference){button{transition:background .15s}button:hover{filter:brightness(.94)}}
</style>
