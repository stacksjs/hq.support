<script component type="application/json">
{"tag":"hq-support-messenger","shadowDOM":"open","properties":{"apiUrl":{"type":"string","default":""},"projectId":{"type":"string","default":""},"sessionToken":{"type":"string","attribute":false,"reflect":false},"opened":{"type":"boolean","default":false},"typing":{"type":"boolean","attribute":false,"reflect":false},"pending":{"type":"boolean","attribute":false,"reflect":false},"notice":{"type":"string","attribute":false,"reflect":false},"deliveryNotice":{"type":"string","attribute":false,"reflect":false},"attachments":{"type":"array","attribute":false,"reflect":false},"thread":{"type":"array","attribute":false,"reflect":false},"conversationId":{"type":"string","attribute":false,"reflect":false},"heading":{"type":"string","default":""},"locale":{"type":"string","attribute":false,"reflect":false,"default":"en"},"csat":{"type":"object","attribute":false,"reflect":false},"csatOffer":{"type":"object","attribute":false,"reflect":false},"csatPending":{"type":"boolean","attribute":false,"reflect":false},"csatNotice":{"type":"string","attribute":false,"reflect":false},"csatChanged":{"type":"boolean","attribute":false,"reflect":false},"olderCursor":{"type":"string","attribute":false,"reflect":false},"olderPending":{"type":"boolean","attribute":false,"reflect":false},"olderFailed":{"type":"boolean","attribute":false,"reflect":false},"newerAvailable":{"type":"boolean","attribute":false,"reflect":false}},"events":{"ready":{},"opened":{},"closed":{},"unread":{},"delivery":{},"error":{}}}
</script>
<script client>
import { useBroadcastStream } from '@stacksjs/stx/composables/use-broadcast-stream'
import { messengerDate, messengerDirection, messengerLocale, messengerText } from '../../functions/support/messenger-locale'
import { createCustomerTyping } from '../../functions/support/customer-typing'

interface Message { id: string, body: string, author_type: string, created_at?: string, delivery_status?: string }
interface Attachment { id: string, fileName: string, mimeType: string, bytes: number, visibility: string }
interface CsatOffer { question: string, revision: number }
interface CsatAnswer { id: string, score: number, comment: string, question: string, revision: number, createdAt: string }
type CsatStatus = { available?: boolean, reason?: string, survey?: CsatOffer, response?: CsatAnswer }
interface CsatPayload { score: number, comment: string, revision: number }
interface CustomerTyping {
  input(conversation: string, hasDraft: boolean): void
  listen(): () => void
  stop(): void
}
interface ComponentState {
  csat: CsatStatus
  csatOffer: Partial<CsatOffer>
  _csatConversation?: string
  _csatScore?: string
  _csatComment?: string
  _csatRefreshing?: boolean
  _csatOperation?: { key: string, payload: CsatPayload } | null
  thread: Message[]
  attachments: Attachment[]
  _olderRequest?: AbortController
  _loadedOlder?: boolean
  _latestHistory?: ConversationResponse
  _historySubject?: string
  _historyRevision?: number
  _generation?: number
  _abort?: AbortController
  _poll?: ReturnType<typeof setInterval>
  _typingTimer?: ReturnType<typeof setTimeout>
  _typingRequest?: AbortController
  _typingStream?: { close(): void }
  _customerTyping?: CustomerTyping
  _typingCleanup?: () => void
  _refreshRequest?: AbortController
  _unread?: number
  _sendKey?: string | null
  _sendFingerprint?: string
  _draft?: string
}
interface ResponseError { message?: string, error?: { message?: string, code?: string } | string }
interface SessionResponse { token: string }
interface ConversationsResponse { conversations?: { id: string }[] }
interface ConversationResponse { conversation: { id: string, subject: string }, messages: Message[], messagesNextCursor: string | null, attachments?: Attachment[] }
interface CreatedConversation { conversation?: { id: string }, id?: string }
interface CreatedReply { message?: { id: string, conversation_id: string, delivery_status?: string } }

function onConnect() {
  this._generation = this._generation || 0
  this._customerTyping ??= createCustomerTyping((path, options) => this.request(path, options))
  this._typingCleanup = this._customerTyping.listen()
}
function onDisconnect() {
  this._typingCleanup?.()
  this.shutdown()
}
function text(key: string, values?: Record<string, string | number>): string {
  return messengerText(messengerLocale(this.locale), key, values)
}
function direction(): 'rtl' | 'ltr' {
  return messengerDirection(messengerLocale(this.locale))
}
function date(timestamp: string): string {
  return messengerDate(messengerLocale(this.locale), timestamp)
}
async function boot(options: { url?: string, project?: string, token?: string, locale?: string } = {}): Promise<void> {
  this.locale = messengerLocale(options.locale || this.locale)
  const wasOpened = this.opened
  const suppliedToken = options.token || this.sessionToken
  this.shutdown()
  this.opened = wasOpened
  this._generation = (this._generation || 0) + 1
  const generation = this._generation
  this.apiUrl = String(options.url ?? this.apiUrl).replace(/\/$/, '')
  this.projectId = String(options.project ?? this.projectId)
  if (!this.projectId) throw new Error('A public project ID is required.')
  if (this.apiUrl && !/^https?:\/\//.test(this.apiUrl)) throw new Error('Support URL must use HTTP or HTTPS.')
  this._abort = new AbortController()
  this.pending = true
  this.notice = ''
  try {
    const session = await this.request<SessionResponse>('/session', { method: 'POST', body: JSON.stringify({ token: suppliedToken || undefined }) }, false)
    if (generation !== this._generation) return
    this.sessionToken = session.token
    const result = await this.request<ConversationsResponse>('/conversations')
    if (generation !== this._generation) return
    const conversation = result.conversations?.[0]
    if (conversation) {
      this.conversationId = String(conversation.id)
      const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(this.conversationId))
      if (generation !== this._generation) return
      this.applyHistory(detail)
      await this.refreshCsat()
      if (generation !== this._generation) return
    }
    this._poll = setInterval(() => this.refresh().catch(() => {}), 5000)
    this.startTyping()
    this.emit('ready', { project: this.projectId })
    this.emit('unread', { count: 0 })
  }
  catch (error) {
    if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return
    this.notice = error instanceof Error ? error.message : 'Support is unavailable. Please try again.'
    this.emit('error', { message: this.notice })
    throw error
  }
  finally {
    if (generation === this._generation) this.pending = false
  }
}
function open(): void {
  this.opened = true
  this.startTyping()
  this._unread = 0
  this.emit('unread', { count: 0 })
  this.emit('opened', {})
  if (!this.sessionToken && !this.pending) this.boot().catch(() => {})
}
function close(): void {
  this.opened = false
  this.cancelOlderHistory()
  this.stopTyping()
  this._customerTyping?.stop()
  this.emit('closed', {})
}
async function update(options: { url?: string, project?: string, token?: string, locale?: string } = {}): Promise<void> {
  if (options.locale && options.url === undefined && options.project === undefined && options.token === undefined) {
    this.locale = messengerLocale(options.locale)
    return
  }
  return this.boot({ url: this.apiUrl, project: this.projectId, ...options })
}
async function track(event: { event: string, attributes?: Record<string, unknown>, idempotencyKey?: string }): Promise<{ id: string, accepted: boolean }> {
  if (!this.sessionToken) throw new Error('Boot the messenger before tracking events.')
  return this.request<{ id: string, accepted: boolean }>('/events', { method: 'POST', body: JSON.stringify({ ...event, idempotencyKey: event.idempotencyKey || crypto.randomUUID() }) })
}
function shutdown(): void {
  this._customerTyping?.stop()
  this._generation = (this._generation || 0) + 1
  this._abort?.abort()
  clearInterval(this._poll)
  this.stopTyping()
  this._unread = 0
  this.sessionToken = ''
  this.conversationId = ''
  this.clearHistory()
  this.pending = false
  this.opened = false
  this.notice = ''; this.deliveryNotice = ''
  this._sendKey = null; this._sendFingerprint = ''
  this._draft = ''
  this.clearCsat()
}
function fetchWidget(path: string, options: RequestInit, authenticated: boolean): Promise<Response> {
  const headers = new Headers(options.headers)
  headers.set('Content-Type', 'application/json')
  if (authenticated) headers.set('Authorization', 'Bearer ' + this.sessionToken)
  return fetch(this.apiUrl + '/api/widget/projects/' + encodeURIComponent(this.projectId) + path, {
    ...options,
    credentials: 'omit',
    cache: 'no-store',
    referrerPolicy: 'origin',
    signal: options.signal ?? this._abort?.signal,
    headers,
  })
}
async function request<T = unknown>(path: string, options: RequestInit = {}, authenticated = true): Promise<T> {
  const generation = this._generation
  const response = await this.fetchWidget(path, options, authenticated)
  const result: T & ResponseError = await response.json().catch(() => ({}))
  if (response.status === 401 && authenticated && generation === this._generation) { this.shutdown(); this.emit('error', { message: 'Your customer session expired. Reconnect support.' }) }
  if (!response.ok) { const failure = new Error(result.message || (typeof result.error === 'object' ? result.error?.message : '') || (typeof result.error === 'string' ? result.error : '') || 'Support request failed (' + response.status + ').'); Object.assign(failure, { status: response.status, code: typeof result.error === 'object' ? result.error?.code : undefined }); throw failure }
  return result
}
function cancelOlderHistory(): void {
  this._olderRequest?.abort()
  this._olderRequest = undefined
  this.olderPending = false
}
function clearHistory(): void {
  this.cancelOlderHistory()
  this._historyRevision = (this._historyRevision || 0) + 1
  this._refreshRequest?.abort()
  this._refreshRequest = undefined
  this._loadedOlder = false
  this._latestHistory = undefined
  this._historySubject = undefined
  this.newerAvailable = false
  this.olderCursor = ''
  this.olderFailed = false
  this.thread = []
  this.attachments = []
}
function validateHistory(detail: ConversationResponse, conversation: string, before?: string): void {
  if (detail?.conversation?.id !== conversation || !Array.isArray(detail.messages)) throw new Error('Unexpected conversation history.')
  const cursor = detail.messagesNextCursor
  if (cursor !== null && (typeof cursor !== 'string' || !/^[1-9]\d*$/.test(cursor) || !Number.isSafeInteger(Number(cursor))
    || cursor !== detail.messages[0]?.id || (before && Number(cursor) >= Number(before))))
    throw new Error('Unexpected history cursor.')
}
function applyHistory(detail: ConversationResponse, showLatest = false): number {
  this.validateHistory(detail, this.conversationId)
  const messages = detail.messages, attachments = detail.attachments || []
  const previous = this.thread as Message[]
  const viewedNewest = Number(previous.at(-1)?.id ?? 0)
  const observedNewest = Number(this._latestHistory?.messages?.at(-1)?.id ?? viewedNewest)
  const responseNewest = messages.at(-1)
  // A poll that began before a reply can arrive after the reply's detail request.
  if (responseNewest && Number(responseNewest.id) < observedNewest) return 0
  const received = messages.filter(message => Number(message.id) > observedNewest && message.author_type === 'agent').length
  const first = messages[0]
  const readingOlder = this._loadedOlder || this._olderRequest || this.olderFailed
  const subject = detail.conversation.subject
  const renamed = subject !== undefined && this._historySubject !== undefined && subject !== this._historySubject
  const cachedBodies = readingOlder && new Map(previous.map(message => [message.id, message.body]))
  const rewritten = cachedBodies && messages.some(message => cachedBodies.has(message.id) && cachedBodies.get(message.id) !== message.body)
  const keepArchive = !showLatest && !renamed && !rewritten && detail.messagesNextCursor && readingOlder
  this._historySubject = subject ?? this._historySubject
  if (keepArchive && first && Number(first.id) > viewedNewest) {
    this._latestHistory = detail
    this.newerAvailable = true
    return received
  }
  this._latestHistory = undefined
  this.newerAvailable = false
  const overlap = first && previous.some(message => message.id === first.id)
  const retainOlder = keepArchive && overlap
  const next = retainOlder ? [...previous.filter(message => Number(message.id) < Number(first.id)), ...messages] : messages
  if (!retainOlder) {
    this.cancelOlderHistory()
    this._loadedOlder = false
    this.olderCursor = detail.messagesNextCursor || ''
    this.olderFailed = false
  }
  if (JSON.stringify(next) !== JSON.stringify(previous)) this.thread = next
  if (JSON.stringify(attachments) !== JSON.stringify(this.attachments)) this.attachments = attachments
  return received
}
async function jumpToLatest(): Promise<void> {
  const detail = this._latestHistory
  if (!this.opened || !detail) return
  const generation = this._generation, conversation = this.conversationId
  const buttonHadFocus = this.shadowRoot?.activeElement?.id === 'support-latest-messages'
  this.applyHistory(detail, true)
  await this.updateComplete
  if (generation !== this._generation || conversation !== this.conversationId || !this.opened) return
  const history = this.shadowRoot?.getElementById('support-history')
  if (history) {
    if (buttonHadFocus && !this.shadowRoot?.activeElement) history.focus({ preventScroll: true })
    history.scrollTop = history.scrollHeight
  }
}
async function loadOlderHistory(): Promise<void> {
  const cursor = this.olderCursor
  if (!this.opened || !this.sessionToken || !this.conversationId || !cursor || this._olderRequest) return
  const generation = this._generation, conversation = this.conversationId
  const controller = new AbortController()
  this._olderRequest = controller
  const current = () => this._olderRequest === controller && generation === this._generation && conversation === this.conversationId
  const readHistory = (): HTMLElement | null => this.shadowRoot?.getElementById('support-history') || null
  const originalScroll = readHistory()?.scrollTop ?? 0
  this.olderPending = true
  this.olderFailed = false
  await this.updateComplete
  if (!current()) return
  const loadingHistory = readHistory()
  if (loadingHistory) loadingHistory.scrollTop = originalScroll
  let anchor: { id: string, top: number } | undefined
  let finishWithFocus = false
  let scroll = originalScroll
  try {
    const query = new URLSearchParams({ beforeMessage: cursor, limit: '50', attachmentLimit: '1' })
    const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(conversation) + '?' + query, { signal: controller.signal })
    if (!current()) return
    this.validateHistory(detail, conversation, cursor)
    if (this._historySubject !== undefined && detail.conversation.subject !== this._historySubject) {
      this.clearHistory()
      await this.refresh()
      return
    }
    const history = readHistory()
    const first = history?.querySelector<HTMLElement>('[data-message-id]')
    scroll = history?.scrollTop ?? scroll
    if (history && first?.dataset.messageId) {
      anchor = { id: first.dataset.messageId, top: first.getBoundingClientRect().top - history.getBoundingClientRect().top + scroll }
    }
    const ids = new Set((this.thread as Message[]).map(message => message.id))
    const earlier = detail.messages.filter(message => !ids.has(message.id))
    this.thread = [...earlier, ...this.thread]
    this._loadedOlder = true
    this.olderCursor = detail.messagesNextCursor || ''
    finishWithFocus = !this.olderCursor && this.shadowRoot?.activeElement?.id === 'support-older-messages'
  }
  catch {
    if (!current()) return
    scroll = readHistory()?.scrollTop ?? scroll
    this.olderFailed = true
  }
  finally {
    if (current()) {
      this.olderPending = false
      await this.updateComplete
      if (current()) {
        this._olderRequest = undefined
        const history = readHistory()
        if (history) {
          const first = anchor && history.querySelector<HTMLElement>('[data-message-id="' + CSS.escape(anchor.id) + '"]')
          const offset = first && anchor ? first.getBoundingClientRect().top - history.getBoundingClientRect().top + history.scrollTop - anchor.top : 0
          if (finishWithFocus && !this.shadowRoot?.activeElement) history.focus({ preventScroll: true })
          history.scrollTop = scroll + offset
        }
      }
    }
  }
}
function editDraft(event: Event) {
  if (!(event.target instanceof HTMLTextAreaElement)) return
  this._draft = event.target.value
  if (this.opened && this.sessionToken && !this.pending) this._customerTyping?.input(this.conversationId, !!this._draft.trim())
}
function stopTyping(): void {
  clearTimeout(this._typingTimer)
  this._typingRequest?.abort()
  this._typingRequest = undefined
  this._typingStream?.close()
  this._typingStream = undefined
  this.typing = false
}
function startTyping(): void {
  this.stopTyping()
  const conversation = this.conversationId
  if (!this.opened || !this.sessionToken || !conversation) return
  const controller = new AbortController()
  this._typingRequest = controller
  const path = '/conversations/' + encodeURIComponent(conversation) + '/typing'
  const current = () => this._typingRequest === controller && this.opened && conversation === this.conversationId
  let pending: AbortController | undefined
  const poll = async () => {
    if (!current()) return
    clearTimeout(this._typingTimer)
    pending?.abort()
    const read = new AbortController()
    pending = read
    const latest = () => current() && pending === read
    try {
      const { typing } = await this.request<{ typing: boolean }>(path, {
        signal: AbortSignal.any([controller.signal, read.signal, AbortSignal.timeout(3500)]),
      })
      if (latest()) this.typing = typing === true
    }
    catch { if (latest()) this.typing = false }
    finally {
      if (latest()) {
        pending = undefined
        this._typingTimer = setTimeout(poll, 2000)
      }
    }
  }
  void poll()
  this._typingStream = useBroadcastStream({
    endpoint: path + '/stream',
    request: (endpoint, options) => this.fetchWidget(endpoint, { ...options, method: 'POST' }, true),
    onConnected: () => { void poll() },
    onMessage: (frame) => { if (frame.event === 'invalidated') void poll() },
  })
}
async function refresh(): Promise<void> {
  if (!this.sessionToken || this.pending || this._refreshRequest || !this.conversationId) return
  const generation = this._generation, conversation = this.conversationId
  const controller = new AbortController()
  this._refreshRequest = controller
  const current = () => this._refreshRequest === controller && generation === this._generation && conversation === this.conversationId
  try {
    const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(conversation), { signal: controller.signal })
    if (!current() || this.pending) return
    const previous = this.thread as Message[]
    const scroll = (this._loadedOlder || this._olderRequest || this.olderFailed) ? this.shadowRoot?.getElementById('support-history')?.scrollTop : undefined
    const received = this.applyHistory(detail)
    if (this.thread !== previous || received) {
      this._unread = this.opened ? 0 : (this._unread || 0) + received
      this.emit('unread', { count: this._unread })
    }
    if (scroll !== undefined && (this._loadedOlder || this._olderRequest || this.olderFailed)) {
      await this.updateComplete
      if (!current()) return
      const history = this.shadowRoot?.getElementById('support-history')
      if (history) history.scrollTop = scroll
    }
    await this.refreshCsat()
  }
  catch (error) {
    if (current() && !(error instanceof Error && error.name === 'AbortError')) this.emit('error', { message: error instanceof Error ? error.message : 'Messages could not be refreshed.' })
  }
  finally { if (current()) this._refreshRequest = undefined }
}
function clearCsat(): void {
  this.csat = {}; this.csatOffer = {}; this.csatPending = false; this.csatNotice = ''; this.csatChanged = false
  this._csatConversation = ''; this._csatScore = ''; this._csatComment = ''; this._csatOperation = null; this._csatRefreshing = false
}
function editCsatScore(event: Event): void { if (event.target instanceof HTMLInputElement) this._csatScore = event.target.value }
function editCsatComment(event: Event): void { if (event.target instanceof HTMLTextAreaElement) this._csatComment = event.target.value }
function scoreLabel(score: number): string { return Number.isInteger(score) && score >= 1 && score <= 5 ? this.text('score' + score) : '' }
async function refreshCsat(review = false): Promise<void> {
  if (!this.sessionToken || !this.conversationId || this.csatPending || this._csatRefreshing) return
  if (this._csatConversation !== this.conversationId) { this.clearCsat(); this._csatConversation = this.conversationId }
  const generation = this._generation, conversation = this.conversationId
  this._csatRefreshing = true
  try {
    const result = await this.request<CsatStatus>('/conversations/' + encodeURIComponent(conversation) + '/csat')
    if (generation !== this._generation || conversation !== this.conversationId) return
    if (typeof result.available !== 'boolean') throw new Error('Feedback availability could not be confirmed.')
    if (JSON.stringify(result) !== JSON.stringify(this.csat)) this.csat = result
    if (result.response) { this.csatOffer = {}; this._csatScore = ''; this._csatComment = ''; this._csatOperation = null; this.csatChanged = false; this.csatNotice = ''; return }
    if (!result.available || !result.survey) return
    const draft = !!(this._csatScore || this._csatComment || this._csatOperation)
    if (review || !this.csatOffer.revision || !draft) {
      if (JSON.stringify(this.csatOffer) !== JSON.stringify(result.survey)) this.csatOffer = result.survey
      this.csatChanged = false
      if (review) { this._csatOperation = null; this.csatNotice = 'Question refreshed. Review your score and comment before sending.' }
    }
    else if (result.survey.revision !== this.csatOffer.revision) this.csatChanged = true
  }
  catch (failure) {
    if (generation !== this._generation || conversation !== this.conversationId || (failure instanceof Error && failure.name === 'AbortError')) return
    if ((failure as Error & { status?: number }).status === 401) { this.shutdown(); this.emit('error', { message: 'Your customer session expired. Reconnect support.' }); return }
    if (this.csatOffer.revision) this.csatNotice = failure instanceof Error ? failure.message : 'Feedback could not be refreshed. Your draft is unchanged.'
  }
  finally { if (generation === this._generation && conversation === this.conversationId) this._csatRefreshing = false }
}
async function reviewCsatQuestion(): Promise<void> { await this.refreshCsat(true) }
async function submitCsat(event: Event): Promise<void> {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement) || this.csatPending || !this.sessionToken || !this.csat.available || this.csatChanged || this._csatConversation !== this.conversationId) return
  const fields = new FormData(event.target), score = Number(fields.get('score')), comment = String(fields.get('comment') || '')
  this._csatScore = String(fields.get('score') || ''); this._csatComment = comment
  if (!Number.isSafeInteger(score) || score < 1 || score > 5 || comment.length > 2000 || !this.csatOffer.revision) { this.csatNotice = 'Choose a score from 1 to 5 and keep your optional comment within 2000 characters.'; return }
  const payload = { score, comment: comment.trim(), revision: Number(this.csatOffer.revision) }
  if (!this._csatOperation || JSON.stringify(this._csatOperation.payload) !== JSON.stringify(payload)) this._csatOperation = { key: crypto.randomUUID(), payload }
  const operation = this._csatOperation, generation = this._generation, conversation = this.conversationId
  this.csatPending = true; this.csatNotice = ''
  try {
    const result = await this.request<{ response?: CsatAnswer }>('/conversations/' + encodeURIComponent(conversation) + '/csat', { method: 'POST', body: JSON.stringify({ ...operation.payload, idempotencyKey: operation.key }) })
    if (generation !== this._generation || conversation !== this.conversationId) return
    if (!result.response?.id) throw new Error('Feedback could not be confirmed. Retry with the same score and comment.')
    this.csat = { available: false, reason: 'answered', response: result.response }; this.csatOffer = {}; this._csatScore = ''; this._csatComment = ''; this._csatOperation = null; this.csatChanged = false
  }
  catch (failure) {
    if (generation !== this._generation || conversation !== this.conversationId || (failure instanceof Error && failure.name === 'AbortError')) return
    const error = failure as Error & { status?: number, code?: string }
    if (error.status === 401) { this.shutdown(); this.emit('error', { message: 'Your customer session expired. Reconnect support.' }); return }
    this.csatNotice = error.message || 'Feedback could not be saved. Retry with the same score and comment.'
    if (error.code === 'csat_question_changed') this.csatChanged = true
    if (error.code === 'csat_already_answered' || error.code === 'csat_unavailable') { this.csatPending = false; await this.refreshCsat() }
  }
  finally { if (generation === this._generation && conversation === this.conversationId) this.csatPending = false }
}
async function send(event: Event) {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement)) return
  if (this.pending || !this.sessionToken) return
  const form = event.target
  const draft = String(new FormData(form).get('body') || ''), body = draft.trim()
  if (!body) return
  this._customerTyping?.stop()
  this._draft = draft
  this.pending = true
  this.notice = ''
  const generation = this._generation
  let committed = false, deliveryStatus = 'accepted'
  this.deliveryNotice = ''
  try {
    const fingerprint = JSON.stringify([this.conversationId || '', body])
    if (!this._sendKey || this._sendFingerprint !== fingerprint) { this._sendKey = crypto.randomUUID(); this._sendFingerprint = fingerprint }
    const idempotencyKey = this._sendKey
    if (!this.conversationId) {
      const result = await this.request<CreatedConversation>('/conversations', { method: 'POST', body: JSON.stringify({ subject: body.slice(0, 120), body, idempotencyKey }) })
      if (generation !== this._generation) return
      const createdId = result.conversation?.id || result.id
      if (typeof createdId !== 'string' || !createdId.trim()) throw new Error('The new request could not be confirmed. Retry with the same message.')
      this.conversationId = createdId
      this.startTyping()
    }
    else {
      const result = await this.request<CreatedReply>('/conversations/' + encodeURIComponent(this.conversationId) + '/messages', { method: 'POST', body: JSON.stringify({ body, idempotencyKey }) })
      if (generation !== this._generation) return
      if (typeof result.message?.id !== 'string' || !result.message.id.trim() || typeof result.message.conversation_id !== 'string' || !result.message.conversation_id.trim()) throw new Error('Your reply could not be confirmed. Retry with the same message.')
      deliveryStatus = result.message.delivery_status || 'accepted'
      if (result.message.conversation_id !== this.conversationId) {
        this.clearCsat(); this.clearHistory(); this.conversationId = result.message.conversation_id
        this.startTyping()
        this.deliveryNotice = 'Your reply is in a linked support request.'
      }
    }
    if (generation !== this._generation) return
    committed = true
    this._sendKey = null; this._sendFingerprint = ''
    this._draft = ''
    form.reset()
    const deliveryConversation = this.conversationId
    const historyRevision = this._historyRevision
    const detail = await this.request<ConversationResponse>('/conversations/' + encodeURIComponent(deliveryConversation))
    if (generation !== this._generation || deliveryConversation !== this.conversationId) return
    if (historyRevision === this._historyRevision) this.applyHistory(detail)
    await this.refreshCsat()
    if (generation !== this._generation || deliveryConversation !== this.conversationId) return
    this.emit('delivery', { conversationId: this.conversationId, status: deliveryStatus })
  }
  catch (error) {
    if (generation !== this._generation || (error instanceof Error && error.name === 'AbortError')) return
    if (committed) {
      this.deliveryNotice = 'Your message was saved. Refresh support to load the conversation.'
      this.emit('delivery', { conversationId: this.conversationId, status: deliveryStatus })
      this.emit('error', { message: this.deliveryNotice })
    }
    else { this.notice = error instanceof Error ? error.message : 'Your message could not be sent. Please retry.'; this.emit('error', { message: this.notice }) }
  }
  finally {
    if (generation === this._generation) this.pending = false
  }
}
</script>
<template>
  @if(this.opened)
    <section class="messenger" role="region" lang="{{ this.locale }}" dir="{{ this.direction() }}" aria-label="{{ this.text('region') }}">
      <header><div><span class="brand">hq.support</span><h2>{{ this.heading || this.text('heading') }}</h2><p>{{ this.text('introduction') }}</p></div><button id="support-close" class="close" type="button" @click="close" aria-label="{{ this.text('close') }}">×</button></header>
      @if(this.olderCursor || this.newerAvailable)
        <div class="history-actions">
          @if(this.olderCursor)
            <button id="support-older-messages" type="button" aria-controls="support-history" aria-busy="{{ this.olderPending ? 'true' : 'false' }}" aria-disabled="{{ this.olderPending ? 'true' : 'false' }}" @click="loadOlderHistory">{{ this.text(this.olderPending ? 'loadingEarlier' : this.olderFailed ? 'retryEarlier' : 'loadEarlier') }}</button>
          @endif
          @if(this.newerAvailable)
            <button id="support-latest-messages" type="button" aria-controls="support-history" @click="jumpToLatest">{{ this.text('showLatest') }}</button>
          @endif
        </div>
      @endif
      <div id="support-history" class="messages{{ this.thread.length === 0 ? ' is-empty' : '' }}" role="log" aria-label="{{ this.text('conversation') }}" aria-live="polite" aria-relevant="additions text" tabindex="{{ this.thread.length ? '0' : '-1' }}">
        @if(this.thread.length === 0)
          <div class="welcome"><strong>{{ this.text('welcome') }}</strong><p>{{ this.text('context') }}</p></div>
        @endif
        @foreach(this.thread as message)
          <article class="message" data-message-id="{{ message.id }}"><small>{{ ['contact', 'customer'].includes(message.author_type) ? this.text('you') : this.text('support') }}</small>@if(message.created_at)<time datetime="{{ message.created_at }}">{{ this.date(message.created_at) }}</time>@endif<p dir="auto">{{ message.body }}</p></article>
        @endforeach
      </div>
      <div class="typing-status" role="status" aria-atomic="true">@if(this.typing)<span>{{ this.text('typing') }}</span>@endif</div>
      @if(this.notice)
        <p class="notice" role="alert">{{ this.notice }}</p>
      @endif
      @if(this.deliveryNotice)<p class="delivery-notice" role="status">{{ this.deliveryNotice }}</p>@endif
      @if(this.csat.response)
        <section class="csat-answer" aria-label="{{ this.text('feedbackResponse') }}"><h3>{{ this.text('feedbackReceived') }}</h3><p>{{ this.csat.response.question }}</p><p><strong>{{ this.csat.response.score }} / 5</strong> · {{ this.text('questionRevision', { revision: this.csat.response.revision }) }}</p>@if(this.csat.response.comment)<p class="csat-comment">{{ this.csat.response.comment }}</p>@endif</section>
      @elseif(this.csat.available && this.csatOffer.revision)
        <form class="csat-form" @submit.prevent="submitCsat"><fieldset :disabled="this.csatPending"><legend>{{ this.csatOffer.question }}</legend><p class="csat-help">{{ this.text('rateConversation', { revision: this.csatOffer.revision }) }}</p><div class="csat-scores">@foreach([1,2,3,4,5] as score)<label class="csat-score">@if(String(this._csatScore || '') === String(score))<input type="radio" name="score" value="{{ score }}" @change="editCsatScore" checked required>@else<input type="radio" name="score" value="{{ score }}" @change="editCsatScore" required>@endif<span>{{ score }}</span><span class="sr-only">: {{ this.scoreLabel(score) }}</span></label>@endforeach</div><p class="csat-help">{{ this.text('ratingScale') }}</p><label for="csat-comment">{{ this.text('feedbackComment') }}</label><textarea id="csat-comment" name="comment" @input="editCsatComment" maxlength="2000" rows="3" dir="auto" placeholder="{{ this.text('feedbackPlaceholder') }}">{{ this._csatComment || '' }}</textarea></fieldset>@if(this.csatChanged)<p class="notice" role="alert">{{ this.text('questionChanged') }}</p><button type="button" class="csat-review" @click="reviewCsatQuestion" :disabled="this.csatPending">{{ this.text('reviewQuestion') }}</button>@endif @if(this.csatNotice)<p class="notice" role="alert">{{ this.csatNotice }}</p>@endif @if(this.csatChanged)<button type="submit" disabled>{{ this.text('sendFeedback') }}</button>@else<button type="submit" :disabled="this.csatPending">{{ this.csatPending ? this.text('savingFeedback') : this.text('sendFeedback') }}</button>@endif</form>
      @elseif(this.csatOffer.revision && this.csatNotice)
        <section class="csat-answer" aria-label="{{ this.text('feedback') }}"><p>{{ this.csatOffer.question }}</p><p role="status">{{ this.csatNotice }}</p><button type="button" class="csat-review" @click="reviewCsatQuestion">{{ this.text('checkFeedback') }}</button></section>
      @endif
      <form @submit.prevent="send">
        <label for="support-body">{{ this.text('message') }}</label>
        <textarea id="support-body" name="body" @input="editDraft" required maxlength="10000" dir="auto" placeholder="{{ this.text('placeholder') }}" rows="3" :readonly="this.pending">{{ this._draft || '' }}</textarea>
        <div class="send-row">
          <span>
            <span>{{ this.pending ? '' : this.text('powered') }}</span>
            <span role="status">{{ this.pending ? (this.sessionToken ? this.text('sending') : this.text('connecting')) : '' }}</span>
          </span>
          <button id="support-send" type="submit" aria-disabled="{{ this.pending ? 'true' : 'false' }}">{{ this.text('send') }}</button>
        </div>
      </form>
    </section>
  @endif
</template>
<style>
header > div{align-self:center}
.message time{display:inline-block;margin-inline-start:8px;color:var(--hq-support-muted,#526760);font-size:11px}
.messenger{text-align:start}
.brand,header p,.messages.is-empty{display:var(--support-intro-display,revert)}
.messages:focus-visible{outline:3px solid var(--hq-support-focus,#68bcab);outline-offset:-3px}
.history-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:4px;padding:8px 16px 0}
.history-actions button{min-height:36px;padding:6px 12px;border:0;border-radius:8px;background:transparent;color:var(--support-accent);font:inherit;font-size:13px;font-weight:650;cursor:pointer}
.history-actions button:hover,.history-actions button:focus-visible{background:var(--hq-support-secondary-surface,#eff6f3)}
.history-actions button:focus-visible{outline:2px solid var(--hq-support-focus,#68bcab);outline-offset:2px}
.history-actions button[aria-disabled=true]{opacity:.7;cursor:wait}
textarea::placeholder{color:var(--hq-support-muted,#526760);opacity:1}
.send-row button[aria-disabled=true]{opacity:.55;cursor:wait}
.typing-status span{display:block;padding:0 20px 10px;color:var(--hq-support-muted,#526760);font-size:12px}
:host{display:block;font-family:var(--hq-support-font-family,Geist,ui-sans-serif,system-ui,sans-serif);color:var(--hq-support-text,#20332f);--support-accent:var(--hq-support-accent,#126d60)}.messenger{width:var(--support-messenger-width,min(380px,calc(100vw - 32px)));max-width:100%;background:var(--hq-support-surface,#fff);border:1px solid var(--hq-support-border,#dce5e1);border-radius:var(--hq-support-radius,20px);box-shadow:var(--hq-support-shadow,0 18px 70px #122e2929);overflow:hidden}*{box-sizing:border-box}header{background:var(--hq-support-secondary-surface,#f0f7f4);padding:var(--hq-support-panel-padding,24px);display:flex;gap:12px;justify-content:space-between}.brand{font-size:12px;font-weight:700;color:var(--hq-support-highlight,#126d60)}h2{margin:var(--hq-support-heading-margin,18px 0 8px);font-size:25px;letter-spacing:-.8px;line-height:1.2}p{line-height:1.5;font-size:14px;margin:0}header p{color:var(--hq-support-muted,#526760)}.close{align-self:flex-start;width:var(--hq-support-control-height,32px);height:var(--hq-support-control-height,32px);flex:none;background:transparent;color:var(--hq-support-muted,#526760);border:0;font-size:25px;border-radius:8px;cursor:pointer}.messages{min-height:var(--support-history-height,220px);max-height:340px;overflow:auto;padding:var(--hq-support-panel-padding,20px)}.welcome{padding:30px 6px;color:var(--hq-support-muted,#526760)}.welcome strong{color:var(--hq-support-text,#263c34);font-size:14px}.welcome p{margin-top:9px}.message{background:var(--hq-support-secondary-surface,#f3f6f4);padding:12px 14px;border-radius:12px;margin:0 0 12px}.message small{font-size:11px;color:var(--hq-support-muted,#536d62);font-weight:650}.message p{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:5px}form{padding:var(--hq-support-panel-padding,16px 20px);border-top:1px solid var(--hq-support-border,#e5ebe7)}label{display:block;font-size:12px;font-weight:600;margin-bottom:8px}textarea{width:100%;font:inherit;font-size:14px;border:1px solid var(--hq-support-control-border,#cddbd3);border-radius:10px;padding:12px;resize:vertical;min-height:80px;color:var(--hq-support-text,#20332f);background:var(--hq-support-input-surface,#fff)}.send-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}.send-row span{font-size:10px;color:var(--hq-support-muted,#62736c)}button[type=submit]{font:inherit;background:var(--support-accent);color:var(--hq-support-accent-text,#fff);border:0;border-radius:8px;min-height:var(--hq-support-control-height,0);padding:10px 13px;font-size:12px;font-weight:650;cursor:pointer}button:disabled{opacity:.55;cursor:wait}button:focus-visible,textarea:focus-visible{outline:3px solid var(--hq-support-focus,#68bcab);outline-offset:3px}.delivery-notice{padding:12px 20px;color:var(--hq-support-highlight,#126d60);background:var(--hq-support-secondary-surface,#e8f5ef);font-size:12px}.notice{padding:12px 20px;color:#923a25;background:#fff4ee;font-size:12px}@media(prefers-reduced-motion:no-preference){button{transition:background .15s}button:hover{filter:brightness(.94)}}
.csat-form fieldset{border:0;margin:0;padding:0;min-width:0}.csat-form legend{font-size:15px;font-weight:650;line-height:1.5;margin-bottom:8px}.csat-help{font-size:11px;color:var(--hq-support-muted,#526760);margin:7px 0 12px}.csat-scores{display:flex;gap:8px;margin:14px 0}.csat-score{position:relative;display:flex;align-items:center;gap:4px;flex:1;padding:9px 4px;border:1px solid var(--hq-support-control-border,#cddbd3);border-radius:8px;cursor:pointer;justify-content:center}.csat-score:has(input:checked){border-color:var(--support-accent);background:var(--hq-support-secondary-surface,#e5f3ed)}.csat-score input{margin:0;accent-color:var(--support-accent)}.csat-form>button{margin-top:12px}.csat-form .notice{margin-top:12px;border-radius:8px}.csat-answer{padding:var(--hq-support-panel-padding,18px 20px);border-top:1px solid var(--hq-support-border,#e5ebe7);background:var(--hq-support-secondary-surface,#f3f8f5)}.csat-answer h3{margin:0 0 10px;font-size:15px}.csat-answer p{font-size:12px;line-height:1.7;margin:7px 0}.csat-comment{white-space:pre-wrap;overflow-wrap:anywhere}.csat-review{font:inherit;font-size:12px;color:var(--hq-support-highlight,#126d60);background:var(--hq-support-input-surface,#fff);border:1px solid var(--hq-support-control-border,#cddbd3);border-radius:8px;padding:9px 12px;cursor:pointer}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}input:focus-visible{outline:3px solid var(--hq-support-focus,#68bcab);outline-offset:3px}
.messenger{max-height:calc(100vh - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));max-height:var(--support-panel-height,calc(100dvh - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));overflow-y:auto;overscroll-behavior:contain}header{position:sticky;top:0;z-index:1}
@media(max-width:480px){header{padding:var(--hq-support-panel-padding,16px)}h2{margin:var(--hq-support-heading-margin,8px 0 4px);font-size:22px}.messages{min-height:var(--support-history-height,115px);max-height:33dvh;padding:var(--hq-support-panel-padding,14px 16px)}.welcome{padding:12px 0}form,.csat-answer{padding:var(--hq-support-panel-padding,12px 16px)}textarea{min-height:64px;font-size:16px}}
@media (prefers-color-scheme: dark) {
  :host {
    color-scheme: dark;
    color: var(--hq-support-text,#e5edeb);
    --support-accent: var(--hq-support-accent,#216d61);
    --support-dark-border: var(--hq-support-border,#3b4a46);
    --support-dark-muted: var(--hq-support-muted,#acbdb8);
    --support-dark-highlight: var(--hq-support-highlight,#83d9c7);
  }
  .messenger {
    background: var(--hq-support-surface,#1d2523);
    border-color: var(--support-dark-border);
    box-shadow: var(--hq-support-shadow,0 18px 62px #0b121165);
  }
  header, .message, .csat-answer {
    background: var(--hq-support-secondary-surface,#26312e);
  }
  header p, .close, .welcome, .message small, .message time, .send-row span, .csat-help, .typing-status span {
    color: var(--support-dark-muted);
  }
  .brand, .delivery-notice, .csat-review, .history-actions button {
    color: var(--support-dark-highlight);
  }
  .history-actions button:hover, .history-actions button:focus-visible {
    background: var(--hq-support-secondary-surface,#26312e);
  }
  .welcome strong {
    color: var(--hq-support-text,#e5edeb);
  }
  form, .csat-answer {
    border-color: var(--support-dark-border);
  }
  textarea, .csat-score, .csat-review {
    border-color: var(--hq-support-control-border,var(--support-dark-border));
  }
  textarea, .csat-review {
    background: var(--hq-support-input-surface,#202b28);
  }
  textarea {
    color: var(--hq-support-text,#e5edeb);
  }
  textarea::placeholder {
    color: var(--support-dark-muted);
  }
  .delivery-notice, .csat-score:has(input:checked) {
    background: var(--hq-support-secondary-surface,#233b34);
  }
  .notice {
    color: #ffd2be;
    background: #3b2a23;
  }
  .messages:focus-visible, button:focus-visible, textarea:focus-visible, input:focus-visible {
    outline-color: var(--hq-support-focus,var(--support-dark-highlight));
  }
}
</style>
