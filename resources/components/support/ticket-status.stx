<script component>
{"tag":"hq-support-ticket-status","shadowDOM":"open","properties":{"apiUrl":{"type":"string","default":""},"projectId":{"type":"string","default":""},"sessionToken":{"type":"string","attribute":false,"reflect":false},"ticketId":{"type":"string","default":""},"ticket":{"type":"object","attribute":false,"reflect":false},"notice":{"type":"string","attribute":false,"reflect":false},"pending":{"type":"boolean","attribute":false,"reflect":false}},"events":{"loaded":{},"error":{}}}
</script>
<script client>
async function refresh() {
  if (!this.ticketId || !this.projectId || !this.sessionToken) { this.notice = 'A customer session and ticket ID are required.'; return }
  this._abort?.abort()
  this._abort = new AbortController()
  this.pending = true
  try {
    const response = await fetch(this.apiUrl.replace(/\/$/, '') + '/api/widget/projects/' + encodeURIComponent(this.projectId) + '/tickets/' + encodeURIComponent(this.ticketId), { credentials: 'omit', signal: this._abort.signal, headers: { Authorization: 'Bearer ' + this.sessionToken } })
    const data = await response.json()
    if (!response.ok) throw new Error(data.message || 'Ticket could not be loaded.')
    this.ticket = data.ticket || data
    this.notice = ''
    this.emit('loaded', { ticket: this.ticket })
  }
  catch (error) {
    if (error.name === 'AbortError') return
    this.notice = error.message
    this.emit('error', { message: this.notice })
  }
  finally { this.pending = false }
}
function onDisconnect() { this._abort?.abort() }
</script>
<template>
  <section aria-label="Ticket status">@if(this.ticket.id)<small>Ticket {{ this.ticket.id }}</small><h2>{{ this.ticket.title }}</h2><p>Status: <strong>{{ this.ticket.status }}</strong></p>@else<h2>Your support ticket</h2>@endif<p role="status" aria-live="polite">{{ this.notice }}</p><button type="button" @click="refresh" :disabled="this.pending">{{ this.pending ? 'Loading...' : 'Refresh status' }}</button></section>
</template>
<style>
:host{display:block;font:14px Geist,system-ui,sans-serif;color:#20332f}section{padding:22px;border:1px solid #dce5e1;border-radius:12px}small{font-size:11px;color:#53665d}h2{font-size:20px;letter-spacing:-.5px;margin:12px 0}p{line-height:1.5}strong{font-weight:650}button{font:inherit;border:1px solid #cddbd3;border-radius:9px;background:#fff;color:#126d60;padding:10px 14px;cursor:pointer}button:disabled{opacity:.5}button:focus-visible{outline:3px solid #68bcab;outline-offset:3px}
</style>
