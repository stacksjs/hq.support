<script component type="application/json">
{"tag":"hq-support-ticket-status","shadowDOM":"open","properties":{"apiUrl":{"type":"string","default":""},"projectId":{"type":"string","default":""},"sessionToken":{"type":"string","attribute":false,"reflect":false},"ticketId":{"type":"string","default":""},"historyScope":{"type":"string","default":"personal","attribute":false,"reflect":false},"historyQuery":{"type":"string","default":"","attribute":false,"reflect":false},"historyStatus":{"type":"string","default":"","attribute":false,"reflect":false},"selectedId":{"type":"string","default":"","attribute":false,"reflect":false},"ticket":{"type":"object","attribute":false,"reflect":false},"tickets":{"type":"array","attribute":false,"reflect":false},"nextCursor":{"type":"string","default":"","attribute":false,"reflect":false},"notice":{"type":"string","attribute":false,"reflect":false},"pending":{"type":"boolean","attribute":false,"reflect":false},"historyLoaded":{"type":"boolean","attribute":false,"reflect":false},"followUpDraft":{"type":"string","default":"","attribute":false,"reflect":false}},"events":{"loaded":{},"open-conversation":{},"error":{}}}
</script>
<script client>
interface CustomerTicket extends Record<string, unknown> {
  id?: string | number
  title?: string
  status?: string
  state?: string
  description?: string
  shared?: boolean
  conversation_id?: string | number | null
}
interface TicketSummary {
  id: string
  title: string
  status: string
  state: string
}
interface TicketResponse extends CustomerTicket {
  ticket?: CustomerTicket
  tickets?: TicketSummary[]
  nextCursor?: string | null
  conversationId?: string
  error?: { message?: string }
  message?: string
}
interface ComponentState {
  _abort?: AbortController
  _observe?: () => void
  _identity?: string
  _followUp?: { ticket: string, body: string, idempotencyKey: string }
  ticket: CustomerTicket
  tickets: TicketSummary[]
}

function onConnect() {
  this._observe = () => this.configure()
  this.addEventListener('stx:updated', this._observe)
  this.configure()
}

function identity(): string {
  return JSON.stringify([this.apiUrl, this.projectId, this.sessionToken, this.ticketId])
}

function configure() {
  const identity = this.identity()
  if (identity === this._identity) return
  this._identity = identity
  this.clear()
}

function clear() {
  this._abort?.abort()
  this._abort = undefined
  this.ticket = {}
  this.tickets = []
  this.nextCursor = ''
  this.selectedId = ''
  this.historyLoaded = false
  this.followUpDraft = ''
  this._followUp = undefined
  this.historyScope = 'personal'
  this.historyQuery = ''
  this.historyStatus = ''
  this.pending = false
  this.notice = ''
}

async function request(id = '', cursor = '') {
  this._abort?.abort()
  const controller = new AbortController()
  this._abort = controller
  const identity = this._identity
  const isCurrent = () => this._abort === controller && this.identity() === identity
  this.pending = true
  this.notice = ''
  try {
    const path = '/api/widget/projects/' + encodeURIComponent(this.projectId) + '/tickets'
    const search = new URLSearchParams()
    if (this.historyScope === 'shared') search.set('scope', 'shared')
    if (this.historyQuery) search.set('q', this.historyQuery)
    if (this.historyStatus) search.set('status', this.historyStatus)
    if (cursor) search.set('cursor', cursor)
    const suffix = id ? '/' + encodeURIComponent(id) : search.size ? '?' + search.toString() : ''
    const response = await fetch(this.apiUrl.replace(/\/$/, '') + path + suffix, { credentials: 'omit', referrerPolicy: 'origin', signal: controller.signal, headers: { Authorization: 'Bearer ' + this.sessionToken } })
    const data: TicketResponse = await response.json()
    if (!isCurrent()) return
    if (!response.ok) throw new Error(data.error?.message || data.message || 'Tickets could not be loaded.')

    if (id) {
      this.ticket = data.ticket || { id: data.id, title: data.title, status: data.status }
      this.emit('loaded', { ticket: this.ticket })
    }
    else {
      if (!Array.isArray(data.tickets) || (data.nextCursor !== null && (typeof data.nextCursor !== 'string' || !/^[1-9]\d*$/.test(data.nextCursor))))
        throw new Error('Ticket history could not be loaded.')
      this.tickets = cursor ? [...this.tickets, ...data.tickets] : data.tickets
      this.nextCursor = data.nextCursor || ''
      this.historyLoaded = true
    }
  }
  catch (error) {
    if (!isCurrent() || controller.signal.aborted) return
    this.notice = error instanceof Error ? error.message : 'Tickets could not be loaded.'
    this.emit('error', { message: this.notice })
  }
  finally {
    if (isCurrent()) this.pending = false
  }
}

async function refresh() {
  this.configure()
  if (!this.projectId || !this.sessionToken) { this.notice = 'A customer session is required.'; return }
  await this.request(this.ticketId || this.selectedId)
}

async function switchHistoryScope(scope: 'personal' | 'shared') {
  this.configure()
  if (scope === this.historyScope) return
  this.clear()
  this.historyScope = scope
  await this.refresh()
}

async function filterSharedHistory(event: Event) {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement)) return
  const form = new FormData(event.target)
  this.historyQuery = String(form.get('q') || '').trim()
  this.historyStatus = String(form.get('status') || '')
  this.tickets = []
  this.nextCursor = ''
  this.historyLoaded = false
  await this.refresh()
}

async function showTicket(id: string) {
  this.selectedId = id
  this.followUpDraft = ''
  this.ticket = {}
  const loading = this.refresh()
  await this.updateComplete
  if (this.selectedId === id) this.shadowRoot?.getElementById('ticket-title')?.focus()
  await loading
}

async function backToTickets() {
  const previous = this.selectedId
  this._abort?.abort()
  this._abort = undefined
  this.selectedId = ''
  this.ticket = {}
  this.notice = ''
  this.pending = false
  await this.updateComplete
  if (!this.selectedId) this.shadowRoot?.getElementById('ticket-row-' + previous)?.focus()
}

async function loadMore() {
  if (this.pending || !this.nextCursor) return
  const firstNew = this.tickets.length
  const focused = this.shadowRoot?.activeElement?.id === 'ticket-more'
  await this.request('', this.nextCursor)
  await this.updateComplete
  const ticketId = this.tickets[firstNew]?.id
  if (focused && !this.nextCursor && ticketId && !this.shadowRoot?.activeElement)
    this.shadowRoot?.getElementById('ticket-row-' + ticketId)?.focus()
}

async function submitFollowUp(event: Event) {
  event.preventDefault()
  if (!(event.target instanceof HTMLFormElement) || this.pending || !this.ticket.shared || !this.ticket.id) return
  const form = new FormData(event.target)
  this.followUpDraft = String(form.get('follow-up') || '')
  const body = this.followUpDraft.trim()
  if (!body) { this.notice = 'Enter a message to follow up.'; return }
  const ticket = String(this.ticket.id)
  if (this._followUp?.ticket !== ticket || this._followUp?.body !== body)
    this._followUp = { ticket, body, idempotencyKey: crypto.randomUUID() }
  const controller = new AbortController()
  this._abort = controller
  const identity = this._identity
  const isCurrent = () => this._abort === controller && this.identity() === identity && !controller.signal.aborted
  this.pending = true
  this.notice = ''
  try {
    const path = '/api/widget/projects/' + encodeURIComponent(this.projectId) + '/tickets/' + encodeURIComponent(ticket) + '/follow-ups'
    const response = await fetch(this.apiUrl.replace(/\/$/, '') + path, {
      method: 'POST', credentials: 'omit', referrerPolicy: 'origin', signal: controller.signal,
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + this.sessionToken },
      body: JSON.stringify({ body, idempotencyKey: this._followUp.idempotencyKey }),
    })
    const data: TicketResponse = await response.json()
    if (!isCurrent()) return
    if (!response.ok || !data.conversationId) throw new Error(data.error?.message || data.message || 'Your follow-up could not be sent.')
    this.followUpDraft = ''
    this._followUp = undefined
    this.notice = 'Follow-up sent.'
    this.emit('open-conversation', { conversationId: data.conversationId })
  }
  catch (error) {
    if (!isCurrent()) return
    this.notice = error instanceof Error ? error.message : 'Your follow-up could not be sent.'
    this.emit('error', { message: this.notice })
  }
  finally {
    if (isCurrent()) this.pending = false
  }
}

function openConversation() {
  const conversationId = this.ticket.conversation_id
  if (conversationId) this.emit('open-conversation', { conversationId: String(conversationId) })
}

function stateLabel(value: unknown): string {
  if (typeof value !== 'string') return ''
  const words = value.replace(/[_-]+/g, ' ')
  return words ? words[0].toUpperCase() + words.slice(1) : ''
}

function onDisconnect() {
  if (this._observe) this.removeEventListener('stx:updated', this._observe)
  this._identity = undefined
  this.clear()
}
</script>
<template>
  <section aria-label="Support tickets" :aria-busy="this.pending">
    @if(this.ticketId || this.selectedId)
      @if(this.selectedId)<button type="button" @click="backToTickets">Back to tickets</button>@endif
      <h2 id="ticket-title" tabindex="-1">{{ this.ticket.title || 'Support ticket' }}</h2>
      @if(this.ticket.id)
        <small>Ticket {{ this.ticket.id }}</small>
        <p>Status <strong>{{ this.stateLabel(this.ticket.state || this.ticket.status) }}</strong></p>
        @if(this.ticket.description)<p class="description">{{ this.ticket.description }}</p>@endif
        @if(this.ticket.shared)
          <form class="history-search" @submit.prevent="submitFollowUp">
            <label>Ask about this ticket<textarea name="follow-up" required maxlength="20000" rows="3">{{ this.followUpDraft }}</textarea></label>
            <button type="submit" :disabled="this.pending">Send follow-up</button>
          </form>
        @endif
        @if(this.ticket.conversation_id)<button type="button" @click="openConversation">Open conversation</button>@endif
      @endif
      <button type="button" @click="refresh" :disabled="this.pending">Refresh status</button>
    @else
      <h2>Support tickets</h2>
      <div class="history-filters" role="group" aria-label="Ticket visibility">
        <button type="button" aria-pressed="{{ this.historyScope === 'personal' }}" @click="this.switchHistoryScope('personal')">Your tickets</button>
        <button type="button" aria-pressed="{{ this.historyScope === 'shared' }}" @click="this.switchHistoryScope('shared')">Shared with you</button>
      </div>
      @if(this.historyScope === 'shared')
        <form class="history-search" @submit.prevent="filterSharedHistory">
          <label>Search shared tickets<input type="search" name="q" maxlength="120" value="{{ this.historyQuery }}"></label>
          <label>Ticket status
            <select name="status">
              <option value="" :selected="!this.historyStatus">All statuses</option>
              <option value="open" :selected="this.historyStatus === 'open'">Open</option>
              <option value="pending" :selected="this.historyStatus === 'pending'">Pending</option>
              <option value="resolved" :selected="this.historyStatus === 'resolved'">Resolved</option>
            </select>
          </label>
          <button type="submit" :disabled="this.pending">Filter tickets</button>
        </form>
      @endif
      @if(this.historyLoaded && !this.tickets.length)<p>{{ this.historyScope === 'shared' ? 'No shared tickets match this view.' : 'You have no support tickets yet.' }}</p>@endif
      @if(this.tickets.length)
        <ul>
          @foreach(this.tickets as item)
            <li><button type="button" class="ticket" id="ticket-row-{{ item.id }}" @click="this.showTicket(item.id)"><span>{{ item.title }}</span><small>{{ this.stateLabel(item.state || item.status) }}</small></button></li>
          @endforeach
        </ul>
      @endif
      @if(this.nextCursor)<button id="ticket-more" type="button" @click="loadMore" :disabled="this.pending">Load older tickets</button>@endif
      <button type="button" @click="refresh" :disabled="this.pending">{{ this.historyLoaded ? 'Refresh tickets' : 'Load tickets' }}</button>
    @endif
    <p role="status" aria-live="polite">{{ this.notice || (this.pending ? 'Loading tickets…' : '') }}</p>
  </section>
</template>
<style>
:host{display:block;font:14px Geist,system-ui,sans-serif;color:#20332f}
section{padding:22px;border:1px solid #dce5e1;border-radius:12px}
h2{font-size:20px;letter-spacing:-.5px;margin:0 0 12px;overflow-wrap:anywhere}
button+h2{margin-top:14px}small{font-size:12px;color:#53665d}p{line-height:1.5}
.description{white-space:pre-wrap;overflow-wrap:anywhere}strong{font-weight:650}
ul{list-style:none;padding:0;margin:0 0 14px;display:grid;gap:6px}
button{font:inherit;border:1px solid #cddbd3;border-radius:9px;background:#fff;color:#126d60;padding:9px 12px;cursor:pointer}
button+button{margin-inline-start:6px}button:disabled{opacity:.5}
.history-filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.history-search{display:grid;gap:8px;margin-bottom:14px}
.history-search label{display:grid;gap:4px}
.history-search input,.history-search select,.history-search textarea{box-sizing:border-box;width:100%;min-width:0;padding:8px;border:1px solid #cddbd3;border-radius:8px;font:inherit;color:inherit;background:#fff}
.history-search button{justify-self:start}
.history-filters button{margin:0}.history-filters button[aria-pressed="true"]{background:#e9f6f0;color:#10584c;border-color:#76ac99}
button:focus-visible,h2:focus-visible{outline:3px solid #68bcab;outline-offset:3px}
.ticket{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:start;min-height:44px}
.ticket span{overflow-wrap:anywhere}.ticket small{flex-shrink:0}
p:empty{margin:0}
</style>
