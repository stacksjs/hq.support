{
  "name": "hq-support",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Customer support, built with Stacks.",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:calendar": "./buddy release --bump calendar",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun run typecheck:app",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:elements": "bun x --bun tsc --noEmit -p tsconfig.elements.json --pretty false",
    "typecheck:views": "bun x --bun stx typecheck --lib storage/framework/types/request-context.d.ts --lib storage/framework/types/browser-composables.d.ts 'resources/**/*.stx'",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "probe:integrations": "./buddy integrations:probe"
  },
  "dependencies": {
    "@stacksjs/actions": "0.75.701",
    "@stacksjs/ai": "0.75.701",
    "@stacksjs/auth": "0.75.701",
    "@stacksjs/chat": "0.75.701",
    "@stacksjs/cli": "0.75.701",
    "@stacksjs/config": "0.75.701",
    "@stacksjs/database": "0.75.701",
    "@stacksjs/datetime": "0.75.701",
    "@stacksjs/defaults": "0.75.701",
    "@stacksjs/email": "0.75.701",
    "@stacksjs/env": "0.75.701",
    "@stacksjs/error-handling": "0.75.701",
    "@stacksjs/events": "0.75.701",
    "@stacksjs/hq": "0.75.701",
    "@stacksjs/i18n": "0.75.701",
    "@stacksjs/logging": "0.75.701",
    "@stacksjs/orm": "0.75.701",
    "@stacksjs/path": "0.75.701",
    "@stacksjs/payments": "0.75.701",
    "@stacksjs/queue": "0.75.701",
    "@stacksjs/realtime": "0.75.701",
    "@stacksjs/router": "0.75.701",
    "@stacksjs/scheduler": "0.75.701",
    "@stacksjs/security": "0.75.701",
    "@stacksjs/server": "0.75.701",
    "@stacksjs/sms": "0.75.701",
    "@stacksjs/socials": "0.75.701",
    "@stacksjs/storage": "0.75.701",
    "@stacksjs/stx": "0.2.948",
    "@stacksjs/support": "0.75.695",
    "@stacksjs/telephony": "0.75.701",
    "@stacksjs/ts-cloud": "0.16.152",
    "@stacksjs/validation": "0.75.701",
    "@twilio/voice-sdk": "^2.19.0",
    "libphonenumber-js": "^1.13.16",
    "stacks": "0.75.701",
    "twilio": "^6.3.0"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@stacksjs/components": "0.2.948",
    "@stacksjs/testing": "0.75.701",
    "@stacksjs/types": "0.75.701",
    "better-dx": "^0.2.39",
    "bun-plugin-stx": "0.2.948",
    "xml-crypto": "^6.4.0"
  },
  "overrides": {
    "ts-images": "https://registry.pantry.dev/ts-images@22073a9",
    "@stacksjs/ts-svg": "https://registry.pantry.dev/@stacksjs/ts-svg@367a010"
  },
  "license": "MIT",
  "author": "Chris <chris@stacksjs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/hq.support.git"
  },
  "homepage": "https://hq.support"
}
